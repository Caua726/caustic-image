// test_tiff — decode a small PackBits TIFF and match libtiff exactly.
use "../core/image.cst"  as image;
use "../core/pixfmt.cst" as pixfmt;
use "../formats/tiff.cst" as tiff;
fn main() as i64 {
    let is *u8 as t with imut = "\x49\x49\x2a\x00\xd0\x00\x00\x00\xfe\x00\x12\x11\x00\x00\x22\x00\x00\x33\x00\x00\x44\x00\x00\x55\x00\x00\x66\x00\x00\x77\xff\x00\x17\x00\x17\x00\x11\x17\x01\x22\x17\x02\x33\x17\x03\x44\x17\x04\x55\x17\x05\x66\x17\x06\x77\x17\x07\x17\x00\x2e\x00\x11\x2e\x02\x22\x2e\x04\x33\x2e\x06\x44\x2e\x08\x55\x2e\x0a\x66\x2e\x0c\x77\x2e\x0e\x17\x00\x45\x00\x11\x45\x03\x22\x45\x06\x33\x45\x09\x44\x45\x0c\x55\x45\x0f\x66\x45\x12\x77\x45\x15\x17\x00\x5c\x00\x11\x5c\x04\x22\x5c\x08\x33\x5c\x0c\x44\x5c\x10\x55\x5c\x14\x66\x5c\x18\x77\x5c\x1c\x17\x00\x73\x00\x11\x73\x05\x22\x73\x0a\x33\x73\x0f\x44\x73\x14\x55\x73\x19\x66\x73\x1e\x77\x73\x23\x17\x00\x8a\x00\x11\x8a\x06\x22\x8a\x0c\x33\x8a\x12\x44\x8a\x18\x55\x8a\x1e\x66\x8a\x24\x77\x8a\x2a\x17\x00\xa1\x00\x11\xa1\x07\x22\xa1\x0e\x33\xa1\x15\x44\xa1\x1c\x55\xa1\x23\x66\xa1\x2a\x77\xa1\x31\x00\x0a\x00\x00\x01\x03\x00\x01\x00\x00\x00\x08\x00\x00\x00\x01\x01\x03\x00\x01\x00\x00\x00\x08\x00\x00\x00\x02\x01\x03\x00\x03\x00\x00\x00\x4e\x01\x00\x00\x03\x01\x03\x00\x01\x00\x00\x00\x05\x80\x00\x00\x06\x01\x03\x00\x01\x00\x00\x00\x02\x00\x00\x00\x11\x01\x04\x00\x01\x00\x00\x00\x08\x00\x00\x00\x15\x01\x03\x00\x01\x00\x00\x00\x03\x00\x00\x00\x16\x01\x03\x00\x01\x00\x00\x00\x08\x00\x00\x00\x17\x01\x04\x00\x01\x00\x00\x00\xc7\x00\x00\x00\x1c\x01\x03\x00\x01\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x08\x00\x08\x00\x08\x00";
    let is *u8 as ref with imut = "\x00\x00\x00\x11\x00\x00\x22\x00\x00\x33\x00\x00\x44\x00\x00\x55\x00\x00\x66\x00\x00\x77\x00\x00\x00\x17\x00\x11\x17\x01\x22\x17\x02\x33\x17\x03\x44\x17\x04\x55\x17\x05\x66\x17\x06\x77\x17\x07\x00\x2e\x00\x11\x2e\x02\x22\x2e\x04\x33\x2e\x06\x44\x2e\x08\x55\x2e\x0a\x66\x2e\x0c\x77\x2e\x0e\x00\x45\x00\x11\x45\x03\x22\x45\x06\x33\x45\x09\x44\x45\x0c\x55\x45\x0f\x66\x45\x12\x77\x45\x15\x00\x5c\x00\x11\x5c\x04\x22\x5c\x08\x33\x5c\x0c\x44\x5c\x10\x55\x5c\x14\x66\x5c\x18\x77\x5c\x1c\x00\x73\x00\x11\x73\x05\x22\x73\x0a\x33\x73\x0f\x44\x73\x14\x55\x73\x19\x66\x73\x1e\x77\x73\x23\x00\x8a\x00\x11\x8a\x06\x22\x8a\x0c\x33\x8a\x12\x44\x8a\x18\x55\x8a\x1e\x66\x8a\x24\x77\x8a\x2a\x00\xa1\x00\x11\xa1\x07\x22\xa1\x0e\x33\xa1\x15\x44\xa1\x1c\x55\xa1\x23\x66\xa1\x2a\x77\xa1\x31";
    let is image.Image as img;
    let is i64 as rc = tiff.tiff_decode(t, 340, &img);
    if (rc != 0) { return 90; }
    if (img.width != 8) { return 91; }
    if (img.fmt != pixfmt.FMT_RGB8) { return 92; }
    let is *u8 as p = img.pixels;
    let is i64 as i with mut = 0;
    while (i < 192) { if (p[i] != ref[i]) { return 100 + i; } i = i + 1; }
    image.image_free(&img);
    return 0;
