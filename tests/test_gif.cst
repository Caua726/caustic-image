// test_gif — decode a real 46-byte GIF (produced by Pillow/giflib, 4-colour
// palette, 8-bit LZW minimum code size) and check every pixel. Validates the
// container walk, the sub-block de-blocking, and caustic-compact's LZW.
use "../core/image.cst"  as image;
use "../formats/gif.cst" as gif;
use "check.cst"          as chk;

fn main() as i64 {
    let is *u8 as data with imut = "\x47\x49\x46\x38\x37\x61\x02\x00\x02\x00\x81\x00\x00\xff\xff\xff\x00\xff\x00\xff\x00\x00\x00\x00\xff\x2c\x00\x00\x00\x00\x02\x00\x02\x00\x00\x08\x07\x00\x05\x04\x18\x00\x20\x20\x00\x3b";

    let is image.Image as img;
    let is i64 as rc = gif.gif_decode(data, 46, &img);
    if (rc != 0) { return 90; }
    let is i64 as c = chk.check_rgb2x2(&img);
    if (c != 0) { return c; }
    image.image_free(&img);
    return 0;
}
