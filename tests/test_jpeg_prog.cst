// test_jpeg_prog — progressive JPEG (4:2:0 colour + grayscale), within +/-4 of libjpeg.
use "../core/image.cst"  as image;
use "../formats/jpeg.cst" as jpeg;
fn chk(d as *u8, dl as i64, ref as *u8, rl as i64, tol as i64) as i64 {
    let is image.Image as img;
    if (jpeg.jpeg_decode(d, dl, &img) != 0) { return 1; }
    let is i64 as i with mut = 0;
    while (i < rl) {
        let is i64 as e with mut = cast(i64, img.pixels[i]) - cast(i64, ref[i]);
        if (e < 0) { e = 0 - e; }
        if (e > tol) { return 2; }
        i = i + 1;
    }
    image.image_free(&img);
    return 0;
}
