// test_csif16 — CSIF deep-colour (16-bit) support: RAW and MODULAR codecs
// round-trip every 16-bit format bit-exact, and MODULAR compresses a smooth
// 16-bit gradient below RAW.
use "std/mem.cst" only bins, core as mem;
use "../core/image.cst"  as image;
use "../core/pixfmt.cst" as pixfmt;
use "../csif/container.cst" as csif;
use "caustic-compact/core/bytes.cst" as cb;

// Smooth 16-bit gradient so prediction residuals are tiny.
fn build(img as *image.Image, w as i64, h as i64, fmt as i64) as void {
    image.image_init(img, w, h, fmt);
    let is i64 as ch = pixfmt.fmt_channels(fmt);
    let is *u8 as p = img.pixels;
    let is i64 as y with mut = 0;
    while (y < h) {
        let is i64 as x with mut = 0;
        while (x < w) {
            let is i64 as c with mut = 0;
            while (c < ch) {
                let is i64 as v = (2000 + x * 300 + y * 200 + c * 111) & 65535;
                let is i64 as o = ((y * w + x) * ch + c) * 2;
                p[o] = cast(u8, v & 255); p[o + 1] = cast(u8, (v >> 8) & 255);
                c = c + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

fn rt(w as i64, h as i64, fmt as i64, codec as i64) as i64 {
    let is image.Image as a; build(&a, w, h, fmt);
    let is cb.Bytes as e = cb.bytes_new(4096);
    if (csif.csif_encode_ex(&a, &e, codec) < 0) { return 0 - 2; }
    let is image.Image as b;
    if (csif.csif_decode(e.ptr, e.len, &b) < 0) { return 0 - 3; }
    if (b.fmt != fmt) { return 0 - 4; }
    if (b.width != w) { return 0 - 6; }
    let is i64 as nb = w * h * pixfmt.fmt_channels(fmt) * 2;
    let is i64 as i with mut = 0;
    while (i < nb) { if (a.pixels[i] != b.pixels[i]) { return 0 - 5; } i = i + 1; }
    let is i64 as el = e.len;
    cb.bytes_free(&e); image.image_free(&a); image.image_free(&b);
    return el;
}

fn main() as i64 {
    if (rt(24, 18, pixfmt.FMT_GRAY16, 0)  < 0) { return 10; }
    if (rt(24, 18, pixfmt.FMT_GRAYA16, 0) < 0) { return 11; }
    if (rt(24, 18, pixfmt.FMT_RGB16, 0)   < 0) { return 12; }
    if (rt(24, 18, pixfmt.FMT_RGBA16, 0)  < 0) { return 13; }
    if (rt(24, 18, pixfmt.FMT_GRAY16, 2)  < 0) { return 20; }
    if (rt(24, 18, pixfmt.FMT_GRAYA16, 2) < 0) { return 21; }
    if (rt(24, 18, pixfmt.FMT_RGB16, 2)   < 0) { return 22; }
    if (rt(24, 18, pixfmt.FMT_RGBA16, 2)  < 0) { return 23; }
    // MODULAR must beat RAW on the smooth gradient.
    let is i64 as raw = rt(48, 36, pixfmt.FMT_RGB16, 0);
    let is i64 as mod2 = rt(48, 36, pixfmt.FMT_RGB16, 2);
    if (mod2 >= raw) { return 30; }
    return 0;
}
