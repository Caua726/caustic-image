// test_modular_ctx — the MODULAR context-modelling path: on a half-smooth /
// half-noisy image the encoder must pick the 5-context tables (stream K byte
// = 5), decode must reconstruct exactly, and the context encoding must beat
// the single-table one. Also pins the k=1 fallback on a smooth gradient.
use "std/mem.cst" only bins, core as mem;
use "../core/image.cst"  as image;
use "../core/pixfmt.cst" as pixfmt;
use "../csif/modular.cst" as modular;
use "caustic-compact/entropy/rans.cst" as rans;
use "caustic-compact/core/bytes.cst" as cb;

fn main() as i64 {
    let is i64 as w = 96;
    let is i64 as h = 64;
    let is image.Image as a;
    if (image.image_init(&a, w, h, pixfmt.FMT_RGB8) != 0) { return 1; }
    let is *u8 as p = a.pixels;
    let is i64 as y with mut = 0;
    while (y < h) {
        let is i64 as x with mut = 0;
        while (x < w) {
            let is i64 as d = (y * w + x) * 3;
            let is i64 as v with mut = 0;
            if (x < w / 2) { v = 30 + ((x + y) >> 1); }                    // smooth half
            else { v = ((x * 7919 + y * 104729) >> 3) & 255; }             // noisy half
            p[d] = cast(u8, v);
            p[d + 1] = cast(u8, (v * 3) & 255);
            p[d + 2] = cast(u8, 255 - v);
            x = x + 1;
        }
        y = y + 1;
    }

    let is cb.Bytes as e = cb.bytes_new(8192);
    if (modular.modular_encode(&a, &e) != 0) { return 2; }
    // First stream byte is K — the mixed image must engage the 5 contexts.
    if (cast(i64, e.ptr[0]) != 5) { return 3; }

    let is *u8 as outp = mem.core.mmap_anon(w * h * 3 + 1);
    if (modular.modular_decode(e.ptr, e.len, w, h, 3, outp) != 0) { return 4; }
    let is i64 as i with mut = 0;
    while (i < w * h * 3) {
        if (outp[i] != p[i]) { return 5; }
        i = i + 1;
    }

    // Smooth gradient falls back to a single table (K = 1).
    let is image.Image as g;
    if (image.image_init(&g, 48, 48, pixfmt.FMT_RGB8) != 0) { return 6; }
    y = 0;
    while (y < 48) {
        let is i64 as x with mut = 0;
        while (x < 48) {
            let is i64 as d = (y * 48 + x) * 3;
            g.pixels[d] = cast(u8, 30 + x); g.pixels[d + 1] = cast(u8, 40 + y);
            g.pixels[d + 2] = cast(u8, 20 + ((x + y) >> 1));
            x = x + 1;
        }
        y = y + 1;
    }
    let is cb.Bytes as eg = cb.bytes_new(4096);
    if (modular.modular_encode(&g, &eg) != 0) { return 7; }
    if (cast(i64, eg.ptr[0]) != 1) { return 8; }

    cb.bytes_free(&e); cb.bytes_free(&eg);
    image.image_free(&a); image.image_free(&g);
    mem.core.munmap(outp, w * h * 3 + 1);
    return 0;
}
