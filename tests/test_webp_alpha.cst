// test_webp_alpha — VP8X+ALPH lossy-with-alpha (bit-exact) and VP8L
// lossless-with-alpha decode, both byte-exact vs libwebp.
use "../core/image.cst"  as image;
use "../core/pixfmt.cst" as pixfmt;
use "../formats/webp.cst" as webp;
fn chk(d as *u8, dl as i64, ref as *u8, rl as i64, tol as i64) as i64 {
    let is image.Image as img;
    if (webp.webp_decode(d, dl, &img) != 0) { return 1; }
    if (img.fmt != pixfmt.FMT_RGBA8) { return 2; }
    let is i64 as i with mut = 0;
    while (i < rl) {
        let is i64 as e with mut = cast(i64, img.pixels[i]) - cast(i64, ref[i]);
        if (e < 0) { e = 0 - e; }
        if (e > tol) { return 3; }
        i = i + 1;
    }
    image.image_free(&img);
    return 0;
}
