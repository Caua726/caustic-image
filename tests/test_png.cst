// test_png — decode a real 2x2 RGB PNG (zlib-compressed IDAT, valid CRCs;
// generated by python's zlib). Exercises the caustic-compact zlib path, the
// chunk/CRC walk, and the None-filter unfilter. Same canonical image as the
// other foreign-format tests.
use "../core/image.cst"  as image;
use "../formats/png.cst" as png;
use "check.cst"          as chk;

fn main() as i64 {
    let is *u8 as data with imut = "\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x02\x00\x00\x00\x02\x08\x02\x00\x00\x00\xfd\xd4\x9a\x73\x00\x00\x00\x12\x49\x44\x41\x54\x78\xda\x63\xf8\xcf\xc0\xc0\x00\xc2\x0c\xff\x81\x00\x00\x1f\xee\x05\xfb\xf1\xab\xba\x77\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82";

    let is image.Image as img;
    let is i64 as rc = png.png_decode(data, 75, &img);
    if (rc != 0) { return 90; }
    let is i64 as c = chk.check_rgb2x2(&img);
    if (c != 0) { return c; }
    image.image_free(&img);
    return 0;
}
