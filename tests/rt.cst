// Round-trip test support: build a deterministic, varied image and compare
// two images byte-exact. The pattern deliberately mixes small deltas, large
// jumps, alpha changes, a run of identical pixels, and a non-adjacent repeat
// so encoders exercise every code path.
use "../core/image.cst"  as image;
use "../core/pixfmt.cst" as pixfmt;

fn make_image(img as *image.Image, w as i64, h as i64, fmt as i64) as i64 {
    let is i64 as rc = image.image_init(img, w, h, fmt);
    if (rc < 0) { return rc; }
    let is i64 as bpp = pixfmt.fmt_bpp(fmt);
    let is *u8 as dst = img.pixels;
    let is i64 as y with mut = 0;
    while (y < h) {
        let is i64 as x with mut = 0;
        while (x < w) {
            let is i64 as idx = y * w + x;
            let is i64 as r with mut = (idx * 17) & 255;
            let is i64 as g with mut = (idx * 29) & 255;
            let is i64 as b with mut = (idx * 43) & 255;
            let is i64 as a with mut = 255 - ((idx * 11) & 127);
            // run of identical pixels (QOI RUN) and a non-adjacent repeat (INDEX)
            if (y == 1) {
                if (x >= 2) { if (x <= 5) { r = 100; g = 100; b = 100; a = 255; } }
                if (x == 7) { r = 100; g = 100; b = 100; a = 255; }
            }
            let is i64 as di = y * img.stride + x * bpp;
            dst[di] = cast(u8, r);
            if (fmt == pixfmt.FMT_GRAYA8) { dst[di + 1] = cast(u8, a); }
            if (fmt == pixfmt.FMT_RGB8)  { dst[di + 1] = cast(u8, g); dst[di + 2] = cast(u8, b); }
            if (fmt == pixfmt.FMT_RGBA8) { dst[di + 1] = cast(u8, g); dst[di + 2] = cast(u8, b); dst[di + 3] = cast(u8, a); }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

// A low-colour (<=8) RGB8 image with horizontal runs — exercises palettes and
// LZW dictionary growth without exceeding GIF's 256-colour limit.
fn make_lowcolor(img as *image.Image, w as i64, h as i64) as i64 {
    let is i64 as rc = image.image_init(img, w, h, pixfmt.FMT_RGB8);
    if (rc < 0) { return rc; }
    let is *u8 as dst = img.pixels;
    let is i64 as y with mut = 0;
    while (y < h) {
        let is i64 as x with mut = 0;
        while (x < w) {
            let is i64 as ci = ((x / 3) + y) % 8;         // runs of 3 across
            let is i64 as di = y * img.stride + x * 3;
            dst[di]     = cast(u8, ci * 32);
            dst[di + 1] = cast(u8, 255 - ci * 30);
            dst[di + 2] = cast(u8, (ci * 50) & 255);
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

// 0 if the two images are identical (geometry + every pixel byte), else a code.
fn pixels_equal(a as *image.Image, b as *image.Image) as i64 {
    if (a.width != b.width)   { return 1; }
    if (a.height != b.height) { return 2; }
    if (a.fmt != b.fmt)       { return 3; }
    if (a.stride != b.stride) { return 4; }
    let is i64 as n = a.stride * a.height;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (a.pixels[i] != b.pixels[i]) { return 5; }
        i = i + 1;
    }
    return 0;
}
