// test_dct — IDCT of a known coefficient block must match the ramp (±2).
use "../transform/dct.cst" as dct;
fn main() as i64 {
    let is [64]i64 as cx; dct.dct_build_cx(cast(*i64, &cx));
    let is [64]i64 as coef;
    coef[0] = 0 - 688;
