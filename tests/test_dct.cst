    coef[63] = 0;
    let is [64]u8 as out;
    dct.idct8x8(cast(*i64, &coef), cast(*i64, &cx), cast(*u8, &out));
    let is i64 as i with mut = 0;
    while (i < 64) {
        let is i64 as got = cast(i64, out[i]);
        let is i64 as exp = _exp(i);
        let is i64 as d with mut = got - exp; if (d < 0) { d = 0 - d; }
        if (d > 2) { return 10 + i; }
        i = i + 1;
    }
    return 0;
}
fn _exp(i as i64) as i64 {
    if (i == 0) { return 0; }
    if (i == 1) { return 8; }
