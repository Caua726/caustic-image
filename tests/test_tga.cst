// test_tga — decode a 30-byte uncompressed 24-bit bottom-up TGA (type 2).
use "../core/image.cst"  as image;
use "../formats/tga.cst" as tga;
use "check.cst"          as chk;

fn main() as i64 {
    // 18-byte header (type 2, 2x2, 24bpp, bottom-up) + 12 bytes bottom-up BGR.
    let is *u8 as data with imut = "\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x02\x00\x18\x00\xff\x00\x00\xff\xff\xff\x00\x00\xff\x00\xff\x00";

    let is image.Image as img;
    let is i64 as rc = tga.tga_decode(data, 30, &img);
    if (rc != 0) { return 90; }
    let is i64 as c = chk.check_rgb2x2(&img);
    if (c != 0) { return c; }
    image.image_free(&img);
    return 0;
}
