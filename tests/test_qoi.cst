// test_qoi — decode a hand-built 2x2 RGBA QOI and check every pixel.
// Bytes were derived by hand from the QOI spec; the stream exercises the
// DIFF op (px0..px2) and the INDEX/colour-cache op (px3 == px0).
//   px0 red   (255,0,0,255)  -> QOI_OP_DIFF 0x5A
//   px1 green (0,255,0,255)  -> QOI_OP_DIFF 0x76
//   px2 blue  (0,0,255,255)  -> QOI_OP_DIFF 0x6D
//   px3 red   (255,0,0,255)  -> QOI_OP_INDEX 0x32 (cache hit)
use "../core/image.cst"  as image;
use "../core/pixfmt.cst" as pixfmt;
use "../formats/qoi.cst" as qoi;

fn main() as i64 {
    // header "qoif" | w=2 | h=2 | ch=4 | cs=0 | data 5A 76 6D 32 | end 00*7 01
    let is *u8 as data with imut = "\x71\x6f\x69\x66\x00\x00\x00\x02\x00\x00\x00\x02\x04\x00\x5a\x76\x6d\x32\x00\x00\x00\x00\x00\x00\x00\x01";

    let is image.Image as img;
    let is i64 as rc = qoi.qoi_decode(data, 26, &img);
    if (rc != 0) { return 10; }
    if (img.width != 2) { return 11; }
    if (img.height != 2) { return 12; }
    if (img.fmt != pixfmt.FMT_RGBA8) { return 13; }
    if (img.stride != 8) { return 14; }

    let is *u8 as p = img.pixels;
    // px0 red
    if (cast(i64, p[0]) != 255) { return 20; }
    if (cast(i64, p[1]) != 0)   { return 21; }
    if (cast(i64, p[2]) != 0)   { return 22; }
    if (cast(i64, p[3]) != 255) { return 23; }
    // px1 green
    if (cast(i64, p[4]) != 0)   { return 24; }
    if (cast(i64, p[5]) != 255) { return 25; }
    if (cast(i64, p[6]) != 0)   { return 26; }
    if (cast(i64, p[7]) != 255) { return 27; }
    // px2 blue
    if (cast(i64, p[8]) != 0)   { return 28; }
    if (cast(i64, p[9]) != 0)   { return 29; }
    if (cast(i64, p[10]) != 255) { return 30; }
    if (cast(i64, p[11]) != 255) { return 31; }
    // px3 red (colour-cache hit)
    if (cast(i64, p[12]) != 255) { return 32; }
    if (cast(i64, p[13]) != 0)   { return 33; }
    if (cast(i64, p[14]) != 0)   { return 34; }
    if (cast(i64, p[15]) != 255) { return 35; }

    image.image_free(&img);
    return 0;
}
