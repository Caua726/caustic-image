// test_pnm — decode a binary P6 (PPM) with header "P6\n2 2\n255\n" + 12 RGB bytes.
use "../core/image.cst"  as image;
use "../formats/pnm.cst" as pnm;
use "check.cst"          as chk;

fn main() as i64 {
    // "P6\n2 2\n255\n" then red green blue white (RGB, row-major).
    let is *u8 as data with imut = "\x50\x36\x0a\x32\x20\x32\x0a\x32\x35\x35\x0a\xff\x00\x00\x00\xff\x00\x00\x00\xff\xff\xff\xff";

    let is image.Image as img;
    let is i64 as rc = pnm.pnm_decode(data, 23, &img);
    if (rc != 0) { return 90; }
    let is i64 as c = chk.check_rgb2x2(&img);
    if (c != 0) { return c; }
    image.image_free(&img);
    return 0;
}
