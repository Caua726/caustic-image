    let is image.Image as img;
    let is i64 as rc = gif.gif_decode(data, 825, &img);
    if (rc != 0) { return 90; }
    if (img.width != 4)  { return 91; }
    if (img.height != 8) { return 92; }
    if (img.fmt != pixfmt.FMT_RGB8) { return 93; }
    let is *u8 as p = img.pixels;
    let is i64 as y with mut = 0;
    while (y < 8) {
        let is i64 as base = y * img.stride;
        let is i64 as expect = y * 30;
        if (cast(i64, p[base])     != expect) { return 10 + y; }
        if (cast(i64, p[base + 1]) != expect) { return 30 + y; }
        if (cast(i64, p[base + 2]) != expect) { return 50 + y; }
        y = y + 1;
    }
    image.image_free(&img);
    return 0;
}
