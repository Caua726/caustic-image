// Shared test assertion. The BMP/PNM/TGA golden vectors all decode to the same
// canonical 2x2 RGB8 image, so they share one checker.
//   row 0: red   (255,0,0)  green (0,255,0)
//   row 1: blue  (0,0,255)  white (255,255,255)
use "../core/pixfmt.cst" as pixfmt;
use "../core/image.cst"  as image;

fn check_rgb2x2(img as *image.Image) as i64 {
    if (img.width != 2)  { return 1; }
    if (img.height != 2) { return 2; }
    if (img.fmt != pixfmt.FMT_RGB8) { return 3; }
    if (img.stride != 6) { return 4; }
    let is *u8 as p = img.pixels;
    if (cast(i64, p[0])  != 255) { return 10; }   // red
    if (cast(i64, p[1])  != 0)   { return 11; }
    if (cast(i64, p[2])  != 0)   { return 12; }
    if (cast(i64, p[3])  != 0)   { return 13; }   // green
    if (cast(i64, p[4])  != 255) { return 14; }
    if (cast(i64, p[5])  != 0)   { return 15; }
    if (cast(i64, p[6])  != 0)   { return 16; }   // blue
    if (cast(i64, p[7])  != 0)   { return 17; }
    if (cast(i64, p[8])  != 255) { return 18; }
    if (cast(i64, p[9])  != 255) { return 19; }   // white
    if (cast(i64, p[10]) != 255) { return 20; }
    if (cast(i64, p[11]) != 255) { return 21; }
    return 0;
}
