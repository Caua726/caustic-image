\x20\x49\xff\x1f\x09\x41\xea\x02\x0f\x01\x76\x49\x4b\x20\x0c\x33\xc0\xff\xa0\x2b\x33\x58\x1f\x23\x43\x66\x55\x37\xba\x55\x38\x15\x17\x6f\x3b\xcd\x2d\x25\xc0\x37\x26\x46\x7c\x49\x66\x01\x22\x62\x7d\x62\x2a\x58\x68\x55\x75\xaf\x52\x5f\x54\x35\x59\x80\x64\x71\x65\x2d\x4b\x4f\x7b\x2f\x33\x80\x51\xab\x01\x39\x11\x05\x47\x66\x39\x35\x29\x31\x26\x21\x0d\x79\x39\x49\x1a\x01\x55\x29\x0a\x43\x8a\x4d\x6e\x5a\x2f\x72\x73\x15\x02\x0a\x66\xff\xa6\x17\x06\x65\x1d\x10\x0a\x55\x80\x65\xc4\x1a\x39\x12\x0a\x66\x66\xd5\x22\x14\x2b\x75\x14\x0f\x24\xa3\x80\x44\x01\x1a\x66\x3d\x47\x25\x22\x35\x1f\xf3\xc0\x45\x3c\x47\x26\x49\x77\x1c\xde\x25\x44\x2d\x80\x22\x01\x2f\x0b\xf5\xab\x3e\x11\x13\x46\x92\x55\x37\x3e\x46\x25\x2b\x25\x9a\x64\xa3\x55\xa0\x01\x3f\x09\x5c\x88\x1c\x40\x20\xc9\x55\x4b\x0f\x09\x09\x40\xff\xb8\x77\x10\x56\x06\x1c\x05\x40\xff\x19\xf8\x01\x38\x08\x11\x84\x89\xff\x37\x74\x80\x3a\x0f\x14\x52\x87\x39\x1a\x79\x28\xa4\x32\x1f\x89\x9a\x85\x19\x23\xda\x33\x67\x2c\x83\x83\x7b\x1f\x06\x9e\x56\x28\x40\x87\x94\xe0\x2d\xb7\x80\x16\x1a\x11\x83\xf0\x9a\x0e\x01\xd1\x2d\x10\x15\x5b\x40\xde\x07\x01\xc5\x38\x15\x27\x9b\x3c\x8a\x17\x66\xd5\x53\x0c\x0d\x36\xc0\xff\x44\x2f\x1c\x55\x1a\x55\x55\x80\x80\x20\x92\xab\x12\x0b\x07\x3f\x90\xab\x04\x04\xf6\x23\x1b\x0a\x92\xae\xab\x0c\x1a\x80\xbe\x50\x23\x63\xb4\x50\x7e\x36\x2d\x55\x7e\x2f\x57\xb0\x33\x29\x14\x20\x65\x4b\x80\x8b\x76\x92\x74\x80\x55\x38\x29\x0f\xb0\xec\x55\x25\x09\x3e\x47\x1e\x11\x77\x76\xff\x11\x12\x8a\x65\x26\x3c\x8a\x37\x46\x2b\x1a\x8e\x92\x24\x13\x1e\xab\xff\x61\x1b\x14\x8a\x2d\x3d\x3e\xdb\x01\x51\xbc\x40\x20\x29\x14\x75\x97\x8e\x14\x15\xa3\x70\x13\x0c\x3d\xc3\x80\x30\x04\x18";
// dequant lookup: DC (u8[128]) and AC (u16le[128])
let is *u8 as _DCQ with imut = "\x04\x05\x06\x07\x08\x09\x0a\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x11\x12\x13\x14\x14\x15\x15\x16\x16\x17\x17\x18\x19\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5b\x5d\x5f\x60\x62\x64\x65\x66\x68\x6a\x6c\x6e\x70\x72\x74\x76\x7a\x7c\x7e\x80\x82\x84\x86\x88\x8a\x8c\x8f\x91\x94\x97\x9a\x9d";
let is *u8 as _ACQ with imut = "\x04\x00\x05\x00\x06\x00\x07\x00\x08\x00\x09\x00\x0a\x00\x0b\x00\x0c\x00\x0d\x00\x0e\x00\x0f\x00\x10\x00\x11\x00\x12\x00\x13\x00\x14\x00\x15\x00\x16\x00\x17\x00\x18\x00\x19\x00\x1a\x00\x1b\x00\x1c\x00\x1d\x00\x1e\x00\x1f\x00\x20\x00\x21\x00\x22\x00\x23\x00\x24\x00\x25\x00\x26\x00\x27\x00\x28\x00\x29\x00\x2a\x00\x2b\x00\x2c\x00\x2d\x00\x2e\x00\x2f\x00\x30\x00\x31\x00\x32\x00\x33\x00\x34\x00\x35\x00\x36\x00\x37\x00\x38\x00\x39\x00\x3a\x00\x3c\x00\x3e\x00\x40\x00\x42\x00\x44\x00\x46\x00\x48\x00\x4a\x00\x4c\x00\x4e\x00\x50\x00\x52\x00\x54\x00\x56\x00\x58\x00\x5a\x00\x5c\x00\x5e\x00\x60\x00\x62\x00\x64\x00\x66\x00\x68\x00\x6a\x00\x6c\x00\x6e\x00\x70\x00\x72\x00\x74\x00\x77\x00\x7a\x00\x7d\x00\x80\x00\x83\x00\x86\x00\x89\x00\x8c\x00\x8f\x00\x92\x00\x95\x00\x98\x00\x9b\x00\x9e\x00\xa1\x00\xa4\x00\xa7\x00\xaa\x00\xad\x00\xb1\x00\xb5\x00\xb9\x00\xbd\x00\xc1\x00\xc5\x00\xc9\x00\xcd\x00\xd1\x00\xd5\x00\xd9\x00\xdd\x00\xe1\x00\xe5\x00\xea\x00\xef\x00\xf5\x00\xf9\x00\xfe\x00\x03\x01\x08\x01\x0d\x01\x12\x01\x17\x01\x1c\x01";

// kBands: coefficient position -> probability band.
let is *u8 as _KB with imut = "\x00\x01\x02\x03\x06\x04\x05\x06\x06\x06\x06\x06\x06\x06\x06\x07";
// zigzag: scan position -> raster index in the 4x4 block.
let is *u8 as _ZZ with imut = "\x00\x01\x04\x08\x05\x02\x03\x06\x09\x0c\x0d\x0a\x07\x0b\x0e\x0f";
// large-value category bit probabilities (cat3..cat6, 0-terminated).
let is *u8 as _CAT3 with imut = "\xad\x94\x8c";
let is *u8 as _CAT4 with imut = "\xb0\x9b\x8c\x87";
let is *u8 as _CAT5 with imut = "\xb4\x9d\x8d\x86\x82";
let is *u8 as _CAT6 with imut = "\xfe\xfe\xf3\xe6\xc4\xb1\x99\x8c\x85\x82\x81";

// ---- boolean decoder (RFC 6386 §7) ----
struct BoolDec {
    src as *u8;
    len as i64;
    pos as i64;
    range as i64;    // 128..255
    value as i64;    // 16-bit window
    bits as i64;     // bits consumed of the low byte (0..7)
    eof as i64;
}

fn bd_init(d as *BoolDec, src as *u8, len as i64) as void {
    d.src = src; d.len = len; d.pos = 2;
    d.range = 255;
    let is i64 as b0 with mut = 0;
    let is i64 as b1 with mut = 0;
    if (len > 0) { b0 = cast(i64, src[0]); }
    if (len > 1) { b1 = cast(i64, src[1]); }
    d.value = (b0 << 8) | b1;
    d.bits = 0;
    d.eof = 0;
}

fn bd_bit(d as *BoolDec, prob as i64) as i64 {
    let is i64 as split = 1 + (((d.range - 1) * prob) >> 8);
    let is i64 as bigsplit = split << 8;
    let is i64 as ret with mut = 0;
    if (d.value >= bigsplit) {
        ret = 1;
        d.range = d.range - split;
        d.value = d.value - bigsplit;
    } else {
        d.range = split;
    }
    while (d.range < 128) {
        d.value = d.value << 1;
        d.range = d.range << 1;
        d.bits = d.bits + 1;
        if (d.bits == 8) {
            d.bits = 0;
            if (d.pos < d.len) {
                d.value = d.value | cast(i64, d.src[d.pos]);
                d.pos = d.pos + 1;
            } else { d.eof = 1; }
        }
    }
    return ret;
}

// n-bit literal (MSB first, each bit at probability 128).
fn bd_val(d as *BoolDec, n as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { v = (v << 1) | bd_bit(d, 128); i = i + 1; }
    return v;
}
// value + sign flag (1 = negative).
fn bd_sval(d as *BoolDec, n as i64) as i64 {
    let is i64 as v = bd_val(d, n);
    if (bd_bit(d, 128) == 1) { return 0 - v; }
    return v;
}

// ---- decoder state (module globals) ----
let is BoolDec as _hbr with mut;          // header partition reader
let is [8]BoolDec as _tbr with mut;       // token partitions
let is i64 as _nparts with mut;
let is i64 as _mbw with mut;
let is i64 as _mbh with mut;
let is i64 as _width with mut;
let is i64 as _height with mut;
// segmentation
let is i64 as _useseg with mut;
let is i64 as _segabs with mut;
let is [4]i64 as _segq with mut;
let is [4]i64 as _segf with mut;
let is [3]i64 as _segp with mut;
let is i64 as _updmap with mut;
// filter
let is i64 as _fsimple with mut;
let is i64 as _flevel with mut;
let is i64 as _fsharp with mut;
let is i64 as _uselfdelta with mut;
let is [4]i64 as _reflf with mut;
let is [4]i64 as _modelf with mut;
// quant (per segment: y1dc y1ac y2dc y2ac uvdc uvac)
let is [24]i64 as _dqm with mut;
// skip
let is i64 as _useskip with mut;
let is i64 as _skipp with mut;
// coefficient probabilities [4][8][3][11] materialised as bytes
let is *u8 as _cp with mut;

fn _dcq(i as i64) as i64 {
    let is i64 as k with mut = i;
    if (k < 0) { k = 0; }
    if (k > 127) { k = 127; }
    return cast(i64, _DCQ[k]);
}
fn _acq(i as i64) as i64 {
    let is i64 as k with mut = i;
    if (k < 0) { k = 0; }
    if (k > 127) { k = 127; }
    return cast(i64, _ACQ[k * 2]) | (cast(i64, _ACQ[k * 2 + 1]) << 8);
}

// Parse everything up to (and including) the coefficient probabilities.
// Returns 0, or negative. Fills the module state; `src` is the VP8 payload.
fn _parse_headers(src as *u8, src_len as i64) as i64 {
    if (src_len < 10) { return errno.I_CORRUPT; }
    let is i64 as tag = cast(i64, src[0]) | (cast(i64, src[1]) << 8) | (cast(i64, src[2]) << 16);
    if ((tag & 1) != 0) { return errno.I_UNSUPPORTED; }       // not a keyframe
    if (((tag >> 1) & 7) > 3) { return errno.I_CORRUPT; }     // profile
    if (((tag >> 4) & 1) != 1) { return errno.I_UNSUPPORTED; } // not shown
    let is i64 as part0 = tag >> 5;
    if (cast(i64, src[3]) != 157) { return errno.I_CORRUPT; } // 0x9d
    if (cast(i64, src[4]) != 1) { return errno.I_CORRUPT; }
    if (cast(i64, src[5]) != 42) { return errno.I_CORRUPT; }  // 0x2a
    _width = (cast(i64, src[3 + 3]) | (cast(i64, src[4 + 3]) << 8)) & 16383;
    _height = (cast(i64, src[5 + 3]) | (cast(i64, src[6 + 3]) << 8)) & 16383;
    _mbw = (_width + 15) >> 4;
    _mbh = (_height + 15) >> 4;
    if (10 + part0 > src_len) { return errno.I_CORRUPT; }

    bd_init(&_hbr, cast(*u8, cast(i64, src) + 10), part0);
    bd_bit(&_hbr, 128);                                       // colour space
    bd_bit(&_hbr, 128);                                       // clamping

    // segmentation (§9.3)
    _useseg = bd_bit(&_hbr, 128);
    _updmap = 0;
    let is i64 as s with mut = 0;
    while (s < 4) { _segq[s] = 0; _segf[s] = 0; s = s + 1; }
    s = 0; while (s < 3) { _segp[s] = 255; s = s + 1; }
    _segabs = 0;
    if (_useseg == 1) {
        _updmap = bd_bit(&_hbr, 128);
        if (bd_bit(&_hbr, 128) == 1) {                        // update data
            _segabs = bd_bit(&_hbr, 128);
            s = 0;
            while (s < 4) {
                if (bd_bit(&_hbr, 128) == 1) { _segq[s] = bd_sval(&_hbr, 7); }
                s = s + 1;
            }
            s = 0;
            while (s < 4) {
                if (bd_bit(&_hbr, 128) == 1) { _segf[s] = bd_sval(&_hbr, 6); }
                s = s + 1;
            }
        }
        if (_updmap == 1) {
            s = 0;
            while (s < 3) {
                if (bd_bit(&_hbr, 128) == 1) { _segp[s] = bd_val(&_hbr, 8); }
                s = s + 1;
            }
        }
    }

    // filter header (§9.4)
    _fsimple = bd_bit(&_hbr, 128);
    _flevel = bd_val(&_hbr, 6);
    _fsharp = bd_val(&_hbr, 3);
    _uselfdelta = bd_bit(&_hbr, 128);
    let is i64 as i with mut = 0;
    while (i < 4) { _reflf[i] = 0; _modelf[i] = 0; i = i + 1; }
    _reflf[0] = _flevel;   // (defaults handled at use site)
    _reflf[0] = 0;
    if (_uselfdelta == 1) {
        if (bd_bit(&_hbr, 128) == 1) {
            i = 0;
            while (i < 4) {
                if (bd_bit(&_hbr, 128) == 1) { _reflf[i] = bd_sval(&_hbr, 6); }
                i = i + 1;
            }
            i = 0;
            while (i < 4) {
                if (bd_bit(&_hbr, 128) == 1) { _modelf[i] = bd_sval(&_hbr, 6); }
                i = i + 1;
            }
        }
    }

    // token partitions (§9.5): sizes live AFTER the first partition.
    _nparts = 1 << bd_val(&_hbr, 2);
    let is i64 as pstart with mut = 10 + part0;
    let is i64 as sizes_at = pstart;
    let is i64 as data_at with mut = pstart + (_nparts - 1) * 3;
    if (data_at > src_len) { return errno.I_CORRUPT; }
    let is i64 as p with mut = 0;
    while (p < _nparts - 1) {
        let is i64 as so = sizes_at + p * 3;
        let is i64 as psz = cast(i64, src[so]) | (cast(i64, src[so + 1]) << 8) | (cast(i64, src[so + 2]) << 16);
        if (data_at + psz > src_len) { return errno.I_CORRUPT; }
        bd_init(&_tbr[p], cast(*u8, cast(i64, src) + data_at), psz);
        data_at = data_at + psz;
        p = p + 1;
    }
    bd_init(&_tbr[_nparts - 1], cast(*u8, cast(i64, src) + data_at), src_len - data_at);

    // quantizers (§9.6)
    let is i64 as baseq = bd_val(&_hbr, 7);
    let is i64 as dqy1dc with mut = 0;
    if (bd_bit(&_hbr, 128) == 1) { dqy1dc = bd_sval(&_hbr, 4); }
    let is i64 as dqy2dc with mut = 0;
    if (bd_bit(&_hbr, 128) == 1) { dqy2dc = bd_sval(&_hbr, 4); }
    let is i64 as dqy2ac with mut = 0;
    if (bd_bit(&_hbr, 128) == 1) { dqy2ac = bd_sval(&_hbr, 4); }
    let is i64 as dquvdc with mut = 0;
    if (bd_bit(&_hbr, 128) == 1) { dquvdc = bd_sval(&_hbr, 4); }
    let is i64 as dquvac with mut = 0;
    if (bd_bit(&_hbr, 128) == 1) { dquvac = bd_sval(&_hbr, 4); }
    s = 0;
    while (s < 4) {
        let is i64 as q with mut = baseq;
        if (_useseg == 1) {
            q = _segq[s];
            if (_segabs == 0) { q = q + baseq; }
        }
        _dqm[s * 6]     = _dcq(q + dqy1dc);
        _dqm[s * 6 + 1] = _acq(q);
        _dqm[s * 6 + 2] = _dcq(q + dqy2dc) * 2;
        let is i64 as y2ac with mut = (_acq(q + dqy2ac) * 101581) >> 16;
        if (y2ac < 8) { y2ac = 8; }
        _dqm[s * 6 + 3] = y2ac;
        let is i64 as uvdc with mut = q + dquvdc;
        if (uvdc > 117) { uvdc = 117; }
        _dqm[s * 6 + 4] = _dcq(uvdc);
        _dqm[s * 6 + 5] = _acq(q + dquvac);
        s = s + 1;
    }

    bd_bit(&_hbr, 128);                                       // refresh entropy (ignored)

    // coefficient probability updates (§13.4)
    if (cast(i64, _cp) == 0) { _cp = mem.core.mmap_anon(1056); }
    i = 0;
    while (i < 1056) {
        if (bd_bit(&_hbr, cast(i64, _CPU[i])) == 1) { _cp[i] = cast(u8, bd_val(&_hbr, 8)); }
        else { _cp[i] = _CP0[i]; }
        i = i + 1;
    }

    _useskip = bd_bit(&_hbr, 128);
    _skipp = 0;
    if (_useskip == 1) { _skipp = bd_val(&_hbr, 8); }
    return 0;
}


// ---- coefficient probabilities access ----
fn _prob(typ as i64, band as i64, ctx as i64, idx as i64) as i64 {
    return cast(i64, _cp[((typ * 8 + band) * 3 + ctx) * 11 + idx]);
}
fn _kb(n as i64) as i64 {
    if (n >= 16) { return 0; }     // sentinel band
    return cast(i64, _KB[n]);
}

// large coefficient value (RFC 6386 §13.2 categories).
fn _getlarge(d as *BoolDec, typ as i64, band as i64, ctx as i64) as i64 {
    if (bd_bit(d, _prob(typ, band, ctx, 3)) == 0) {
        if (bd_bit(d, _prob(typ, band, ctx, 4)) == 0) { return 2; }
        return 3 + bd_bit(d, _prob(typ, band, ctx, 5));
    }
    if (bd_bit(d, _prob(typ, band, ctx, 6)) == 0) {
        if (bd_bit(d, _prob(typ, band, ctx, 7)) == 0) {
            return 5 + bd_bit(d, 159);
        }
        let is i64 as v with mut = 7 + 2 * bd_bit(d, 165);
        v = v + bd_bit(d, 145);
        return v;
    }
    let is i64 as bit1 = bd_bit(d, _prob(typ, band, ctx, 8));
    let is i64 as bit0 = bd_bit(d, _prob(typ, band, ctx, 9 + bit1));
    let is i64 as cat = 2 * bit1 + bit0;
    let is *u8 as tab with mut = _CAT3;
    let is i64 as tn with mut = 3;
    if (cat == 1) { tab = _CAT4; tn = 4; }
    if (cat == 2) { tab = _CAT5; tn = 5; }
    if (cat == 3) { tab = _CAT6; tn = 11; }
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < tn) {
        v = v + v + bd_bit(d, cast(i64, tab[i]));
        i = i + 1;
    }
    return v + 3 + (8 << cat);
}

// Decode one 4x4 block's coefficients (type typ) into out[16] (raster order,
// dequantized). Returns the position after the last non-zero coefficient.
fn _getcoeffs(d as *BoolDec, typ as i64, ctx0 as i64,
              dqdc as i64, dqac as i64, first as i64, out as *i64) as i64 {
    let is i64 as n with mut = first;
    let is i64 as band with mut = _kb(n);
    let is i64 as ctx with mut = ctx0;
    while (n < 16) {
        if (bd_bit(d, _prob(typ, band, ctx, 0)) == 0) { return n; }
        while (bd_bit(d, _prob(typ, band, ctx, 1)) == 0) {   // zero run
            n = n + 1;
            if (n == 16) { return 16; }
            band = _kb(n);
            ctx = 0;
        }
        let is i64 as v with mut = 0;
        let is i64 as nextctx with mut = 1;
        if (bd_bit(d, _prob(typ, band, ctx, 2)) == 0) { v = 1; }
        else { v = _getlarge(d, typ, band, ctx); nextctx = 2; }
        if (bd_bit(d, 128) == 1) { v = 0 - v; }
        let is i64 as dq with mut = dqac;
        if (n == 0) { dq = dqdc; }
        out[cast(i64, _ZZ[n])] = v * dq;
        n = n + 1;
        band = _kb(n);
        ctx = nextctx;
    }
    return 16;
}

// ---- transforms (RFC 6386 §14.3/§14.4) ----
fn _clip8(v as i64) as i64 {
    if (v < 0) { return 0; }
    if (v > 255) { return 255; }
    return v;
}
fn _m1(x as i64) as i64 { return x + ((x * 20091) >> 16); }
fn _m2(x as i64) as i64 { return (x * 35468) >> 16; }

// inverse DCT of in[16] added onto dst (stride 32), clipped.
fn _idct4(in as *i64, dst as *u8, doff as i64) as void {
    let is [16]i64 as t;
    let is i64 as i with mut = 0;
    while (i < 4) {
        let is i64 as a = in[i] + in[8 + i];
        let is i64 as b = in[i] - in[8 + i];
        let is i64 as c = _m2(in[4 + i]) - _m1(in[12 + i]);
        let is i64 as dd = _m1(in[4 + i]) + _m2(in[12 + i]);
        t[i] = a + dd; t[4 + i] = b + c; t[8 + i] = b - c; t[12 + i] = a - dd;
        i = i + 1;
    }
    i = 0;
    while (i < 4) {
        let is i64 as dc = t[i * 4] + 4;
        let is i64 as a = dc + t[i * 4 + 2];
        let is i64 as b = dc - t[i * 4 + 2];
        let is i64 as c = _m2(t[i * 4 + 1]) - _m1(t[i * 4 + 3]);
        let is i64 as dd = _m1(t[i * 4 + 1]) + _m2(t[i * 4 + 3]);
        let is i64 as o = doff + i * 32;
        dst[o]     = cast(u8, _clip8(cast(i64, dst[o]) + ((a + dd) >> 3)));
        dst[o + 1] = cast(u8, _clip8(cast(i64, dst[o + 1]) + ((b + c) >> 3)));
        dst[o + 2] = cast(u8, _clip8(cast(i64, dst[o + 2]) + ((b - c) >> 3)));
        dst[o + 3] = cast(u8, _clip8(cast(i64, dst[o + 3]) + ((a - dd) >> 3)));
        i = i + 1;
    }
}
// DC-only shortcut.
fn _idct_dc(dcv as i64, dst as *u8, doff as i64) as void {
    let is i64 as v = (dcv + 4) >> 3;
    let is i64 as j with mut = 0;
    while (j < 4) {
        let is i64 as i with mut = 0;
        while (i < 4) {
            let is i64 as o = doff + j * 32 + i;
            dst[o] = cast(u8, _clip8(cast(i64, dst[o]) + v));
            i = i + 1;
        }
        j = j + 1;
    }
}
// inverse WHT: dc[16] -> coefficient 0 of each of the 16 Y blocks in coeffs.
fn _iwht(dc as *i64, coeffs as *i64) as void {
    let is [16]i64 as t;
    let is i64 as i with mut = 0;
    while (i < 4) {
        let is i64 as a0 = dc[i] + dc[12 + i];
        let is i64 as a1 = dc[4 + i] + dc[8 + i];
        let is i64 as a2 = dc[4 + i] - dc[8 + i];
        let is i64 as a3 = dc[i] - dc[12 + i];
        t[i] = a0 + a1; t[8 + i] = a0 - a1; t[4 + i] = a3 + a2; t[12 + i] = a3 - a2;
        i = i + 1;
    }
    i = 0;
    while (i < 4) {
        let is i64 as dc0 = t[i * 4] + 3;
        let is i64 as a0 = dc0 + t[i * 4 + 3];
        let is i64 as a1 = t[i * 4 + 1] + t[i * 4 + 2];
        let is i64 as a2 = t[i * 4 + 1] - t[i * 4 + 2];
        let is i64 as a3 = dc0 - t[i * 4 + 3];
        coeffs[(i * 4) * 16]     = (a0 + a1) >> 3;
        coeffs[(i * 4 + 1) * 16] = (a3 + a2) >> 3;
        coeffs[(i * 4 + 2) * 16] = (a0 - a1) >> 3;
        coeffs[(i * 4 + 3) * 16] = (a3 - a2) >> 3;
        i = i + 1;
    }
}

// ---- intra predictors (dst points at the block's top-left inside a
// 32-byte-stride scratch whose margins hold left/top/topleft samples) ----
fn _avg2(a as i64, b as i64) as i64 { return (a + b + 1) >> 1; }
fn _avg3(a as i64, b as i64, c as i64) as i64 { return (a + 2 * b + c + 2) >> 2; }
fn _px(d as *u8, o as i64) as i64 { return cast(i64, d[o]); }

fn _fill(d as *u8, o as i64, size as i64, v as i64) as void {
    let is i64 as j with mut = 0;
    while (j < size) {
        let is i64 as i with mut = 0;
        while (i < size) { d[o + j * 32 + i] = cast(u8, v); i = i + 1; }
        j = j + 1;
    }
}

// size = 16 (luma) or 8 (chroma); mode = extended DC enum (0..6).
fn _pred_block(d as *u8, o as i64, size as i64, mode as i64) as void {
    if (mode == 0) {                                  // DC
        let is i64 as dc with mut = size;
        let is i64 as j with mut = 0;
        while (j < size) { dc = dc + _px(d, o - 1 + j * 32) + _px(d, o + j - 32); j = j + 1; }
        let is i64 as sh with mut = 5;
        if (size == 8) { sh = 4; }
        _fill(d, o, size, dc >> sh);
    } else { if (mode == 1) {                         // TrueMotion
        let is i64 as tl = _px(d, o - 32 - 1);
        let is i64 as j with mut = 0;
        while (j < size) {
            let is i64 as l = _px(d, o - 1 + j * 32);
            let is i64 as i with mut = 0;
            while (i < size) {
                d[o + j * 32 + i] = cast(u8, _clip8(l + _px(d, o + i - 32) - tl));
                i = i + 1;
            }
            j = j + 1;
        }
    } else { if (mode == 2) {                         // Vertical
        let is i64 as j with mut = 0;
        while (j < size) {
            let is i64 as i with mut = 0;
            while (i < size) { d[o + j * 32 + i] = d[o + i - 32]; i = i + 1; }
            j = j + 1;
        }
    } else { if (mode == 3) {                         // Horizontal
        let is i64 as j with mut = 0;
        while (j < size) {
            let is i64 as v = _px(d, o - 1 + j * 32);
            let is i64 as i with mut = 0;
            while (i < size) { d[o + j * 32 + i] = cast(u8, v); i = i + 1; }
            j = j + 1;
        }
    } else { if (mode == 4) {                         // DC no top
        let is i64 as dc with mut = size / 2;
        let is i64 as j with mut = 0;
        while (j < size) { dc = dc + _px(d, o - 1 + j * 32); j = j + 1; }
        let is i64 as sh with mut = 4;
        if (size == 8) { sh = 3; }
        _fill(d, o, size, dc >> sh);
    } else { if (mode == 5) {                         // DC no left
        let is i64 as dc with mut = size / 2;
        let is i64 as i with mut = 0;
        while (i < size) { dc = dc + _px(d, o + i - 32); i = i + 1; }
        let is i64 as sh with mut = 4;
        if (size == 8) { sh = 3; }
        _fill(d, o, size, dc >> sh);
    } else {                                          // DC nothing
        _fill(d, o, size, 128);
    } } } } } }
}

fn _put4(d as *u8, o as i64, x as i64, y as i64, v as i64) as void {
    d[o + y * 32 + x] = cast(u8, v);
}

// 4x4 luma predictor, mode 0..9.
fn _pred4(d as *u8, o as i64, mode as i64) as void {
    if (mode == 0) {                                  // B_DC_PRED
        let is i64 as dc with mut = 4;
        let is i64 as i with mut = 0;
        while (i < 4) { dc = dc + _px(d, o + i - 32) + _px(d, o - 1 + i * 32); i = i + 1; }
        dc = dc >> 3;
        let is i64 as j with mut = 0;
        while (j < 4) { i = 0; while (i < 4) { _put4(d, o, i, j, dc); i = i + 1; } j = j + 1; }
        return;
    }
    if (mode == 1) {                                  // B_TM_PRED
        let is i64 as tl = _px(d, o - 32 - 1);
        let is i64 as j with mut = 0;
        while (j < 4) {
            let is i64 as l = _px(d, o - 1 + j * 32);
            let is i64 as i with mut = 0;
            while (i < 4) { _put4(d, o, i, j, _clip8(l + _px(d, o + i - 32) - tl)); i = i + 1; }
            j = j + 1;
        }
        return;
    }
    let is i64 as X = _px(d, o - 32 - 1);
    let is i64 as A = _px(d, o - 32);
    let is i64 as B = _px(d, o - 32 + 1);
    let is i64 as C = _px(d, o - 32 + 2);
    let is i64 as D = _px(d, o - 32 + 3);
    let is i64 as E = _px(d, o - 32 + 4);
    let is i64 as F = _px(d, o - 32 + 5);
    let is i64 as G = _px(d, o - 32 + 6);
    let is i64 as H = _px(d, o - 32 + 7);
    let is i64 as I = _px(d, o - 1);
    let is i64 as J = _px(d, o - 1 + 32);
    let is i64 as K = _px(d, o - 1 + 64);
    let is i64 as L = _px(d, o - 1 + 96);
    if (mode == 2) {                                  // B_VE_PRED
        let is [4]i64 as vv;
        vv[0] = _avg3(X, A, B); vv[1] = _avg3(A, B, C);
        vv[2] = _avg3(B, C, D); vv[3] = _avg3(C, D, E);
        let is i64 as j with mut = 0;
        while (j < 4) {
            let is i64 as i with mut = 0;
            while (i < 4) { _put4(d, o, i, j, vv[i]); i = i + 1; }
            j = j + 1;
        }
        return;
    }
    if (mode == 3) {                                  // B_HE_PRED
        let is i64 as i with mut = 0;
        let is [4]i64 as hv;
        hv[0] = _avg3(X, I, J); hv[1] = _avg3(I, J, K);
        hv[2] = _avg3(J, K, L); hv[3] = _avg3(K, L, L);
        let is i64 as j with mut = 0;
        while (j < 4) {
            i = 0; while (i < 4) { _put4(d, o, i, j, hv[j]); i = i + 1; }
            j = j + 1;
        }
        return;
    }
    if (mode == 4) {                                  // B_RD_PRED
        _put4(d,o,0,3,_avg3(J,K,L));
        let is i64 as v1 = _avg3(I,J,K); _put4(d,o,1,3,v1); _put4(d,o,0,2,v1);
        let is i64 as v2 = _avg3(X,I,J); _put4(d,o,2,3,v2); _put4(d,o,1,2,v2); _put4(d,o,0,1,v2);
        let is i64 as v3 = _avg3(A,X,I); _put4(d,o,3,3,v3); _put4(d,o,2,2,v3); _put4(d,o,1,1,v3); _put4(d,o,0,0,v3);
        let is i64 as v4 = _avg3(B,A,X); _put4(d,o,3,2,v4); _put4(d,o,2,1,v4); _put4(d,o,1,0,v4);
        let is i64 as v5 = _avg3(C,B,A); _put4(d,o,3,1,v5); _put4(d,o,2,0,v5);
        _put4(d,o,3,0,_avg3(D,C,B));
        return;
    }
    if (mode == 5) {                                  // B_VR_PRED
        let is i64 as v1 = _avg2(X,A); _put4(d,o,0,0,v1); _put4(d,o,1,2,v1);
        let is i64 as v2 = _avg2(A,B); _put4(d,o,1,0,v2); _put4(d,o,2,2,v2);
        let is i64 as v3 = _avg2(B,C); _put4(d,o,2,0,v3); _put4(d,o,3,2,v3);
        _put4(d,o,3,0,_avg2(C,D));
        _put4(d,o,0,3,_avg3(K,J,I));
        _put4(d,o,0,2,_avg3(J,I,X));
        let is i64 as v4 = _avg3(I,X,A); _put4(d,o,0,1,v4); _put4(d,o,1,3,v4);
        let is i64 as v5 = _avg3(X,A,B); _put4(d,o,1,1,v5); _put4(d,o,2,3,v5);
        let is i64 as v6 = _avg3(A,B,C); _put4(d,o,2,1,v6); _put4(d,o,3,3,v6);
        _put4(d,o,3,1,_avg3(B,C,D));
        return;
    }
    if (mode == 6) {                                  // B_LD_PRED
        _put4(d,o,0,0,_avg3(A,B,C));
        let is i64 as v1 = _avg3(B,C,D); _put4(d,o,1,0,v1); _put4(d,o,0,1,v1);
        let is i64 as v2 = _avg3(C,D,E); _put4(d,o,2,0,v2); _put4(d,o,1,1,v2); _put4(d,o,0,2,v2);
        let is i64 as v3 = _avg3(D,E,F); _put4(d,o,3,0,v3); _put4(d,o,2,1,v3); _put4(d,o,1,2,v3); _put4(d,o,0,3,v3);
        let is i64 as v4 = _avg3(E,F,G); _put4(d,o,3,1,v4); _put4(d,o,2,2,v4); _put4(d,o,1,3,v4);
        let is i64 as v5 = _avg3(F,G,H); _put4(d,o,3,2,v5); _put4(d,o,2,3,v5);
        _put4(d,o,3,3,_avg3(G,H,H));
        return;
    }
    if (mode == 7) {                                  // B_VL_PRED
        _put4(d,o,0,0,_avg2(A,B));
        let is i64 as v1 = _avg2(B,C); _put4(d,o,1,0,v1); _put4(d,o,0,2,v1);
        let is i64 as v2 = _avg2(C,D); _put4(d,o,2,0,v2); _put4(d,o,1,2,v2);
        let is i64 as v3 = _avg2(D,E); _put4(d,o,3,0,v3); _put4(d,o,2,2,v3);
        _put4(d,o,0,1,_avg3(A,B,C));
        let is i64 as v4 = _avg3(B,C,D); _put4(d,o,1,1,v4); _put4(d,o,0,3,v4);
        let is i64 as v5 = _avg3(C,D,E); _put4(d,o,2,1,v5); _put4(d,o,1,3,v5);
        let is i64 as v6 = _avg3(D,E,F); _put4(d,o,3,1,v6); _put4(d,o,2,3,v6);
        _put4(d,o,3,2,_avg3(E,F,G));
        _put4(d,o,3,3,_avg3(F,G,H));
        return;
    }
    if (mode == 8) {                                  // B_HD_PRED
        let is i64 as v1 = _avg2(I,X); _put4(d,o,0,0,v1); _put4(d,o,2,1,v1);
        let is i64 as v2 = _avg2(J,I); _put4(d,o,0,1,v2); _put4(d,o,2,2,v2);
        let is i64 as v3 = _avg2(K,J); _put4(d,o,0,2,v3); _put4(d,o,2,3,v3);
        _put4(d,o,0,3,_avg2(L,K));
        _put4(d,o,3,0,_avg3(A,B,C));
        _put4(d,o,2,0,_avg3(X,A,B));
        let is i64 as v4 = _avg3(I,X,A); _put4(d,o,1,0,v4); _put4(d,o,3,1,v4);
        let is i64 as v5 = _avg3(X,I,J); _put4(d,o,1,1,v5); _put4(d,o,3,2,v5);
        let is i64 as v6 = _avg3(I,J,K); _put4(d,o,1,2,v6); _put4(d,o,3,3,v6);
        _put4(d,o,1,3,_avg3(J,K,L));
        return;
    }
    // mode 9: B_HU_PRED
    _put4(d,o,0,0,_avg2(I,J));
    let is i64 as v1 = _avg2(J,K); _put4(d,o,2,0,v1); _put4(d,o,0,1,v1);
    let is i64 as v2 = _avg2(K,L); _put4(d,o,2,1,v2); _put4(d,o,0,2,v2);
    _put4(d,o,1,0,_avg3(I,J,K));
    let is i64 as v3 = _avg3(J,K,L); _put4(d,o,3,0,v3); _put4(d,o,1,1,v3);
    let is i64 as v4 = _avg3(K,L,L); _put4(d,o,3,1,v4); _put4(d,o,1,2,v4);
    _put4(d,o,3,2,L); _put4(d,o,2,2,L); _put4(d,o,0,3,L);
    _put4(d,o,1,3,L); _put4(d,o,2,3,L); _put4(d,o,3,3,L);
}

// keyframe 4x4 mode tree (RFC 6386 §11.2) under kBModesProba[top][left].
fn _parse_bmode(d as *BoolDec, top as i64, left as i64) as i64 {
    let is i64 as base = (top * 10 + left) * 9;
    if (bd_bit(d, cast(i64, _BMP[base])) == 0) { return 0; }        // DC
    if (bd_bit(d, cast(i64, _BMP[base + 1])) == 0) { return 1; }    // TM
    if (bd_bit(d, cast(i64, _BMP[base + 2])) == 0) { return 2; }    // VE
    if (bd_bit(d, cast(i64, _BMP[base + 3])) == 0) {
        if (bd_bit(d, cast(i64, _BMP[base + 4])) == 0) { return 3; }   // HE
        if (bd_bit(d, cast(i64, _BMP[base + 5])) == 0) { return 4; }   // RD
        return 5;                                                       // VR
    }
    if (bd_bit(d, cast(i64, _BMP[base + 6])) == 0) { return 6; }    // LD
    if (bd_bit(d, cast(i64, _BMP[base + 7])) == 0) { return 7; }    // VL
    if (bd_bit(d, cast(i64, _BMP[base + 8])) == 0) { return 8; }    // HD
    return 9;                                                        // HU
}

// ---- in-loop deblocking filter (RFC 6386 §15) ----
fn _sclip1(v as i64) as i64 {
    if (v < 0 - 128) { return 0 - 128; }
    if (v > 127) { return 127; }
    return v;
}
fn _sclip2(v as i64) as i64 {
    if (v < 0 - 16) { return 0 - 16; }
    if (v > 15) { return 15; }
    return v;
}
fn _iabs2(v as i64) as i64 { if (v < 0) { return 0 - v; } return v; }

fn _dofilter2(p as *u8, o as i64, step as i64) as void {
    let is i64 as p1 = _px(p, o - 2 * step);
    let is i64 as p0 = _px(p, o - step);
    let is i64 as q0 = _px(p, o);
    let is i64 as q1 = _px(p, o + step);
    let is i64 as a = 3 * (q0 - p0) + _sclip1(p1 - q1);
    let is i64 as a1 = _sclip2((a + 4) >> 3);
    let is i64 as a2 = _sclip2((a + 3) >> 3);
    p[o - step] = cast(u8, _clip8(p0 + a2));
    p[o]        = cast(u8, _clip8(q0 - a1));
}
fn _dofilter4(p as *u8, o as i64, step as i64) as void {
    let is i64 as p1 = _px(p, o - 2 * step);
    let is i64 as p0 = _px(p, o - step);
    let is i64 as q0 = _px(p, o);
    let is i64 as q1 = _px(p, o + step);
    let is i64 as a = 3 * (q0 - p0);
    let is i64 as a1 = _sclip2((a + 4) >> 3);
    let is i64 as a2 = _sclip2((a + 3) >> 3);
    let is i64 as a3 = (a1 + 1) >> 1;
    p[o - 2 * step] = cast(u8, _clip8(p1 + a3));
    p[o - step]     = cast(u8, _clip8(p0 + a2));
    p[o]            = cast(u8, _clip8(q0 - a1));
    p[o + step]     = cast(u8, _clip8(q1 - a3));
}
fn _dofilter6(p as *u8, o as i64, step as i64) as void {
    let is i64 as p2 = _px(p, o - 3 * step);
    let is i64 as p1 = _px(p, o - 2 * step);
    let is i64 as p0 = _px(p, o - step);
    let is i64 as q0 = _px(p, o);
    let is i64 as q1 = _px(p, o + step);
    let is i64 as q2 = _px(p, o + 2 * step);
    let is i64 as a = _sclip1(3 * (q0 - p0) + _sclip1(p1 - q1));
    let is i64 as a1 = (27 * a + 63) >> 7;
    let is i64 as a2 = (18 * a + 63) >> 7;
    let is i64 as a3 = (9 * a + 63) >> 7;
    p[o - 3 * step] = cast(u8, _clip8(p2 + a3));
    p[o - 2 * step] = cast(u8, _clip8(p1 + a2));
    p[o - step]     = cast(u8, _clip8(p0 + a1));
    p[o]            = cast(u8, _clip8(q0 - a1));
    p[o + step]     = cast(u8, _clip8(q1 - a2));
    p[o + 2 * step] = cast(u8, _clip8(q2 - a3));
}
fn _hev(p as *u8, o as i64, step as i64, thresh as i64) as i64 {
    if (_iabs2(_px(p, o - 2 * step) - _px(p, o - step)) > thresh) { return 1; }
    if (_iabs2(_px(p, o + step) - _px(p, o)) > thresh) { return 1; }
    return 0;
}
fn _needsf(p as *u8, o as i64, step as i64, t as i64) as i64 {
    let is i64 as v = 4 * _iabs2(_px(p, o - step) - _px(p, o)) +
        _iabs2(_px(p, o - 2 * step) - _px(p, o + step));
    if (v <= t) { return 1; }
    return 0;
}
fn _needsf2(p as *u8, o as i64, step as i64, t as i64, it as i64) as i64 {
    if (_needsf(p, o, step, t) == 0) { return 0; }
    if (_iabs2(_px(p, o - 4 * step) - _px(p, o - 3 * step)) > it) { return 0; }
    if (_iabs2(_px(p, o - 3 * step) - _px(p, o - 2 * step)) > it) { return 0; }
    if (_iabs2(_px(p, o - 2 * step) - _px(p, o - step)) > it) { return 0; }
    if (_iabs2(_px(p, o + 3 * step) - _px(p, o + 2 * step)) > it) { return 0; }
    if (_iabs2(_px(p, o + 2 * step) - _px(p, o + step)) > it) { return 0; }
    if (_iabs2(_px(p, o + step) - _px(p, o)) > it) { return 0; }
    return 1;
}
// hstride = step across the edge; vstride = advance along the edge.
fn _floop26(p as *u8, o0 as i64, hstride as i64, vstride as i64, size as i64,
            thresh as i64, ithresh as i64, hevt as i64) as void {
    let is i64 as t2 = 2 * thresh + 1;
    let is i64 as o with mut = o0;
    let is i64 as k with mut = 0;
    while (k < size) {
        if (_needsf2(p, o, hstride, t2, ithresh) == 1) {
            if (_hev(p, o, hstride, hevt) == 1) { _dofilter2(p, o, hstride); }
            else { _dofilter6(p, o, hstride); }
        }
        o = o + vstride;
        k = k + 1;
    }
}
fn _floop24(p as *u8, o0 as i64, hstride as i64, vstride as i64, size as i64,
            thresh as i64, ithresh as i64, hevt as i64) as void {
    let is i64 as t2 = 2 * thresh + 1;
    let is i64 as o with mut = o0;
    let is i64 as k with mut = 0;
    while (k < size) {
        if (_needsf2(p, o, hstride, t2, ithresh) == 1) {
            if (_hev(p, o, hstride, hevt) == 1) { _dofilter2(p, o, hstride); }
            else { _dofilter4(p, o, hstride); }
        }
        o = o + vstride;
        k = k + 1;
    }
}
fn _sfloop(p as *u8, o0 as i64, hstride as i64, vstride as i64, size as i64, thresh as i64) as void {
    let is i64 as t2 = 2 * thresh + 1;
    let is i64 as o with mut = o0;
    let is i64 as k with mut = 0;
    while (k < size) {
        if (_needsf(p, o, hstride, t2) == 1) { _dofilter2(p, o, hstride); }
        o = o + vstride;
        k = k + 1;
    }
}

// ---- top-level decode ------------------------------------------------------
fn vp8_decode(src as *u8, src_len as i64, out as *image.Image) as i64 {
    let is i64 as hrc = _parse_headers(src, src_len);
    if (hrc < 0) { return hrc; }
    let is i64 as mbw = _mbw;
    let is i64 as mbh = _mbh;
    if (image.image_check_dims(_width, _height, pixfmt.FMT_RGB8) < 0) { return errno.I_DIMS; }
    let is i64 as yw = mbw * 16;
    let is i64 as yh = mbh * 16;
    let is i64 as cw = mbw * 8;
    let is i64 as chh = mbh * 8;
    let is *u8 as py = mem.core.mmap_anon(yw * yh);
    let is *u8 as pu = mem.core.mmap_anon(cw * chh);
    let is *u8 as pv = mem.core.mmap_anon(cw * chh);
    // per-row mode data
    let is *u8 as imodes = mem.core.mmap_anon(mbw * 16);
    let is *u8 as i4f = mem.core.mmap_anon(mbw + 1);
    let is *u8 as uvm = mem.core.mmap_anon(mbw + 1);
    let is *u8 as segs = mem.core.mmap_anon(mbw + 1);
    let is *u8 as skips = mem.core.mmap_anon(mbw + 1);
    // intra mode context rows
    let is *u8 as intra_t = mem.core.mmap_anon(mbw * 4 + 4);
    let is [4]i64 as intra_l;
    // nz contexts: index 0 = left, 1..mbw = per-MB top
    let is *i64 as nzv = cast(*i64, mem.core.mmap_anon((mbw + 1) * 8));
    let is *i64 as nzdc = cast(*i64, mem.core.mmap_anon((mbw + 1) * 8));
    // filter info per MB: 4 fields
    let is *i64 as finfo = cast(*i64, mem.core.mmap_anon(mbw * mbh * 4 * 8));
    // scratch (stride 32): y rows -1..15 at col 1; u/v rows -1..7 at col 1
    let is *u8 as sy = mem.core.mmap_anon(18 * 32);
    let is *u8 as su = mem.core.mmap_anon(10 * 32);
    let is *u8 as sv = mem.core.mmap_anon(10 * 32);
    let is *i64 as coeffs = cast(*i64, mem.core.mmap_anon(384 * 8));
    if (cast(i64, coeffs) <= 0) { return errno.I_OOM; }
    mem.core.memset(intra_t, cast(i32, 0), mbw * 4);
    let is i64 as i with mut = 0;
    while (i < mbw + 1) { nzv[i] = 0; nzdc[i] = 0; i = i + 1; }

    let is i64 as yo = 32 + 1;      // scratch offsets (row 1, col 1)
    let is i64 as co = 32 + 1;

    let is i64 as mby with mut = 0;
    while (mby < mbh) {
        // -- parse the whole row's intra modes from the header partition --
        intra_l[0] = 0; intra_l[1] = 0; intra_l[2] = 0; intra_l[3] = 0;
        nzv[0] = 0; nzdc[0] = 0;
        let is i64 as mbx with mut = 0;
        while (mbx < mbw) {
            let is i64 as seg with mut = 0;
            if (_updmap == 1) {
                if (bd_bit(&_hbr, _segp[0]) == 0) { seg = bd_bit(&_hbr, _segp[1]); }
                else { seg = 2 + bd_bit(&_hbr, _segp[2]); }
            }
            segs[mbx] = cast(u8, seg);
            let is i64 as skip with mut = 0;
            if (_useskip == 1) { skip = bd_bit(&_hbr, _skipp); }
            skips[mbx] = cast(u8, skip);
            let is i64 as is4 = 1 - bd_bit(&_hbr, 145);
            i4f[mbx] = cast(u8, is4);
            if (is4 == 0) {
                let is i64 as ym with mut = 0;
                if (bd_bit(&_hbr, 156) == 1) {
                    if (bd_bit(&_hbr, 128) == 1) { ym = 1; } else { ym = 3; }   // TM : H
                } else {
                    if (bd_bit(&_hbr, 163) == 1) { ym = 2; } else { ym = 0; }   // V : DC
                }
                imodes[mbx * 16] = cast(u8, ym);
                intra_t[mbx * 4] = cast(u8, ym); intra_t[mbx * 4 + 1] = cast(u8, ym);
                intra_t[mbx * 4 + 2] = cast(u8, ym); intra_t[mbx * 4 + 3] = cast(u8, ym);
                intra_l[0] = ym; intra_l[1] = ym; intra_l[2] = ym; intra_l[3] = ym;
            } else {
                let is i64 as by with mut = 0;
                while (by < 4) {
                    let is i64 as left with mut = intra_l[by];
                    let is i64 as bx with mut = 0;
                    while (bx < 4) {
                        let is i64 as m = _parse_bmode(&_hbr, cast(i64, intra_t[mbx * 4 + bx]), left);
                        imodes[mbx * 16 + by * 4 + bx] = cast(u8, m);
                        intra_t[mbx * 4 + bx] = cast(u8, m);
                        left = m;
                        bx = bx + 1;
                    }
                    intra_l[by] = left;
                    by = by + 1;
                }
            }
            let is i64 as uv with mut = 0;
            if (bd_bit(&_hbr, 142) == 1) {
                if (bd_bit(&_hbr, 114) == 1) {
                    if (bd_bit(&_hbr, 183) == 1) { uv = 1; } else { uv = 3; }   // TM : H
                } else { uv = 2; }                                              // V
            }
            uvm[mbx] = cast(u8, uv);
            mbx = mbx + 1;
        }

        // -- residuals + reconstruction per MB --
        let is *BoolDec as tbr = cast(*BoolDec, cast(i64, cast(*BoolDec, &_tbr))
            + (mby & (_nparts - 1)) * sizeof(BoolDec));
        mbx = 0;
        while (mbx < mbw) {
            let is i64 as seg = cast(i64, segs[mbx]);
            let is i64 as is4 = cast(i64, i4f[mbx]);
            let is i64 as skip with mut = cast(i64, skips[mbx]);
            i = 0;
            while (i < 384) { coeffs[i] = 0; i = i + 1; }
            let is i64 as nzy with mut = 0;      // 32-bit nz codes (4 rows × 4 blocks × 2b)
            let is i64 as nzuv with mut = 0;

            if (skip == 0) {
                let is i64 as anyz with mut = 0;
                let is i64 as first with mut = 0;
                let is i64 as ytype with mut = 3;
                if (is4 == 0) {
                    // Y2 (WHT DC) block
                    let is [16]i64 as dc16;
                    i = 0; while (i < 16) { dc16[i] = 0; i = i + 1; }
                    let is i64 as ctx = nzdc[1 + mbx] + nzdc[0];
                    let is i64 as nz = _getcoeffs(tbr, 1, ctx, _dqm[seg * 6 + 2], _dqm[seg * 6 + 3], 0, cast(*i64, &dc16));
                    let is i64 as got with mut = 0;
                    if (nz > 0) { got = 1; }
                    nzdc[1 + mbx] = got; nzdc[0] = got;
                    if (nz > 1) { _iwht(cast(*i64, &dc16), coeffs); }
                    else {
                        let is i64 as dc0 = (dc16[0] + 3) >> 3;
                        i = 0; while (i < 16) { coeffs[i * 16] = dc0; i = i + 1; }
                    }
                    if (got == 1) { anyz = 1; }
                    first = 1;
                    ytype = 0;
                }
                // 16 luma blocks
                let is i64 as tnz with mut = nzv[1 + mbx] & 15;
                let is i64 as lnz with mut = nzv[0] & 15;
                let is i64 as y2 with mut = 0;
                while (y2 < 4) {
                    let is i64 as l with mut = lnz & 1;
                    let is i64 as rowcodes with mut = 0;
                    let is i64 as x2 with mut = 0;
                    while (x2 < 4) {
                        let is i64 as ctx = l + (tnz & 1);
                        let is *i64 as blk = cast(*i64, cast(i64, coeffs) + ((y2 * 4 + x2) * 16) * 8);
                        let is i64 as nz = _getcoeffs(tbr, ytype, ctx, _dqm[seg * 6], _dqm[seg * 6 + 1], first, blk);
                        if (nz > first) { l = 1; } else { l = 0; }
                        tnz = (tnz >> 1) | (l << 7);
                        let is i64 as code with mut = 0;
                        if (nz > 3) { code = 3; }
                        else { if (nz > 1) { code = 2; }
                        else { if (blk[0] != 0) { code = 1; } } }
                        rowcodes = (rowcodes << 2) | code;
                        if (code != 0) { anyz = 1; }
                        x2 = x2 + 1;
                    }
                    tnz = tnz >> 4;
                    lnz = (lnz >> 1) | (l << 7);
                    nzy = (nzy << 8) | rowcodes;
                    y2 = y2 + 1;
                }
                let is i64 as out_t with mut = tnz;
                let is i64 as out_l with mut = lnz >> 4;
                // chroma blocks (U then V)
                let is i64 as ch with mut = 0;
                while (ch < 4) {
                    let is i64 as ccodes with mut = 0;
                    tnz = (nzv[1 + mbx] >> (4 + ch)) & 3;
                    lnz = (nzv[0] >> (4 + ch)) & 3;
                    y2 = 0;
                    while (y2 < 2) {
                        let is i64 as l with mut = lnz & 1;
                        let is i64 as x2 with mut = 0;
                        while (x2 < 2) {
                            let is i64 as ctx = l + (tnz & 1);
                            let is i64 as bidx = 16 + ch * 2 + y2 * 2 + x2;
                            let is *i64 as blk = cast(*i64, cast(i64, coeffs) + (bidx * 16) * 8);
                            let is i64 as nz = _getcoeffs(tbr, 2, ctx, _dqm[seg * 6 + 4], _dqm[seg * 6 + 5], 0, blk);
                            if (nz > 0) { l = 1; } else { l = 0; }
                            tnz = (tnz >> 1) | (l << 3);
                            let is i64 as code with mut = 0;
                            if (nz > 3) { code = 3; }
                            else { if (nz > 1) { code = 2; }
                            else { if (blk[0] != 0) { code = 1; } } }
                            ccodes = (ccodes << 2) | code;
                            if (code != 0) { anyz = 1; }
                            x2 = x2 + 1;
                        }
                        tnz = tnz >> 2;
                        lnz = (lnz >> 1) | (l << 5);
                        y2 = y2 + 1;
                    }
                    nzuv = nzuv | (ccodes << (4 * ch));
                    out_t = out_t | ((tnz << 4) << ch);
                    out_l = out_l | ((lnz & 240) << ch);
                    ch = ch + 2;
                }
                nzv[1 + mbx] = out_t;
                nzv[0] = out_l;
                if (anyz == 0) { skip = 1; }
            } else {
                nzv[0] = 0; nzv[1 + mbx] = 0;
                if (is4 == 0) { nzdc[0] = 0; nzdc[1 + mbx] = 0; }
            }

            // -- filter info --
            let is i64 as base_level with mut = _flevel;
            if (_useseg == 1) {
                base_level = _segf[seg];
                if (_segabs == 0) { base_level = base_level + _flevel; }
            }
            let is i64 as lvl with mut = base_level;
            if (_uselfdelta == 1) {
                lvl = lvl + _reflf[0];
                if (is4 == 1) { lvl = lvl + _modelf[0]; }
            }
            if (lvl < 0) { lvl = 0; }
            if (lvl > 63) { lvl = 63; }
            let is i64 as fo = (mby * mbw + mbx) * 4;
            if (lvl == 0) { finfo[fo] = 0; }
            else {
                let is i64 as il with mut = lvl;
                if (_fsharp > 0) {
                    if (_fsharp > 4) { il = il >> 2; } else { il = il >> 1; }
                    if (il > 9 - _fsharp) { il = 9 - _fsharp; }
                }
                if (il < 1) { il = 1; }
                finfo[fo] = 2 * lvl + il;         // limit
                finfo[fo + 1] = il;               // ilevel
                let is i64 as hv with mut = 0;
                if (lvl >= 40) { hv = 2; } else { if (lvl >= 15) { hv = 1; } }
                finfo[fo + 2] = hv;               // hev threshold
                let is i64 as inner with mut = is4;
                if (skip == 0) { inner = 1; }
                finfo[fo + 3] = inner;
            }

            // -- reconstruction into the 32-stride scratch --
            // top margin
            i = 0;
            while (i < 21) {
                let is i64 as v with mut = 127;
                if (mby > 0) {
                    let is i64 as sx with mut = mbx * 16 + i - 1;
                    if (i == 0) {
                        if (mbx == 0) { v = 129; }
                        else { v = cast(i64, py[(mby * 16 - 1) * yw + sx]); }
                    } else {
                        if (sx >= yw) { sx = yw - 1; }
                        if (sx >= mbx * 16 + 16) {
                            // top-right: replicate last top sample on right border
                            if (mbx == mbw - 1) { sx = mbx * 16 + 15; }
                        }
                        v = cast(i64, py[(mby * 16 - 1) * yw + sx]);
                    }
                }
                sy[yo - 32 - 1 + i] = cast(u8, v);
                i = i + 1;
            }
            // top-right replication for inner 4x4 rows (rows 3, 7, 11)
            i = 0;
            while (i < 4) {
                sy[yo + 3 * 32 + 16 + i] = sy[yo - 32 + 16 + i];
                sy[yo + 7 * 32 + 16 + i] = sy[yo - 32 + 16 + i];
                sy[yo + 11 * 32 + 16 + i] = sy[yo - 32 + 16 + i];
                i = i + 1;
            }
            // left margin
            i = 0;
            while (i < 16) {
                let is i64 as v with mut = 129;
                if (mbx > 0) { v = cast(i64, py[(mby * 16 + i) * yw + mbx * 16 - 1]); }
                sy[yo + i * 32 - 1] = cast(u8, v);
                i = i + 1;
            }
            // chroma margins
            i = 0;
            while (i < 9) {
                let is i64 as vu with mut = 127;
                let is i64 as vv2 with mut = 127;
                if (mby > 0) {
                    let is i64 as sx with mut = mbx * 8 + i - 1;
                    if (i == 0) {
                        if (mbx == 0) { vu = 129; vv2 = 129; }
                        else {
                            vu = cast(i64, pu[(mby * 8 - 1) * cw + sx]);
                            vv2 = cast(i64, pv[(mby * 8 - 1) * cw + sx]);
                        }
                    } else {
                        vu = cast(i64, pu[(mby * 8 - 1) * cw + sx]);
                        vv2 = cast(i64, pv[(mby * 8 - 1) * cw + sx]);
                    }
                }
                su[co - 32 - 1 + i] = cast(u8, vu);
                sv[co - 32 - 1 + i] = cast(u8, vv2);
                i = i + 1;
            }
            i = 0;
            while (i < 8) {
                let is i64 as vu with mut = 129;
                let is i64 as vv2 with mut = 129;
                if (mbx > 0) {
                    vu = cast(i64, pu[(mby * 8 + i) * cw + mbx * 8 - 1]);
                    vv2 = cast(i64, pv[(mby * 8 + i) * cw + mbx * 8 - 1]);
                }
                su[co + i * 32 - 1] = cast(u8, vu);
                sv[co + i * 32 - 1] = cast(u8, vv2);
                i = i + 1;
            }

            // predict + add residuals: luma
            if (is4 == 1) {
                let is i64 as n with mut = 0;
                while (n < 16) {
                    let is i64 as bo = yo + (n / 4) * 4 * 32 + (n % 4) * 4;
                    _pred4(sy, bo, cast(i64, imodes[mbx * 16 + n]));
                    let is i64 as code = (nzy >> (30 - 2 * n)) & 3;
                    let is *i64 as blk = cast(*i64, cast(i64, coeffs) + (n * 16) * 8);
                    if (code >= 2) { _idct4(blk, sy, bo); }
                    else { if (code == 1) { _idct_dc(blk[0], sy, bo); } }
                    n = n + 1;
                }
            } else {
                let is i64 as m with mut = cast(i64, imodes[mbx * 16]);
                if (m == 0) {
                    if (mbx == 0) { if (mby == 0) { m = 6; } else { m = 5; } }
                    else { if (mby == 0) { m = 4; } }
                }
                _pred_block(sy, yo, 16, m);
                if (nzy != 0) {
                    let is i64 as n with mut = 0;
                    while (n < 16) {
                        let is i64 as bo = yo + (n / 4) * 4 * 32 + (n % 4) * 4;
                        let is i64 as code = (nzy >> (30 - 2 * n)) & 3;
                        let is *i64 as blk = cast(*i64, cast(i64, coeffs) + (n * 16) * 8);
                        if (code >= 2) { _idct4(blk, sy, bo); }
                        else { if (code == 1) { _idct_dc(blk[0], sy, bo); } }
                        n = n + 1;
                    }
                }
            }
            // chroma
            let is i64 as um with mut = cast(i64, uvm[mbx]);
            if (um == 0) {
                if (mbx == 0) { if (mby == 0) { um = 6; } else { um = 5; } }
                else { if (mby == 0) { um = 4; } }
            }
            _pred_block(su, co, 8, um);
            _pred_block(sv, co, 8, um);
            let is i64 as n with mut = 0;
            while (n < 8) {
                let is i64 as ch2 with mut = 0;      // 0..3 = U, 4..7 = V
                let is *u8 as sp with mut = su;
                if (n >= 4) { sp = sv; }
                let is i64 as k = n % 4;
                let is i64 as bo = co + (k / 2) * 4 * 32 + (k % 2) * 4;
                let is i64 as code = (nzuv >> ((n / 4) * 8 + 6 - 2 * k)) & 3;
                let is *i64 as blk = cast(*i64, cast(i64, coeffs) + ((16 + n) * 16) * 8);
                if (code >= 2) { _idct4(blk, sp, bo); }
                else { if (code == 1) { _idct_dc(blk[0], sp, bo); } }
                n = n + 1;
            }

            // blit scratch -> planes
            i = 0;
            while (i < 16) {
                mem.core.memcpy(cast(*u8, cast(i64, py) + (mby * 16 + i) * yw + mbx * 16),
                    cast(*u8, cast(i64, sy) + yo + i * 32), 16);
                i = i + 1;
            }
            i = 0;
            while (i < 8) {
                mem.core.memcpy(cast(*u8, cast(i64, pu) + (mby * 8 + i) * cw + mbx * 8),
                    cast(*u8, cast(i64, su) + co + i * 32), 8);
                mem.core.memcpy(cast(*u8, cast(i64, pv) + (mby * 8 + i) * cw + mbx * 8),
                    cast(*u8, cast(i64, sv) + co + i * 32), 8);
                i = i + 1;
            }
            mbx = mbx + 1;
        }
        mby = mby + 1;
    }

    // ---- loop filter (raster order over the finished planes) ----
    if (_flevel > 0) {
        mby = 0;
        while (mby < mbh) {
            let is i64 as mbx with mut = 0;
            while (mbx < mbw) {
                let is i64 as fo = (mby * mbw + mbx) * 4;
                let is i64 as limit = finfo[fo];
                if (limit > 0) {
                    let is i64 as il = finfo[fo + 1];
                    let is i64 as hv = finfo[fo + 2];
                    let is i64 as inner = finfo[fo + 3];
                    let is i64 as ybase = mby * 16 * yw + mbx * 16;
                    if (_fsimple == 1) {
                        if (mbx > 0) { _sfloop(py, ybase, 1, yw, 16, limit + 4); }
                        if (inner == 1) {
                            _sfloop(py, ybase + 4, 1, yw, 16, limit);
                            _sfloop(py, ybase + 8, 1, yw, 16, limit);
                            _sfloop(py, ybase + 12, 1, yw, 16, limit);
                        }
                        if (mby > 0) { _sfloop(py, ybase, yw, 1, 16, limit + 4); }
                        if (inner == 1) {
                            _sfloop(py, ybase + 4 * yw, yw, 1, 16, limit);
                            _sfloop(py, ybase + 8 * yw, yw, 1, 16, limit);
                            _sfloop(py, ybase + 12 * yw, yw, 1, 16, limit);
                        }
                    } else {
                        let is i64 as ubase = mby * 8 * cw + mbx * 8;
                        if (mbx > 0) {
                            _floop26(py, ybase, 1, yw, 16, limit + 4, il, hv);
                            _floop26(pu, ubase, 1, cw, 8, limit + 4, il, hv);
                            _floop26(pv, ubase, 1, cw, 8, limit + 4, il, hv);
                        }
                        if (inner == 1) {
                            _floop24(py, ybase + 4, 1, yw, 16, limit, il, hv);
                            _floop24(py, ybase + 8, 1, yw, 16, limit, il, hv);
                            _floop24(py, ybase + 12, 1, yw, 16, limit, il, hv);
                            _floop24(pu, ubase + 4, 1, cw, 8, limit, il, hv);
                            _floop24(pv, ubase + 4, 1, cw, 8, limit, il, hv);
                        }
                        if (mby > 0) {
                            _floop26(py, ybase, yw, 1, 16, limit + 4, il, hv);
                            _floop26(pu, ubase, cw, 1, 8, limit + 4, il, hv);
                            _floop26(pv, ubase, cw, 1, 8, limit + 4, il, hv);
                        }
                        if (inner == 1) {
                            _floop24(py, ybase + 4 * yw, yw, 1, 16, limit, il, hv);
                            _floop24(py, ybase + 8 * yw, yw, 1, 16, limit, il, hv);
                            _floop24(py, ybase + 12 * yw, yw, 1, 16, limit, il, hv);
                            _floop24(pu, ubase + 4 * cw, cw, 1, 8, limit, il, hv);
                            _floop24(pv, ubase + 4 * cw, cw, 1, 8, limit, il, hv);
                        }
                    }
                }
                mbx = mbx + 1;
            }
            mby = mby + 1;
        }
    }

    // ---- YUV420 -> RGB (libwebp fixed-point conversion + fancy upsample) ----
    let is i64 as rc = image.image_init(out, _width, _height, pixfmt.FMT_RGB8);
    if (rc < 0) { return rc; }
    let is i64 as uw = (_width + 1) >> 1;
    let is i64 as uh = (_height + 1) >> 1;
    let is *u8 as dst = out.pixels;
    let is i64 as y3 with mut = 0;
    while (y3 < _height) {
        let is i64 as x3 with mut = 0;
        while (x3 < _width) {
            let is i64 as yy = cast(i64, py[y3 * yw + x3]);
            // fancy chroma upsample (triangle 9-3-3-1)
            let is i64 as ix with mut = x3 >> 1;
            let is i64 as fx with mut = ix - 1;
            if ((x3 & 1) == 1) { fx = ix + 1; }
            if (fx < 0) { fx = 0; }
            if (fx >= uw) { fx = uw - 1; }
            let is i64 as iy with mut = y3 >> 1;
            let is i64 as fy with mut = iy - 1;
            if ((y3 & 1) == 1) { fy = iy + 1; }
            if (fy < 0) { fy = 0; }
            if (fy >= uh) { fy = uh - 1; }
            let is i64 as u = (9 * cast(i64, pu[iy * cw + ix]) + 3 * cast(i64, pu[iy * cw + fx])
                + 3 * cast(i64, pu[fy * cw + ix]) + cast(i64, pu[fy * cw + fx]) + 8) >> 4;
            let is i64 as v = (9 * cast(i64, pv[iy * cw + ix]) + 3 * cast(i64, pv[iy * cw + fx])
                + 3 * cast(i64, pv[fy * cw + ix]) + cast(i64, pv[fy * cw + fx]) + 8) >> 4;
            let is i64 as ym = (yy * 19077) >> 8;
            let is i64 as r = _clip8((ym + ((v * 26149) >> 8) - 14234) >> 6);
            let is i64 as g = _clip8((ym - ((u * 6419) >> 8) - ((v * 13320) >> 8) + 8708) >> 6);
            let is i64 as b = _clip8((ym + ((u * 33050) >> 8) - 17685) >> 6);
            let is i64 as di = (y3 * _width + x3) * 3;
            dst[di] = cast(u8, r); dst[di + 1] = cast(u8, g); dst[di + 2] = cast(u8, b);
            x3 = x3 + 1;
        }
        y3 = y3 + 1;
    }

    mem.core.munmap(py, yw * yh); mem.core.munmap(pu, cw * chh); mem.core.munmap(pv, cw * chh);
    mem.core.munmap(imodes, mbw * 16); mem.core.munmap(i4f, mbw + 1); mem.core.munmap(uvm, mbw + 1);
    mem.core.munmap(segs, mbw + 1); mem.core.munmap(skips, mbw + 1);
    mem.core.munmap(intra_t, mbw * 4 + 4);
    mem.core.munmap(cast(*u8, nzv), (mbw + 1) * 8); mem.core.munmap(cast(*u8, nzdc), (mbw + 1) * 8);
    mem.core.munmap(cast(*u8, finfo), mbw * mbh * 4 * 8);
    mem.core.munmap(sy, 18 * 32); mem.core.munmap(su, 10 * 32); mem.core.munmap(sv, 10 * 32);
    mem.core.munmap(cast(*u8, coeffs), 384 * 8);
    return 0;
}
