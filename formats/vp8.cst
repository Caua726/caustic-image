// filter. Tables are the spec constants (extracted from libwebp, BSD).
// State lives in module globals (one decode at a time).
//   vp8_decode(src, src_len, out) -> 0, or negative errno (YUV -> RGB8).
// =======================================================

use "std/mem.cst" only bins, core as mem;
use "../core/errno.cst"  as errno;
use "../core/image.cst"  as image;
