// =======================================================
// caustic-image/formats/png.cst
// PNG decoder. Reuses the sibling caustic-compact for the two heavy pieces:
// per-chunk CRC-32 (checksum.crc32) and the IDAT zlib/DEFLATE stream
// (zlib.zlib_decompress) — a PNG IDAT stream IS a zlib stream. We own the
// container walk, the scanline unfilter (None/Sub/Up/Average/Paeth) and the
// pixel expansion.
//
// Phase-1 scope: 8-bit depth, colour types 0/2/3/4/6, non-interlaced. Adam7,
// 1/2/4/16-bit depths, and ancillary colour chunks land in a later phase.
//   png_decode(src, src_len, out) -> 0, or negative errno; fills *out.
// =======================================================

use "std/mem.cst" only bins, core as mem;
use "../core/errno.cst"  as errno;
use "../core/image.cst"  as image;
use "../core/pixfmt.cst" as pixfmt;
use "../core/buf.cst"    as buf;
use "../core/opts.cst"   as opts;

use "caustic-compact/core/bytes.cst"    as cb;
use "caustic-compact/core/checksum.cst" as checksum;
use "caustic-compact/formats/zlib.cst"  as zlib;

fn _iabs(x as i64) as i64 { if (x < 0) { return 0 - x; } return x; }

// PNG Paeth predictor over the three neighbours a(left) b(up) c(up-left).
fn _paeth(a as i64, b as i64, c as i64) as i64 {
    let is i64 as p = a + b - c;
    let is i64 as pa = _iabs(p - a);
    let is i64 as pb = _iabs(p - b);
    let is i64 as pc = _iabs(p - c);
    if (pa <= pb) { if (pa <= pc) { return a; } }
    if (pb <= pc) { return b; }
    return c;
}

// Filtered byte for filter type `ft` given neighbours a(left) b(up) c(up-left).
fn _filt(ft as i64, x as i64, a as i64, b as i64, c as i64) as i64 {
    if (ft == 0) { return x & 255; }
    if (ft == 1) { return (x - a) & 255; }
    if (ft == 2) { return (x - b) & 255; }
    if (ft == 3) { return (x - ((a + b) >> 1)) & 255; }
    return (x - _paeth(a, b, c)) & 255;
}

// Absolute value of a filtered byte read as signed (minimum-sum-of-abs heuristic).
fn _sabs(fb as i64) as i64 {
    if (fb >= 128) { return 256 - fb; }
    return fb;
}

fn _type_is(t0 as i64, t1 as i64, t2 as i64, t3 as i64,
            c0 as i64, c1 as i64, c2 as i64, c3 as i64) as i64 {
    if (t0 != c0) { return 0; }
    if (t1 != c1) { return 0; }
    if (t2 != c2) { return 0; }
    if (t3 != c3) { return 0; }
    return 1;
}

// Pixels of an Adam7 pass along one axis: ceil((total - start) / step), >= 0.
fn _pass_dim(total as i64, start as i64, step as i64) as i64 {
    if (start >= total) { return 0; }
    return (total - start + step - 1) / step;
}

fn png_decode(src as *u8, src_len as i64, out as *image.Image) as i64 {
    let is buf.Buf as bf;
    buf.buf_init(&bf, src, src_len);
    // 8-byte signature.
    let is *u8 as sig with imut = "\x89\x50\x4e\x47\x0d\x0a\x1a\x0a";
    let is i64 as si with mut = 0;
    while (si < 8) {
        if (buf.buf_u8(&bf) != cast(i64, sig[si])) { return errno.I_BADMAGIC; }
        si = si + 1;
    }

    let is i64 as have_ihdr with mut = 0;
    let is i64 as w with mut = 0;
    let is i64 as h with mut = 0;
    let is i64 as bitdepth with mut = 0;
    let is i64 as colortype with mut = 0;
    let is i64 as interlace with mut = 0;

    let is *u8 as plte_ptr with mut = cast(*u8, 0);
    let is i64 as plte_count with mut = 0;
    let is *u8 as trns_ptr with mut = cast(*u8, 0);
    let is i64 as trns_len with mut = 0;
    let is i64 as has_trns with mut = 0;

    let is cb.Bytes as idat = cb.bytes_new(1024);

    // ---- chunk walk (offset-driven) ----
    let is i64 as done with mut = 0;
    while (done == 0) {
        let is i64 as clen = buf.buf_u32be(&bf);
        if (clen < 0) { cb.bytes_free(&idat); return errno.I_CORRUPT; }
        let is i64 as type_off = bf.pos;
        let is i64 as t0 = buf.buf_u8(&bf);
        let is i64 as t1 = buf.buf_u8(&bf);
        let is i64 as t2 = buf.buf_u8(&bf);
        let is i64 as t3 = buf.buf_u8(&bf);
        if (t3 < 0) { cb.bytes_free(&idat); return errno.I_CORRUPT; }
        let is i64 as data_off = bf.pos;
        if (buf.buf_remaining(&bf) < clen) { cb.bytes_free(&idat); return errno.I_CORRUPT; }

        // CRC covers the type + data bytes, contiguous in src.
        let is *u8 as crc_ptr = cast(*u8, cast(i64, src) + type_off);
        let is i64 as crc_calc = checksum.crc32(crc_ptr, 4 + clen);
        buf.buf_skip(&bf, clen);
        let is i64 as crc_stored = buf.buf_u32be(&bf);
        if (crc_calc != crc_stored) { cb.bytes_free(&idat); return errno.I_CORRUPT; }

        let is *u8 as data = cast(*u8, cast(i64, src) + data_off);
        if (_type_is(t0,t1,t2,t3, 73,72,68,82) == 1) {            // IHDR
            if (clen != 13) { cb.bytes_free(&idat); return errno.I_CORRUPT; }
            w = (cast(i64,data[0])<<24)|(cast(i64,data[1])<<16)|(cast(i64,data[2])<<8)|cast(i64,data[3]);
            h = (cast(i64,data[4])<<24)|(cast(i64,data[5])<<16)|(cast(i64,data[6])<<8)|cast(i64,data[7]);
            bitdepth  = cast(i64, data[8]);
            colortype = cast(i64, data[9]);
            interlace = cast(i64, data[12]);
            have_ihdr = 1;
        } else {
        if (_type_is(t0,t1,t2,t3, 80,76,84,69) == 1) {            // PLTE
            plte_ptr = data;
            plte_count = clen / 3;
        } else {
        if (_type_is(t0,t1,t2,t3, 116,82,78,83) == 1) {           // tRNS
            trns_ptr = data;
            trns_len = clen;
            has_trns = 1;
        } else {
        if (_type_is(t0,t1,t2,t3, 73,68,65,84) == 1) {            // IDAT
            if (cb.bytes_append(&idat, data, clen) < 0) { cb.bytes_free(&idat); return errno.I_OOM; }
        } else {
        if (_type_is(t0,t1,t2,t3, 73,69,78,68) == 1) {            // IEND
            done = 1;
        }
        }}}}
    }

    if (have_ihdr == 0) { cb.bytes_free(&idat); return errno.I_CORRUPT; }
    // 8/16-bit for all colour types; 1/2/4-bit only for gray (0) and palette (3).
    if (bitdepth != 8) { if (bitdepth != 16) {
        if (bitdepth != 1) { if (bitdepth != 2) { if (bitdepth != 4) {
            cb.bytes_free(&idat); return errno.I_UNSUPPORTED; } } }
        if (colortype != 0) { if (colortype != 3) { cb.bytes_free(&idat); return errno.I_UNSUPPORTED; } }
    } }
    let is i64 as bps with mut = 1;     // bytes per sample (2 for 16-bit)
    if (bitdepth == 16) { bps = 2; }

    // Raw channel count.
    let is i64 as chan with mut = 0;
    if (colortype == 0) { chan = 1; }
    else { if (colortype == 2) { chan = 3; }
    else { if (colortype == 3) { chan = 1; }
    else { if (colortype == 4) { chan = 2; }
    else { if (colortype == 6) { chan = 4; }
    else { cb.bytes_free(&idat); return errno.I_UNSUPPORTED; } }}}}

    // Destination format.
    let is i64 as fmt with mut = 0;
    if (colortype == 3) {
        fmt = pixfmt.FMT_RGB8; if (has_trns == 1) { fmt = pixfmt.FMT_RGBA8; }
    } else {
        if (bitdepth == 16) {
            if (colortype == 0) { fmt = pixfmt.FMT_GRAY16; }
            if (colortype == 2) { fmt = pixfmt.FMT_RGB16; }
            if (colortype == 4) { fmt = pixfmt.FMT_GRAYA16; }
            if (colortype == 6) { fmt = pixfmt.FMT_RGBA16; }
        } else {
            // 8-bit, and 1/2/4-bit gray (scaled up to GRAY8 on output).
            if (colortype == 0) { fmt = pixfmt.FMT_GRAY8; }
            if (colortype == 2) { fmt = pixfmt.FMT_RGB8; }
            if (colortype == 4) { fmt = pixfmt.FMT_GRAYA8; }
            if (colortype == 6) { fmt = pixfmt.FMT_RGBA8; }
        }
    }

    let is i64 as dchk = image.image_check_dims(w, h, fmt);
    if (dchk < 0) { cb.bytes_free(&idat); return dchk; }
    if (colortype == 3) { if (plte_count < 1) { cb.bytes_free(&idat); return errno.I_CORRUPT; } }

    let is i64 as bits_pp = chan * bitdepth;    // bits per pixel
    let is i64 as bpp with mut = bits_pp / 8;   // filter left-offset (bytes; min 1)
    if (bpp < 1) { bpp = 1; }

    // Adam7 pass geometry (a single full-image "pass" when non-interlaced).
    let is i64 as npass with mut = 1;
    if (interlace == 1) { npass = 7; }
    let is [7]i64 as pxs; let is [7]i64 as pys; let is [7]i64 as pxstep; let is [7]i64 as pystep;
    pxs[0] = 0; pys[0] = 0; pxstep[0] = 1; pystep[0] = 1;
    if (interlace == 1) {
        pxs[0]=0; pys[0]=0; pxstep[0]=8; pystep[0]=8;
        pxs[1]=4; pys[1]=0; pxstep[1]=8; pystep[1]=8;
        pxs[2]=0; pys[2]=4; pxstep[2]=4; pystep[2]=8;
        pxs[3]=2; pys[3]=0; pxstep[3]=4; pystep[3]=4;
        pxs[4]=0; pys[4]=2; pxstep[4]=2; pystep[4]=4;
        pxs[5]=1; pys[5]=0; pxstep[5]=2; pystep[5]=2;
        pxs[6]=0; pys[6]=1; pxstep[6]=1; pystep[6]=2;
    }

    // Expected decompressed size = Σ passes  ph*(1 + pw*bpp).
    let is i64 as expect with mut = 0;
    let is i64 as pc with mut = 0;
    while (pc < npass) {
        let is i64 as pw = _pass_dim(w, pxs[pc], pxstep[pc]);
        let is i64 as ph = _pass_dim(h, pys[pc], pystep[pc]);
        if (pw > 0) { if (ph > 0) { expect = expect + ph * (1 + (pw * bits_pp + 7) / 8); } }
        pc = pc + 1;
    }

    let is cb.Bytes as raw = cb.bytes_new(expect + 64);
    let is i64 as zr = zlib.zlib_decompress(idat.ptr, idat.len, &raw);
    cb.bytes_free(&idat);
    if (zr < 0) { cb.bytes_free(&raw); return errno.I_CORRUPT; }
    if (raw.len < expect) { cb.bytes_free(&raw); return errno.I_CORRUPT; }

    let is i64 as rc = image.image_init(out, w, h, fmt);
    if (rc < 0) { cb.bytes_free(&raw); return rc; }
    let is *u8 as dst = out.pixels;
    let is i64 as obpp = pixfmt.fmt_bpp(fmt);
    let is *u8 as rp = raw.ptr;

    let is i64 as roff with mut = 0;
    let is i64 as pass with mut = 0;
    while (pass < npass) {
        let is i64 as pw = _pass_dim(w, pxs[pass], pxstep[pass]);
        let is i64 as ph = _pass_dim(h, pys[pass], pystep[pass]);
        if (pw > 0) { if (ph > 0) {
            let is i64 as stride = (pw * bits_pp + 7) / 8;
            let is i64 as full = 1 + stride;
            // unfilter this pass in place (row refs already-reconstructed bytes)
            let is i64 as ry with mut = 0;
            while (ry < ph) {
                let is i64 as rowstart = roff + ry * full;
                let is i64 as ft = cast(i64, rp[rowstart]);
                let is i64 as cur = rowstart + 1;
                let is i64 as prev = cur - full;
                let is i64 as i with mut = 0;
                while (i < stride) {
                    let is i64 as xv = cast(i64, rp[cur + i]);
                    let is i64 as a with mut = 0; if (i >= bpp) { a = cast(i64, rp[cur + i - bpp]); }
                    let is i64 as b with mut = 0; if (ry > 0) { b = cast(i64, rp[prev + i]); }
                    let is i64 as c with mut = 0; if (ry > 0) { if (i >= bpp) { c = cast(i64, rp[prev + i - bpp]); } }
                    let is i64 as recon with mut = xv;
                    if (ft == 1) { recon = xv + a; }
                    else { if (ft == 2) { recon = xv + b; }
                    else { if (ft == 3) { recon = xv + ((a + b) >> 1); }
                    else { if (ft == 4) { recon = xv + _paeth(a, b, c); } } } }
                    rp[cur + i] = cast(u8, recon & 255);
                    i = i + 1;
                }
                ry = ry + 1;
            }
            // scatter the pass's pixels to their interlaced positions
            let is i64 as sy with mut = 0;
            while (sy < ph) {
                let is i64 as iy = pys[pass] + sy * pystep[pass];
                let is i64 as srow = roff + sy * full + 1;
                let is i64 as sx with mut = 0;
                while (sx < pw) {
                    let is i64 as ix = pxs[pass] + sx * pxstep[pass];
                    let is i64 as sb = srow + sx * bpp;
                    let is i64 as di = iy * out.stride + ix * obpp;
                    // sub-byte sample (1/2/4-bit gray or palette index), MSB-first
                    let is i64 as subv with mut = 0;
                    if (bitdepth < 8) {
                        let is i64 as bitpos = sx * bitdepth;
                        subv = (cast(i64, rp[srow + bitpos / 8]) >> (8 - bitdepth - (bitpos & 7)))
                             & ((1 << bitdepth) - 1);
                    }
                    if (colortype == 3) {
                        let is i64 as idx with mut = cast(i64, rp[sb]);
                        if (bitdepth < 8) { idx = subv; }
                        let is i64 as r with mut = 0; let is i64 as g with mut = 0; let is i64 as b with mut = 0;
                        if (idx < plte_count) {
                            r = cast(i64, plte_ptr[idx * 3]);
                            g = cast(i64, plte_ptr[idx * 3 + 1]);
                            b = cast(i64, plte_ptr[idx * 3 + 2]);
                        }
                        dst[di] = cast(u8, r); dst[di + 1] = cast(u8, g); dst[di + 2] = cast(u8, b);
                        if (obpp == 4) {
                            let is i64 as al with mut = 255;
                            if (idx < trns_len) { al = cast(i64, trns_ptr[idx]); }
                            dst[di + 3] = cast(u8, al);
                        }
                    } else {
                        if (bitdepth < 8) {
                            // 1/2/4-bit gray scaled to 8-bit (× 255/(2^d − 1))
                            let is i64 as scale with mut = 255;
                            if (bitdepth == 2) { scale = 85; }
                            if (bitdepth == 4) { scale = 17; }
                            dst[di] = cast(u8, subv * scale);
                        } else {
                            if (bps == 1) {
                                let is i64 as k with mut = 0;
                                while (k < bpp) { dst[di + k] = rp[sb + k]; k = k + 1; }
                            } else {
                                let is i64 as k with mut = 0;
                                while (k < chan) {
                                    dst[di + k * 2]     = rp[sb + k * 2 + 1];   // 16-bit BE -> native LE
                                    dst[di + k * 2 + 1] = rp[sb + k * 2];
                                    k = k + 1;
                                }
                            }
                        }
                    }
                    sx = sx + 1;
                }
                sy = sy + 1;
            }
            roff = roff + ph * full;
        } }
        pass = pass + 1;
    }
    cb.bytes_free(&raw);
    return 0;
}

// Write a PNG chunk: length(be32) + type(4) + data + CRC-32(type+data).
fn _png_chunk(out as *cb.Bytes, typ as *u8, data as *u8, len as i64) as void {
    cb.bytes_push(out, cast(u8, (len >> 24) & 255));
    cb.bytes_push(out, cast(u8, (len >> 16) & 255));
    cb.bytes_push(out, cast(u8, (len >> 8) & 255));
    cb.bytes_push(out, cast(u8, len & 255));
    cb.bytes_push(out, typ[0]); cb.bytes_push(out, typ[1]);
    cb.bytes_push(out, typ[2]); cb.bytes_push(out, typ[3]);
    if (len > 0) { cb.bytes_append(out, data, len); }
    let is i64 as c with mut = checksum.crc32_update(0, typ, 4);
    if (len > 0) { c = checksum.crc32_update(c, data, len); }
    cb.bytes_push(out, cast(u8, (c >> 24) & 255));
    cb.bytes_push(out, cast(u8, (c >> 16) & 255));
    cb.bytes_push(out, cast(u8, (c >> 8) & 255));
    cb.bytes_push(out, cast(u8, c & 255));
}

// ============================ encoder ======================================
// A PNG's size is largely decided before DEFLATE ever runs. Three levers, in
// descending order of how much they actually move the number:
//
//   1. The *representation*. A screenshot with eight distinct colours stored as
//      RGB8 spends 24 bits per pixel carrying three bits of information.
//      Re-expressing it as a 4-bit palette is worth more than every filter and
//      entropy-coder trick combined — on our benchmark UI image it is the
//      difference between 878 bytes and 338.
//   2. The *filter*, chosen per row from None/Sub/Up/Average/Paeth.
//   3. DEFLATE itself.
//
// So the engines differ in how hard they work at (1) and (2):
//   ENG_FAST     take the image as it comes; one heuristic filter pass.
//   ENG_DEFAULT  reduce the representation; libpng's minimum-sum-of-absolute-
//                differences filter heuristic. (This is what libpng+pngcrush do.)
//   ENG_BEST     reduce, then encode the whole image once per filter strategy
//                and keep the smallest — the zopflipng/OxiPNG approach.

// Whole-image filter strategies. 0..4 force one filter on every row; the last
// two decide per row.
let is i64 as _FS_MINSUM  with imut = 5;   // libpng: min sum of |filtered bytes|
let is i64 as _FS_ENTROPY with imut = 6;   // min entropy of the filtered row

// One candidate encoding of the image: a colour type, a bit depth, and the
// packed, big-endian scanlines that go with them.
struct _Cand {
    ct as i64;        // colour type 0/2/3/4/6
    bd as i64;        // bit depth 1/2/4/8/16
    chan as i64;      // samples per pixel (1 for palette)
    raw as i64;       // address of h * stride packed rows
    stride as i64;    // bytes per row
    bpp as i64;       // filter offset in bytes: max(1, chan * bd / 8)
    plte as i64;      // address of 3 * ncol bytes (colour type 3)
    trns as i64;      // address of ncol alpha bytes
    ncol as i64;
    ntrns as i64;     // tRNS entries to write; 0 omits the chunk
}

fn _cand_free(c as *_Cand, h as i64) as void {
    if (c.raw != 0)  { mem.core.munmap(cast(*u8, c.raw), h * c.stride); }
    if (c.plte != 0) { mem.core.munmap(cast(*u8, c.plte), 3 * 256); }
    if (c.trns != 0) { mem.core.munmap(cast(*u8, c.trns), 256); }
    c.raw = 0; c.plte = 0; c.trns = 0;
}

// The pixel at (x, y) as 0xRRGGBBAA, for any 8-bit format.
fn _px8(img as *image.Image, x as i64, y as i64) as i64 {
    let is *u8 as p = img.pixels;
    let is i64 as o = y * img.stride;
    if (img.fmt == pixfmt.FMT_GRAY8) {
        let is i64 as g = cast(i64, p[o + x]);
        return (g << 24) | (g << 16) | (g << 8) | 255;
    }
    if (img.fmt == pixfmt.FMT_GRAYA8) {
        let is i64 as g = cast(i64, p[o + x * 2]);
        return (g << 24) | (g << 16) | (g << 8) | cast(i64, p[o + x * 2 + 1]);
    }
    if (img.fmt == pixfmt.FMT_RGB8) {
        return (cast(i64, p[o + x * 3]) << 24) | (cast(i64, p[o + x * 3 + 1]) << 16)
             | (cast(i64, p[o + x * 3 + 2]) << 8) | 255;
    }
    return (cast(i64, p[o + x * 4]) << 24) | (cast(i64, p[o + x * 4 + 1]) << 16)
         | (cast(i64, p[o + x * 4 + 2]) << 8) | cast(i64, p[o + x * 4 + 3]);
}

// Write sample `v` (bd bits) at index `i` of a packed row, MSB-first.
fn _pack(row as *u8, i as i64, bd as i64, v as i64) as void {
    if (bd == 8) { row[i] = cast(u8, v & 255); return; }
    let is i64 as bit = i * bd;
    let is i64 as by = bit >> 3;
    let is i64 as sh = 8 - bd - (bit & 7);
    row[by] = cast(u8, cast(i64, row[by]) | ((v & ((1 << bd) - 1)) << sh));
}

// Colour census over an 8-bit image. Fills col[] with the distinct RGBA values
// (packed 0xRRGGBBAA) and cnt[] with their frequencies, and returns how many
// there are — or -1 once it passes 256, at which point a palette is off the
// table and the exact count stops mattering. `flags` gets bit 0 if any pixel is
// non-opaque and bit 1 if every pixel has r == g == b.
fn _census(img as *image.Image, col as *i64, cnt as *i64, flags as *i64) as i64 {
    let is i64 as HN with imut = 1024;                 // open-addressed, power of two
    let is *i64 as slot = cast(*i64, mem.core.mmap_anon(HN * 8));
    mem.core.memset(cast(*u8, slot), cast(i32, 0), HN * 8);   // 0 = empty, else index+1
    let is i64 as n with mut = 0;
    let is i64 as over with mut = 0;
    let is i64 as has_alpha with mut = 0;
    let is i64 as is_gray with mut = 1;
    let is i64 as y with mut = 0;
    while (y < img.height) {
        let is i64 as x with mut = 0;
        while (x < img.width) {
            let is i64 as c = _px8(img, x, y);
            if ((c & 255) != 255) { has_alpha = 1; }
            let is i64 as r = (c >> 24) & 255;
            if (((c >> 16) & 255) != r) { is_gray = 0; }
            if (((c >> 8) & 255) != r) { is_gray = 0; }
            if (over == 0) {
                // Knuth multiplicative hash, then linear probing.
                let is i64 as hh with mut = ((c * 2654435761) >> 12) & (HN - 1);
                let is i64 as placed with mut = 0;
                while (placed == 0) {
                    let is i64 as s = slot[hh];
                    if (s == 0) {
                        if (n >= 256) { over = 1; placed = 1; }
                        else {
                            col[n] = c; cnt[n] = 1;
                            slot[hh] = n + 1; n = n + 1; placed = 1;
                        }
                    } else {
                        if (col[s - 1] == c) { cnt[s - 1] = cnt[s - 1] + 1; placed = 1; }
                        else { hh = (hh + 1) & (HN - 1); }
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    mem.core.munmap(cast(*u8, slot), HN * 8);
    flags[0] = has_alpha;
    flags[1] = is_gray;
    if (over == 1) { return 0 - 1; }
    return n;
}

// The smallest bit depth that indexes `n` palette entries.
fn _pal_depth(n as i64) as i64 {
    if (n <= 2)  { return 1; }
    if (n <= 4)  { return 2; }
    if (n <= 16) { return 4; }
    return 8;
}

// Build the direct (non-palette) candidate: drop alpha if every pixel is
// opaque, drop colour if every pixel is grey, and shrink an opaque greyscale to
// 1/2/4 bits when every sample lands exactly on that depth's scale (a 1-bit
// grey sample can only be 0 or 255, a 2-bit one only a multiple of 85).
fn _cand_direct(img as *image.Image, c as *_Cand, has_alpha as i64, is_gray as i64) as i64 {
    let is i64 as w = img.width;
    let is i64 as h = img.height;
    c.plte = 0; c.trns = 0; c.ncol = 0; c.ntrns = 0;
    c.bd = 8;
    if (is_gray == 1) {
        if (has_alpha == 1) { c.ct = 4; c.chan = 2; } else { c.ct = 0; c.chan = 1; }
    } else {
        if (has_alpha == 1) { c.ct = 6; c.chan = 4; } else { c.ct = 2; c.chan = 3; }
    }
    // Opaque greyscale: try to shrink the depth.
    if (c.ct == 0) {
        let is i64 as bd with mut = 1;
        while (bd < 8) {
            let is i64 as step = 255 / ((1 << bd) - 1);
            let is i64 as ok with mut = 1;
            let is i64 as y with mut = 0;
            while (y < h) {
                let is i64 as x with mut = 0;
                while (x < w) {
                    if ((((_px8(img, x, y) >> 24) & 255) % step) != 0) { ok = 0; x = w; y = h; }
                    x = x + 1;
                }
                y = y + 1;
            }
            if (ok == 1) { c.bd = bd; bd = 8; } else { bd = bd * 2; }
        }
    }
    c.stride = (w * c.chan * c.bd + 7) / 8;
    c.bpp = (c.chan * c.bd + 7) / 8;
    c.raw = cast(i64, mem.core.mmap_anon(h * c.stride));
    if (c.raw == 0) { return errno.I_OOM; }
    mem.core.memset(cast(*u8, c.raw), cast(i32, 0), h * c.stride);
    let is i64 as scale = 255 / ((1 << c.bd) - 1);
    let is i64 as y2 with mut = 0;
    while (y2 < h) {
        let is *u8 as row = cast(*u8, c.raw + y2 * c.stride);
        let is i64 as x2 with mut = 0;
        while (x2 < w) {
            let is i64 as p = _px8(img, x2, y2);
            let is i64 as r = (p >> 24) & 255;
            if (c.ct == 0) { _pack(row, x2, c.bd, r / scale); }
            if (c.ct == 4) { row[x2 * 2] = cast(u8, r); row[x2 * 2 + 1] = cast(u8, p & 255); }
            if (c.ct == 2) {
                row[x2 * 3] = cast(u8, r);
                row[x2 * 3 + 1] = cast(u8, (p >> 16) & 255);
                row[x2 * 3 + 2] = cast(u8, (p >> 8) & 255);
            }
            if (c.ct == 6) {
                row[x2 * 4] = cast(u8, r);
                row[x2 * 4 + 1] = cast(u8, (p >> 16) & 255);
                row[x2 * 4 + 2] = cast(u8, (p >> 8) & 255);
                row[x2 * 4 + 3] = cast(u8, p & 255);
            }
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    return 0;
}

// Build the palette candidate from a census of at most 256 colours. Entries are
// ordered non-opaque first (so tRNS, which must be a prefix of the palette, is
// as short as possible) and then by descending frequency (so the common indices
// are the small ones, which the entropy coder likes).
fn _cand_palette(img as *image.Image, c as *_Cand, col as *i64, cnt as *i64, n as i64) as i64 {
    let is i64 as w = img.width;
    let is i64 as h = img.height;
    let is *i64 as ord = cast(*i64, mem.core.mmap_anon(n * 8));
    let is i64 as i with mut = 0;
    while (i < n) { ord[i] = i; i = i + 1; }
    // Insertion sort: transparent before opaque, then heavier before lighter.
    i = 1;
    while (i < n) {
        let is i64 as k = ord[i];
        let is i64 as ka = col[k] & 255;
        let is i64 as j with mut = i - 1;
        let is i64 as done with mut = 0;
        while (j >= 0 && done == 0) {
            let is i64 as m = ord[j];
            let is i64 as ma = col[m] & 255;
            // Should m sort after k? Opaque after transparent; within a class,
            // rarer after commoner.
            let is i64 as after with mut = 0;
            if (ma == 255) { if (ka != 255) { after = 1; } }
            if (after == 0) {
                if (ma == 255) { if (ka == 255) { if (cnt[m] < cnt[k]) { after = 1; } } }
                else { if (ka != 255) { if (cnt[m] < cnt[k]) { after = 1; } } }
            }
            if (after == 0) { done = 1; }
            else { ord[j + 1] = m; j = j - 1; }
        }
        ord[j + 1] = k;
        i = i + 1;
    }
    c.ct = 3; c.chan = 1; c.ncol = n;
    c.bd = _pal_depth(n);
    c.plte = cast(i64, mem.core.mmap_anon(3 * 256));
    c.trns = cast(i64, mem.core.mmap_anon(256));
    if (c.plte == 0 || c.trns == 0) { mem.core.munmap(cast(*u8, ord), n * 8); return errno.I_OOM; }
    let is *u8 as plte = cast(*u8, c.plte);
    let is *u8 as trns = cast(*u8, c.trns);
    // newidx[old] = position in the sorted palette.
    let is *i64 as newidx = cast(*i64, mem.core.mmap_anon(n * 8));
    c.ntrns = 0;
    i = 0;
    while (i < n) {
        let is i64 as o = ord[i];
        newidx[o] = i;
        let is i64 as p = col[o];
        plte[i * 3]     = cast(u8, (p >> 24) & 255);
        plte[i * 3 + 1] = cast(u8, (p >> 16) & 255);
        plte[i * 3 + 2] = cast(u8, (p >> 8) & 255);
        trns[i] = cast(u8, p & 255);
        if ((p & 255) != 255) { c.ntrns = i + 1; }
        i = i + 1;
    }
    mem.core.munmap(cast(*u8, ord), n * 8);

    c.stride = (w * c.bd + 7) / 8;
    c.bpp = 1;
    c.raw = cast(i64, mem.core.mmap_anon(h * c.stride));
    if (c.raw == 0) { mem.core.munmap(cast(*u8, newidx), n * 8); return errno.I_OOM; }
    mem.core.memset(cast(*u8, c.raw), cast(i32, 0), h * c.stride);
    let is i64 as y with mut = 0;
    while (y < h) {
        let is *u8 as row = cast(*u8, c.raw + y * c.stride);
        let is i64 as x with mut = 0;
        while (x < w) {
            let is i64 as p = _px8(img, x, y);
            let is i64 as k with mut = 0;
            while (k < n) { if (col[k] == p) { _pack(row, x, c.bd, newidx[k]); k = n; } else { k = k + 1; } }
            x = x + 1;
        }
        y = y + 1;
    }
    mem.core.munmap(cast(*u8, newidx), n * 8);
    return 0;
}

// The 16-bit candidate: samples byte-swapped to PNG's big-endian order.
fn _cand_16(img as *image.Image, c as *_Cand) as i64 {
    let is i64 as w = img.width;
    let is i64 as h = img.height;
    c.plte = 0; c.trns = 0; c.ncol = 0; c.ntrns = 0; c.bd = 16;
    if (img.fmt == pixfmt.FMT_GRAY16)  { c.ct = 0; c.chan = 1; }
    if (img.fmt == pixfmt.FMT_GRAYA16) { c.ct = 4; c.chan = 2; }
    if (img.fmt == pixfmt.FMT_RGB16)   { c.ct = 2; c.chan = 3; }
    if (img.fmt == pixfmt.FMT_RGBA16)  { c.ct = 6; c.chan = 4; }
    c.stride = w * c.chan * 2;
    c.bpp = c.chan * 2;
    c.raw = cast(i64, mem.core.mmap_anon(h * c.stride));
    if (c.raw == 0) { return errno.I_OOM; }
    let is *u8 as px = img.pixels;
    let is i64 as y with mut = 0;
    while (y < h) {
        let is *u8 as row = cast(*u8, c.raw + y * c.stride);
        let is i64 as srow = y * img.stride;
        let is i64 as s with mut = 0;
        while (s < w * c.chan) {
            row[s * 2]     = px[srow + s * 2 + 1];      // high byte first
            row[s * 2 + 1] = px[srow + s * 2];
            s = s + 1;
        }
        y = y + 1;
    }
    return 0;
}

// log2(x) in 1/65536ths, for x >= 1: exact on the exponent, linear on the
// mantissa. Only ever compared against itself, so the interpolation error is
// harmless and it costs no floating point.
fn _log2q(x as i64) as i64 {
    if (x <= 1) { return 0; }
    let is i64 as p with mut = 0;
    while ((1 << (p + 1)) <= x) { p = p + 1; }
    let is i64 as base = 1 << p;
    return (p << 16) + ((x - base) << 16) / base;
}

// Filter one row into `dst` under filter type `ft`. `cur`/`prv` are the packed
// (already byte-swapped) current and previous rows.
fn _filter_row(dst as *u8, cur as *u8, prv as *u8, stride as i64, bpp as i64,
               first as i64, ft as i64) as void {
    let is i64 as i with mut = 0;
    while (i < stride) {
        let is i64 as x = cast(i64, cur[i]);
        let is i64 as a with mut = 0;
        if (i >= bpp) { a = cast(i64, cur[i - bpp]); }
        let is i64 as b with mut = 0;
        let is i64 as cc with mut = 0;
        if (first == 0) {
            b = cast(i64, prv[i]);
            if (i >= bpp) { cc = cast(i64, prv[i - bpp]); }
        }
        dst[i] = cast(u8, _filt(ft, x, a, b, cc));
        i = i + 1;
    }
}

// Apply a whole-image filter strategy, producing the [filter byte][row] stream
// that DEFLATE will see. For the two adaptive strategies the choice is made row
// by row: _FS_MINSUM sums |signed filtered byte| (libpng's heuristic — a proxy
// for "how small are the residuals"), _FS_ENTROPY sums the actual zeroth-order
// entropy of the filtered row (a better proxy for "how well will DEFLATE do",
// and markedly better on palette images).
fn _filter_image(c as *_Cand, h as i64, strategy as i64, raw as *cb.Bytes) as i64 {
    let is i64 as stride = c.stride;
    let is *u8 as tmp = mem.core.mmap_anon(stride);
    let is *u8 as best = mem.core.mmap_anon(stride);
    let is *u8 as prev = mem.core.mmap_anon(stride);
    if (tmp == 0 || best == 0 || prev == 0) { return errno.I_OOM; }
    mem.core.memset(prev, cast(i32, 0), stride);
    let is [256]i64 as hist;
    let is i64 as y with mut = 0;
    while (y < h) {
        let is *u8 as cur = cast(*u8, c.raw + y * stride);
        let is i64 as first with mut = 0;
        if (y == 0) { first = 1; }
        let is i64 as chosen with mut = strategy;
        if (strategy < 5) {
            _filter_row(best, cur, prev, stride, c.bpp, first, strategy);
        } else {
            let is i64 as best_cost with mut = 0 - 1;
            let is i64 as ft with mut = 0;
            while (ft < 5) {
                _filter_row(tmp, cur, prev, stride, c.bpp, first, ft);
                let is i64 as cost with mut = 0;
                if (strategy == _FS_MINSUM) {
                    let is i64 as i with mut = 0;
                    while (i < stride) { cost = cost + _sabs(cast(i64, tmp[i])); i = i + 1; }
                } else {
                    let is i64 as k with mut = 0;
                    while (k < 256) { hist[k] = 0; k = k + 1; }
                    let is i64 as i2 with mut = 0;
                    while (i2 < stride) {
                        let is i64 as v = cast(i64, tmp[i2]);
                        hist[v] = hist[v] + 1;
                        i2 = i2 + 1;
                    }
                    // sum over symbols of count * log2(stride / count)
                    let is i64 as ls = _log2q(stride);
                    k = 0;
                    while (k < 256) {
                        if (hist[k] > 0) { cost = cost + hist[k] * ((ls - _log2q(hist[k])) >> 8); }
                        k = k + 1;
                    }
                }
                if (best_cost < 0 || cost < best_cost) {
                    best_cost = cost; chosen = ft;
                    mem.core.memcpy(best, tmp, stride);
                }
                ft = ft + 1;
            }
        }
        cb.bytes_push(raw, cast(u8, chosen));
        cb.bytes_append(raw, best, stride);
        mem.core.memcpy(prev, cur, stride);
        y = y + 1;
    }
    mem.core.munmap(tmp, stride);
    mem.core.munmap(best, stride);
    mem.core.munmap(prev, stride);
    return 0;
}

// Serialize a candidate whose IDAT has already been compressed.
fn _emit_png(c as *_Cand, w as i64, h as i64, idat as *cb.Bytes, out as *cb.Bytes) as void {
    cb.bytes_push(out, cast(u8, 137)); cb.bytes_push(out, cast(u8, 80));
    cb.bytes_push(out, cast(u8, 78));  cb.bytes_push(out, cast(u8, 71));
    cb.bytes_push(out, cast(u8, 13));  cb.bytes_push(out, cast(u8, 10));
    cb.bytes_push(out, cast(u8, 26));  cb.bytes_push(out, cast(u8, 10));

    let is [13]u8 as ih;
    ih[0] = cast(u8, (w >> 24) & 255); ih[1] = cast(u8, (w >> 16) & 255);
    ih[2] = cast(u8, (w >> 8) & 255);  ih[3] = cast(u8, w & 255);
    ih[4] = cast(u8, (h >> 24) & 255); ih[5] = cast(u8, (h >> 16) & 255);
    ih[6] = cast(u8, (h >> 8) & 255);  ih[7] = cast(u8, h & 255);
    ih[8] = cast(u8, c.bd);
    ih[9] = cast(u8, c.ct);
    ih[10] = cast(u8, 0); ih[11] = cast(u8, 0); ih[12] = cast(u8, 0);
    _png_chunk(out, "IHDR", cast(*u8, &ih), 13);

    if (c.ct == 3) {
        _png_chunk(out, "PLTE", cast(*u8, c.plte), 3 * c.ncol);
        if (c.ntrns > 0) { _png_chunk(out, "tRNS", cast(*u8, c.trns), c.ntrns); }
    }
    _png_chunk(out, "IDAT", idat.ptr, idat.len);
    _png_chunk(out, "IEND", cast(*u8, 0), 0);
}

// Compress a candidate under one filter strategy; returns the zlib stream in
// `idat`, or a negative errno.
fn _try(c as *_Cand, h as i64, strategy as i64, level as i64, idat as *cb.Bytes) as i64 {
    let is cb.Bytes as raw = cb.bytes_new(h * (1 + c.stride) + 16);
    let is i64 as fr = _filter_image(c, h, strategy, &raw);
    if (fr < 0) { cb.bytes_free(&raw); return fr; }
    let is i64 as zr = zlib.zlib_compress(raw.ptr, raw.len, idat, level);
    cb.bytes_free(&raw);
    if (zr < 0) { return errno.I_OOM; }
    return idat.len;
}

// Encode `img` as a non-interlaced PNG. See the engine notes above.
fn png_encode_ex(img as *image.Image, out as *cb.Bytes, o as *opts.EncOpts) as i64 {
    let is i64 as w = img.width;
    let is i64 as h = img.height;
    if (w <= 0 || h <= 0) { return errno.I_DIMS; }
    let is i64 as depth = pixfmt.fmt_depth(img.fmt);
    if (depth != 8 && depth != 16) { return errno.I_UNSUPPORTED; }

    // DEFLATE effort. Level 2 is dynamic-Huffman + lazy matching; level 6 runs
    // the iterative optimal parse, which is slow enough that ENG_BEST only pays
    // for it once — see the two-tier search below.
    let is i64 as level with mut = 2;
    if (o.engine == opts.ENG_FAST) { level = 1; }
    let is i64 as final_level with mut = level;
    if (o.engine == opts.ENG_BEST) { final_level = 6; }

    // ---- candidates ----------------------------------------------------
    // Deep colour keeps its samples; there is one representation and no census
    // (a 16-bit image is exactly where a 256-colour palette does not apply).
    let is _Cand as ca;                       // direct / 16-bit
    let is _Cand as cp;                       // palette (ncol > 0 when built)
    ca.raw = 0; ca.plte = 0; ca.trns = 0; ca.ncol = 0;
    cp.raw = 0; cp.plte = 0; cp.trns = 0; cp.ncol = 0;
    let is i64 as npal with mut = 0;

    if (depth == 16) {
        if (_cand_16(img, &ca) < 0) { return errno.I_OOM; }
    } else {
        let is i64 as chan = pixfmt.fmt_channels(img.fmt);
        if (chan < 1 || chan > 4) { return errno.I_UNSUPPORTED; }
        if (o.engine == opts.ENG_FAST) {
            // No census: keep the caller's channel layout as-is.
            let is i64 as ha with mut = 0;
            let is i64 as ig with mut = 0;
            if (chan == 2 || chan == 4) { ha = 1; }
            if (chan == 1 || chan == 2) { ig = 1; }
            if (_cand_direct(img, &ca, ha, ig) < 0) { return errno.I_OOM; }
        } else {
            let is *i64 as col = cast(*i64, mem.core.mmap_anon(256 * 8));
            let is *i64 as cnt = cast(*i64, mem.core.mmap_anon(256 * 8));
            let is [2]i64 as flags;
            let is i64 as n = _census(img, col, cnt, cast(*i64, &flags));
            if (_cand_direct(img, &ca, flags[0], flags[1]) < 0) {
                mem.core.munmap(cast(*u8, col), 256 * 8);
                mem.core.munmap(cast(*u8, cnt), 256 * 8);
                return errno.I_OOM;
            }
            // Palette is a colour-image trick. A greyscale image already has one
            // sample per pixel, so a palette buys nothing but a PLTE chunk — and
            // palettizing it would hand the caller back an RGB image on decode,
            // silently changing the colour model. Depth reduction (below, in
            // _cand_direct) is the greyscale equivalent and keeps grey grey.
            if (n > 0 && flags[1] == 0) {
                if (_cand_palette(img, &cp, col, cnt, n) == 0) { npal = n; }
            }
            mem.core.munmap(cast(*u8, col), 256 * 8);
            mem.core.munmap(cast(*u8, cnt), 256 * 8);
        }
    }

    // ---- strategy set --------------------------------------------------
    // FAST and DEFAULT trust the heuristic. BEST encodes every strategy and
    // keeps the smallest; this is the only way to know, because "which filter
    // compresses best" depends on DEFLATE, not on the residuals.
    let is [7]i64 as strat;
    let is i64 as ns with mut = 1;
    strat[0] = _FS_MINSUM;
    if (o.engine == opts.ENG_BEST) {
        strat[0] = 0; strat[1] = 1; strat[2] = 2; strat[3] = 3; strat[4] = 4;
        strat[5] = _FS_MINSUM; strat[6] = _FS_ENTROPY;
        ns = 7;
    }

    // ---- search --------------------------------------------------------
    // Two tiers, the way zopflipng does it: rank every (representation,
    // strategy) pair with the *cheap* DEFLATE — which is enough to tell them
    // apart, since they are being compared to each other — and then spend the
    // expensive optimal parse exactly once, on the winner.
    let is cb.Bytes as best with mut = cb.bytes_new(1024);
    let is i64 as best_cand with mut = 0 - 1;      // 0 = direct, 1 = palette
    let is i64 as best_strat with mut = 0;
    let is i64 as ci with mut = 0;
    while (ci < 2) {
        let is *_Cand as c with mut = &ca;
        if (ci == 1) { c = &cp; }
        if (ci == 0 || npal > 0) {
            let is i64 as si with mut = 0;
            while (si < ns) {
                let is cb.Bytes as idat = cb.bytes_new(1024);
                let is i64 as r = _try(c, h, strat[si], level, &idat);
                if (r > 0) {
                    if (best_cand < 0 || idat.len < best.len) {
                        cb.bytes_free(&best);
                        best = idat;
                        best_cand = ci;
                        best_strat = strat[si];
                    } else { cb.bytes_free(&idat); }
                } else { cb.bytes_free(&idat); }
                si = si + 1;
            }
        }
        ci = ci + 1;
    }
    if (best_cand < 0) {
        cb.bytes_free(&best);
        _cand_free(&ca, h);
        if (npal > 0) { _cand_free(&cp, h); }
        return errno.I_OOM;
    }

    let is *_Cand as win with mut = &ca;
    if (best_cand == 1) { win = &cp; }
    if (final_level != level) {
        let is cb.Bytes as fin = cb.bytes_new(1024);
        if (_try(win, h, best_strat, final_level, &fin) > 0) {
            if (fin.len < best.len) { cb.bytes_free(&best); best = fin; }
            else { cb.bytes_free(&fin); }
        } else { cb.bytes_free(&fin); }
    }
    _emit_png(win, w, h, &best, out);
    cb.bytes_free(&best);
    _cand_free(&ca, h);
    if (npal > 0) { _cand_free(&cp, h); }
    return out.len;
}

fn png_encode(img as *image.Image, out as *cb.Bytes) as i64 {
    let is opts.EncOpts as o;
    opts.enc_defaults(&o);
    return png_encode_ex(img, out, &o);
}

// ============================ APNG =========================================
// Animated PNG decode. Each frame's data chunks (IDAT for a leading frame 0,
// fdAT minus its 4-byte sequence number otherwise) form a complete zlib stream
// of that frame's filtered scanlines, so each frame is decoded by synthesizing
// an in-memory single-frame PNG (same IHDR params, frame geometry) and running
// the normal decoder; frames are composited onto an RGBA8 canvas per fcTL's
// blend_op (SOURCE/OVER) and dispose_op (NONE/BACKGROUND/PREVIOUS).

struct PngAnim {
    width as i64;
    height as i64;
    count as i64;      // frames actually decoded
    frames as i64;     // address of count * (width*height*4) RGBA8 bytes
    delays as i64;     // address of count i64 delays in milliseconds
}

fn png_anim_frame(a as *PngAnim, i as i64) as *u8 {
    return cast(*u8, a.frames + i * a.width * a.height * 4);
}
fn png_anim_free(a as *PngAnim) as void {
    let is i64 as fsize = a.width * a.height * 4;
    if (a.frames > 0) { mem.core.munmap(cast(*u8, a.frames), a.count * fsize); }
    if (a.delays > 0) { mem.core.munmap(cast(*u8, a.delays), a.count * 8); }
    a.frames = 0; a.delays = 0; a.count = 0;
}

fn _rd32be(p as *u8, o as i64) as i64 {
    return (cast(i64, p[o]) << 24) | (cast(i64, p[o + 1]) << 16)
         | (cast(i64, p[o + 2]) << 8) | cast(i64, p[o + 3]);
}

fn png_decode_anim(src as *u8, src_len as i64, out as *PngAnim) as i64 {
    let is buf.Buf as bf;
    buf.buf_init(&bf, src, src_len);
    let is *u8 as sig with imut = "\x89\x50\x4e\x47\x0d\x0a\x1a\x0a";
    let is i64 as si with mut = 0;
    while (si < 8) {
        if (buf.buf_u8(&bf) != cast(i64, sig[si])) { return errno.I_BADMAGIC; }
        si = si + 1;
    }

    // ---- pass 1: gather IHDR bytes / PLTE / tRNS / acTL / frame layout ----
    let is *u8 as ihdr_ptr with mut = cast(*u8, 0);
    let is *u8 as plte_ptr with mut = cast(*u8, 0);
    let is i64 as plte_len with mut = 0;
    let is *u8 as trns_ptr with mut = cast(*u8, 0);
    let is i64 as trns_len with mut = 0;
    let is i64 as nframes with mut = 0;

    let is i64 as done with mut = 0;
    while (done == 0) {
        let is i64 as clen = buf.buf_u32be(&bf);
        if (clen < 0) { return errno.I_CORRUPT; }
        let is i64 as t0 = buf.buf_u8(&bf);
        let is i64 as t1 = buf.buf_u8(&bf);
        let is i64 as t2 = buf.buf_u8(&bf);
        let is i64 as t3 = buf.buf_u8(&bf);
        if (t3 < 0) { return errno.I_CORRUPT; }
        let is i64 as data_off = bf.pos;
        if (buf.buf_remaining(&bf) < clen + 4) { return errno.I_CORRUPT; }
        let is *u8 as data = cast(*u8, cast(i64, src) + data_off);
        if (_type_is(t0,t1,t2,t3, 73,72,68,82) == 1) { ihdr_ptr = data; }         // IHDR
        if (_type_is(t0,t1,t2,t3, 80,76,84,69) == 1) { plte_ptr = data; plte_len = clen; }
        if (_type_is(t0,t1,t2,t3, 116,82,78,83) == 1) { trns_ptr = data; trns_len = clen; }
        if (_type_is(t0,t1,t2,t3, 97,99,84,76) == 1) { nframes = _rd32be(data, 0); }  // acTL
        if (_type_is(t0,t1,t2,t3, 73,69,78,68) == 1) { done = 1; }                // IEND
        buf.buf_skip(&bf, clen + 4);
    }
    if (cast(i64, ihdr_ptr) == 0) { return errno.I_CORRUPT; }
    if (nframes < 1) { return errno.I_UNSUPPORTED; }                              // not animated
    if (nframes > 4096) { return errno.I_UNSUPPORTED; }
    let is i64 as w = _rd32be(ihdr_ptr, 0);
    let is i64 as h = _rd32be(ihdr_ptr, 4);
    if (image.image_check_dims(w, h, pixfmt.FMT_RGBA8) < 0) { return errno.I_DIMS; }

    let is i64 as fsize = w * h * 4;
    let is *u8 as frames = mem.core.mmap_anon(nframes * fsize);
    let is *i64 as delays = cast(*i64, mem.core.mmap_anon(nframes * 8));
    let is *u8 as canvas = mem.core.mmap_anon(fsize);
    let is *u8 as saved = mem.core.mmap_anon(fsize);
    if (cast(i64, saved) <= 0) { return errno.I_OOM; }
    mem.core.memset(canvas, cast(i32, 0), fsize);

    // ---- pass 2: walk fcTL / IDAT / fdAT, decoding each finished frame ----
    buf.buf_init(&bf, src, src_len);
    buf.buf_skip(&bf, 8);
    let is cb.Bytes as fdata = cb.bytes_new(4096);
    let is i64 as have_fctl with mut = 0;
    let is i64 as fx with mut = 0;
    let is i64 as fy with mut = 0;
    let is i64 as fw with mut = 0;
    let is i64 as fh with mut = 0;
    let is i64 as fdelay with mut = 0;
    let is i64 as fdispose with mut = 0;
    let is i64 as fblend with mut = 0;
    let is i64 as fi with mut = 0;

    done = 0;
    while (done == 0) {
        let is i64 as clen = buf.buf_u32be(&bf);
        if (clen < 0) { done = 1; }
        else {
            let is i64 as t0 = buf.buf_u8(&bf);
            let is i64 as t1 = buf.buf_u8(&bf);
            let is i64 as t2 = buf.buf_u8(&bf);
            let is i64 as t3 = buf.buf_u8(&bf);
            let is i64 as data_off = bf.pos;
            let is *u8 as data = cast(*u8, cast(i64, src) + data_off);
            let is i64 as flush with mut = 0;

            if (_type_is(t0,t1,t2,t3, 102,99,84,76) == 1) {          // fcTL
                if (have_fctl == 1) { if (fdata.len > 0) { flush = 1; } }
                if (flush == 0) {
                    // start a new frame directly
                    fw = _rd32be(data, 4); fh = _rd32be(data, 8);
                    fx = _rd32be(data, 12); fy = _rd32be(data, 16);
                    let is i64 as dnum = (cast(i64, data[20]) << 8) | cast(i64, data[21]);
                    let is i64 as dden with mut = (cast(i64, data[22]) << 8) | cast(i64, data[23]);
                    if (dden == 0) { dden = 100; }
                    fdelay = dnum * 1000 / dden;
                    fdispose = cast(i64, data[24]);
                    fblend = cast(i64, data[25]);
                    have_fctl = 1;
                }
            } else {
            if (_type_is(t0,t1,t2,t3, 73,68,65,84) == 1) {           // IDAT
                if (have_fctl == 1) { cb.bytes_append(&fdata, data, clen); }
                // (IDAT before any fcTL = static image, not an animation frame)
            } else {
            if (_type_is(t0,t1,t2,t3, 102,100,65,84) == 1) {         // fdAT
                if (have_fctl == 1) {
                    cb.bytes_append(&fdata, cast(*u8, cast(i64, data) + 4), clen - 4);
                }
            } else {
            if (_type_is(t0,t1,t2,t3, 73,69,78,68) == 1) {           // IEND
                if (have_fctl == 1) { if (fdata.len > 0) { flush = 2; } }
                done = 1;
            } } } }

            if (flush > 0) {
                // decode the finished frame via a synthesized single-frame PNG
                let is cb.Bytes as mini = cb.bytes_new(fdata.len + 256);
                cb.bytes_append(&mini, sig, 8);
                let is [13]u8 as ih;
                let is i64 as k with mut = 0;
                while (k < 13) { ih[k] = ihdr_ptr[k]; k = k + 1; }
                ih[0] = cast(u8, (fw >> 24) & 255); ih[1] = cast(u8, (fw >> 16) & 255);
                ih[2] = cast(u8, (fw >> 8) & 255);  ih[3] = cast(u8, fw & 255);
                ih[4] = cast(u8, (fh >> 24) & 255); ih[5] = cast(u8, (fh >> 16) & 255);
                ih[6] = cast(u8, (fh >> 8) & 255);  ih[7] = cast(u8, fh & 255);
                _png_chunk(&mini, "IHDR", cast(*u8, &ih), 13);
                if (plte_len > 0) { _png_chunk(&mini, "PLTE", plte_ptr, plte_len); }
                if (trns_len > 0) { _png_chunk(&mini, "tRNS", trns_ptr, trns_len); }
                _png_chunk(&mini, "IDAT", fdata.ptr, fdata.len);
                _png_chunk(&mini, "IEND", cast(*u8, 0), 0);
                let is image.Image as fr;
                let is i64 as drc = png_decode(mini.ptr, mini.len, &fr);
                cb.bytes_free(&mini);
                if (drc < 0) { return errno.I_CORRUPT; }
                if (fr.width != fw) { return errno.I_CORRUPT; }

                if (fdispose == 2) { mem.core.memcpy(saved, canvas, fsize); }
                // composite region (fx,fy,fw,fh)
                let is i64 as fch = pixfmt.fmt_channels(fr.fmt);
                let is i64 as ry with mut = 0;
                while (ry < fh) {
                    let is i64 as cy = fy + ry;
                    if (cy >= 0) { if (cy < h) {
                        let is i64 as rx with mut = 0;
                        while (rx < fw) {
                            let is i64 as cx = fx + rx;
                            if (cx >= 0) { if (cx < w) {
                                // source pixel as RGBA
                                let is i64 as so = ry * fr.stride + rx * pixfmt.fmt_bpp(fr.fmt);
                                let is i64 as sr with mut = cast(i64, fr.pixels[so]);
                                let is i64 as sg with mut = sr;
                                let is i64 as sb with mut = sr;
                                let is i64 as sa with mut = 255;
                                if (fch >= 3) { sg = cast(i64, fr.pixels[so + 1]); sb = cast(i64, fr.pixels[so + 2]); }
                                if (fch == 2) { sa = cast(i64, fr.pixels[so + 1]); }
                                if (fch == 4) { sa = cast(i64, fr.pixels[so + 3]); }
                                let is i64 as co = (cy * w + cx) * 4;
                                if (fblend == 0) {
                                    canvas[co] = cast(u8, sr); canvas[co+1] = cast(u8, sg);
                                    canvas[co+2] = cast(u8, sb); canvas[co+3] = cast(u8, sa);
                                } else {
                                    // OVER (Porter-Duff, integer)
                                    let is i64 as da = cast(i64, canvas[co+3]);
                                    let is i64 as oa = sa + da * (255 - sa) / 255;
                                    if (oa == 0) {
                                        canvas[co]=cast(u8,0); canvas[co+1]=cast(u8,0);
                                        canvas[co+2]=cast(u8,0); canvas[co+3]=cast(u8,0);
                                    } else {
                                        let is i64 as c2 with mut = 0;
                                        while (c2 < 3) {
                                            let is i64 as sc with mut = cast(i64, fr.pixels[so + c2]);
                                            if (fch <= 2) { sc = sr; }
                                            let is i64 as dc = cast(i64, canvas[co + c2]);
                                            canvas[co + c2] = cast(u8,
                                                (sc * sa + dc * da * (255 - sa) / 255) / oa);
                                            c2 = c2 + 1;
                                        }
                                        canvas[co+3] = cast(u8, oa);
                                    }
                                }
                            } }
                            rx = rx + 1;
                        }
                    } }
                    ry = ry + 1;
                }
                image.image_free(&fr);
                // snapshot
                if (fi < nframes) {
                    mem.core.memcpy(cast(*u8, cast(i64, frames) + fi * fsize), canvas, fsize);
                    delays[fi] = fdelay;
                    fi = fi + 1;
                }
                // dispose for next frame
                if (fdispose == 1) {
                    let is i64 as ry2 with mut = 0;
                    while (ry2 < fh) {
                        let is i64 as cy = fy + ry2;
                        if (cy >= 0) { if (cy < h) {
                            let is i64 as rx2 with mut = 0;
                            while (rx2 < fw) {
                                let is i64 as cx = fx + rx2;
                                if (cx >= 0) { if (cx < w) {
                                    let is i64 as co = (cy * w + cx) * 4;
                                    canvas[co]=cast(u8,0); canvas[co+1]=cast(u8,0);
                                    canvas[co+2]=cast(u8,0); canvas[co+3]=cast(u8,0);
                                } }
                                rx2 = rx2 + 1;
                            }
                        } }
                        ry2 = ry2 + 1;
                    }
                }
                if (fdispose == 2) { mem.core.memcpy(canvas, saved, fsize); }
                cb.bytes_reset(&fdata);
                if (flush == 1) {
                    // the fcTL that triggered the flush starts the NEXT frame
                    fw = _rd32be(data, 4); fh = _rd32be(data, 8);
                    fx = _rd32be(data, 12); fy = _rd32be(data, 16);
                    let is i64 as dnum = (cast(i64, data[20]) << 8) | cast(i64, data[21]);
                    let is i64 as dden with mut = (cast(i64, data[22]) << 8) | cast(i64, data[23]);
                    if (dden == 0) { dden = 100; }
                    fdelay = dnum * 1000 / dden;
                    fdispose = cast(i64, data[24]);
                    fblend = cast(i64, data[25]);
                }
            }
            buf.buf_seek(&bf, data_off);
            buf.buf_skip(&bf, clen + 4);
        }
    }
    cb.bytes_free(&fdata);
    mem.core.munmap(canvas, fsize);
    mem.core.munmap(saved, fsize);
    out.width = w; out.height = h; out.count = fi;
    out.frames = cast(i64, frames); out.delays = cast(i64, delays);
    return 0;
}
