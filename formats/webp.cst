// =======================================================
// caustic-image/formats/webp.cst
// WebP decoder — the VP8L (lossless) bitstream: canonical prefix codes with
// meta-Huffman groups, LZ77 over pixels with the 2D distance map, a colour
// cache, and the four transforms (predictor / cross-colour / subtract-green /
// colour-indexing with pixel bundling), applied inverse in LIFO order.
// Bit order is LSB-first, so caustic-compact's DEFLATE bit reader is reused.
// VP8 (lossy) intra frames decode via formats/vp8.cst (bit-exact vs libwebp).
//   webp_decode(src, src_len, out) -> 0, or negative errno.
// =======================================================

use "std/mem.cst" only bins, core as mem;
use "../core/errno.cst"  as errno;
use "../core/image.cst"  as image;
use "../core/pixfmt.cst" as pixfmt;
use "../core/opts.cst"   as opts;
use "caustic-compact/core/bitreader.cst" as br;
use "vp8.cst" as vp8;

// kCodeToPlane (libwebp): 120 packed (yoffset<<4 | 8-xoffset) bytes.
let is *u8 as _KP with imut = "\x18\x07\x17\x19\x28\x06\x27\x29\x16\x1a\x26\x2a\x38\x05\x37\x39\x15\x1b\x36\x3a\x25\x2b\x48\x04\x47\x49\x14\x1c\x35\x3b\x46\x4a\x24\x2c\x58\x45\x4b\x34\x3c\x03\x57\x59\x13\x1d\x56\x5a\x23\x2d\x44\x4c\x55\x5b\x33\x3d\x68\x02\x67\x69\x12\x1e\x66\x6a\x22\x2e\x54\x5c\x43\x4d\x65\x6b\x32\x3e\x78\x01\x77\x79\x53\x5d\x11\x1f\x64\x6c\x42\x4e\x76\x7a\x21\x2f\x75\x7b\x31\x3f\x63\x6d\x52\x5e\x00\x74\x7c\x41\x4f\x10\x20\x62\x6e\x30\x73\x7d\x51\x5f\x40\x72\x7e\x61\x6f\x50\x71\x7f\x60\x70";

// kCodeLengthCodeOrder.
let is *u8 as _CLO with imut = "\x11\x12\x00\x01\x02\x03\x04\x05\x10\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f";

// ---- canonical prefix trees --------------------------------------------
// Tree block layout (i64 units): [0..15] count-per-length, [16..31] first
// code per length, [32..47] valptr per length, [48] single-symbol (or -1),
// [64...] symbols sorted by (length, index).
let is i64 as HDRT with imut = 64;

fn _tree_from_lengths(t as *i64, lens as *i64, n as i64) as i64 {
    let is i64 as l with mut = 0;
    while (l < 16) { t[l] = 0; l = l + 1; }
    let is i64 as total with mut = 0;
    let is i64 as lastsym with mut = 0 - 1;
    let is i64 as s with mut = 0;
    while (s < n) {
        let is i64 as ln = lens[s];
        if (ln > 15) { return 0 - 1; }
        if (ln > 0) { t[ln] = t[ln] + 1; total = total + 1; lastsym = s; }
        s = s + 1;
    }
    if (total == 0) { return 0 - 1; }
    if (total == 1) { t[48] = lastsym; return 0; }
    t[48] = 0 - 1;
    // first codes + valptrs.
    let is i64 as code with mut = 0;
    let is i64 as cum with mut = 0;
    let is [16]i64 as vp;
    l = 1;
    while (l < 16) {
        t[16 + l] = code;
        t[32 + l] = cum;
        vp[l] = cum;
        code = (code + t[l]) << 1;
        cum = cum + t[l];
        l = l + 1;
    }
    // sorted symbols.
    s = 0;
    while (s < n) {
        let is i64 as ln = lens[s];
        if (ln > 0) { t[HDRT + vp[ln]] = s; vp[ln] = vp[ln] + 1; }
        s = s + 1;
    }
    return 0;
}

fn _read_code(b as *br.BitReader, t as *i64) as i64 {
    if (t[48] >= 0) { return t[48]; }
    let is i64 as code with mut = 0;
    let is i64 as l with mut = 1;
    while (l < 16) {
        code = (code << 1) | br.br_get(b, 1);
        if (t[l] > 0) {
            let is i64 as fc = t[16 + l];
            if (code >= fc) { if (code < fc + t[l]) {
                return t[HDRT + t[32 + l] + code - fc];
            } }
        }
        l = l + 1;
    }
    return 0 - 1;
}

// ReadHuffmanCode: simple (1-2 explicit symbols) or code-length-coded.
fn _read_htree(b as *br.BitReader, t as *i64, alphabet as i64, lens as *i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < alphabet) { lens[i] = 0; i = i + 1; }

    if (br.br_get(b, 1) == 1) {                       // simple code
        let is i64 as nsym = br.br_get(b, 1) + 1;
        let is i64 as first8 = br.br_get(b, 1);
        let is i64 as nb with mut = 1;
        if (first8 == 1) { nb = 8; }
        let is i64 as s0 = br.br_get(b, nb);
        if (s0 < 0) { return 0 - 1; }
        if (s0 >= alphabet) { return 0 - 1; }
        lens[s0] = 1;
        if (nsym == 2) {
            let is i64 as s1 = br.br_get(b, 8);
            if (s1 < 0) { return 0 - 1; }
            if (s1 >= alphabet) { return 0 - 1; }
            lens[s1] = 1;
        }
        return _tree_from_lengths(t, lens, alphabet);
    }

    // code-length code: up to 19 3-bit lengths in kCodeLengthCodeOrder.
    let is [19]i64 as cl;
    i = 0; while (i < 19) { cl[i] = 0; i = i + 1; }
    let is i64 as ncodes = 4 + br.br_get(b, 4);
    if (ncodes > 19) { return 0 - 1; }
    i = 0;
    while (i < ncodes) {
        cl[cast(i64, _CLO[i])] = br.br_get(b, 3);
        i = i + 1;
    }
    let is [96]i64 as clt;
    if (_tree_from_lengths(cast(*i64, &clt), cast(*i64, &cl), 19) < 0) { return 0 - 1; }

    let is i64 as max_symbol with mut = alphabet;
    if (br.br_get(b, 1) == 1) {
        let is i64 as lnbits = 2 + 2 * br.br_get(b, 3);
        max_symbol = 2 + br.br_get(b, lnbits);
        if (max_symbol > alphabet) { return 0 - 1; }
    }

    let is i64 as prev with mut = 8;
    let is i64 as sym with mut = 0;
    let is i64 as go with mut = 1;
    while (go == 1) {
        if (sym >= alphabet) { go = 0; }
        else {
            if (max_symbol == 0) { go = 0; }
            else {
                max_symbol = max_symbol - 1;
                let is i64 as c = _read_code(b, cast(*i64, &clt));
                if (c < 0) { return 0 - 1; }
                if (c < 16) {
                    lens[sym] = c;
                    sym = sym + 1;
                    if (c != 0) { prev = c; }
                } else {
                    let is i64 as rep with mut = 0;
                    let is i64 as fill with mut = 0;
                    if (c == 16) { rep = 3 + br.br_get(b, 2); fill = prev; }
                    else { if (c == 17) { rep = 3 + br.br_get(b, 3); }
                    else { rep = 11 + br.br_get(b, 7); } }
                    if (sym + rep > alphabet) { return 0 - 1; }
                    let is i64 as k with mut = 0;
                    while (k < rep) { lens[sym] = fill; sym = sym + 1; k = k + 1; }
                }
            }
        }
    }
    return _tree_from_lengths(t, lens, alphabet);
}

// length/distance prefix values (extra bits inline).
fn _prefix_val(b as *br.BitReader, sym as i64) as i64 {
    if (sym < 4) { return sym + 1; }
    let is i64 as eb = (sym - 2) >> 1;
    let is i64 as off = (2 + (sym & 1)) << eb;
    return off + br.br_get(b, eb) + 1;
}

fn _plane_dist(plane as i64, w as i64) as i64 {
    if (plane > 120) { return plane - 120; }
    let is i64 as c = cast(i64, _KP[plane - 1]);
    let is i64 as d = (c >> 4) * w + (8 - (c & 15));
    if (d < 1) { return 1; }
    return d;
}

fn _sub(sz as i64, bits as i64) as i64 {
    return (sz + (1 << bits) - 1) >> bits;
}

// ---- pixel decode (shared by main + auxiliary streams) ------------------
// groups: ngroups tree groups; meta (or 0): entropy image selecting the group.
fn _decode_pixels(b as *br.BitReader, w as i64, h as i64,
                  groups as *i64, gstride as i64, green_alpha as i64,
                  meta as *i64, metaw as i64, metabits as i64,
                  cache as *i64, cachebits as i64, out as *i64) as i64 {
    let is i64 as off_red = HDRT + green_alpha;
    let is i64 as off_blue = off_red + HDRT + 256;
    let is i64 as off_alpha = off_blue + HDRT + 256;
    let is i64 as off_dist = off_alpha + HDRT + 256;
    let is i64 as npx = w * h;
    let is i64 as cshift = 32 - cachebits;

    let is i64 as p with mut = 0;
    let is i64 as x with mut = 0;
    let is i64 as y with mut = 0;
    while (p < npx) {
        let is i64 as gbase with mut = 0;
        if (cast(i64, meta) != 0) {
            let is i64 as m = meta[(y >> metabits) * metaw + (x >> metabits)];
            gbase = ((m >> 8) & 65535) * gstride;
        }
        let is *i64 as gt = cast(*i64, cast(i64, groups) + gbase * 8);
        let is i64 as sym = _read_code(b, gt);
        if (sym < 0) { return errno.I_CORRUPT; }

        if (sym < 256) {
            let is i64 as r = _read_code(b, cast(*i64, cast(i64, gt) + off_red * 8));
            let is i64 as bl = _read_code(b, cast(*i64, cast(i64, gt) + off_blue * 8));
            let is i64 as al = _read_code(b, cast(*i64, cast(i64, gt) + off_alpha * 8));
            if (al < 0) { return errno.I_CORRUPT; }
            let is i64 as px = (al << 24) | (r << 16) | (sym << 8) | bl;
            out[p] = px;
            if (cachebits > 0) {
                cache[((px * 506832829) & 0xFFFFFFFF) >> cshift] = px;
            }
            p = p + 1; x = x + 1; if (x == w) { x = 0; y = y + 1; }
        } else {
            if (sym < 280) {
                let is i64 as len = _prefix_val(b, sym - 256);
                let is i64 as ds = _read_code(b, cast(*i64, cast(i64, gt) + off_dist * 8));
                if (ds < 0) { return errno.I_CORRUPT; }
                let is i64 as dist = _plane_dist(_prefix_val(b, ds), w);
                if (dist > p) { return errno.I_CORRUPT; }
                if (p + len > npx) { return errno.I_CORRUPT; }
                let is i64 as k with mut = 0;
                while (k < len) {
                    let is i64 as px = out[p - dist];
                    out[p] = px;
                    if (cachebits > 0) {
                        cache[((px * 506832829) & 0xFFFFFFFF) >> cshift] = px;
                    }
                    p = p + 1; x = x + 1; if (x == w) { x = 0; y = y + 1; }
                    k = k + 1;
                }
            } else {
                let is i64 as ci = sym - 280;
                if (cachebits == 0) { return errno.I_CORRUPT; }
                if (ci >= (1 << cachebits)) { return errno.I_CORRUPT; }
                let is i64 as px = cache[ci];
                out[p] = px;
                cache[((px * 506832829) & 0xFFFFFFFF) >> cshift] = px;
                p = p + 1; x = x + 1; if (x == w) { x = 0; y = y + 1; }
            }
        }
    }
    return 0;
}

// Decode an auxiliary (non-level-0) image stream: optional colour cache, one
// tree group, pixels. Returns the address of a w*h i64 ARGB buffer, or 0.
fn _decode_substream(b as *br.BitReader, w as i64, h as i64) as i64 {
    let is i64 as cachebits with mut = 0;
    let is *i64 as cache with mut = cast(*i64, 0);
    if (br.br_get(b, 1) == 1) {
        cachebits = br.br_get(b, 4);
        if (cachebits < 1) { return 0; }
        if (cachebits > 11) { return 0; }
        cache = cast(*i64, mem.core.mmap_anon((1 << cachebits) * 8));
        if (cast(i64, cache) <= 0) { return 0; }
    }
    // green alphabet = 256 literals + 24 length codes + cache entries.
    let is i64 as ga with mut = 280;
    if (cachebits > 0) { ga = 280 + (1 << cachebits); }
    let is i64 as gstride = (HDRT + ga) + 3 * (HDRT + 256) + (HDRT + 40);
    let is *i64 as grp = cast(*i64, mem.core.mmap_anon(gstride * 8));
    let is *i64 as lens = cast(*i64, mem.core.mmap_anon(ga * 8));
    if (cast(i64, lens) <= 0) { return 0; }

    let is i64 as ok with mut = 0;
    ok = _read_htree(b, grp, ga, lens);
    if (ok >= 0) { ok = _read_htree(b, cast(*i64, cast(i64, grp) + (HDRT + ga) * 8), 256, lens); }
    if (ok >= 0) { ok = _read_htree(b, cast(*i64, cast(i64, grp) + (HDRT + ga + HDRT + 256) * 8), 256, lens); }
    if (ok >= 0) { ok = _read_htree(b, cast(*i64, cast(i64, grp) + (HDRT + ga + 2 * (HDRT + 256)) * 8), 256, lens); }
    if (ok >= 0) { ok = _read_htree(b, cast(*i64, cast(i64, grp) + (HDRT + ga + 3 * (HDRT + 256)) * 8), 40, lens); }
    if (ok < 0) { return 0; }

    let is *i64 as buf = cast(*i64, mem.core.mmap_anon(w * h * 8));
    if (cast(i64, buf) <= 0) { return 0; }
    let is i64 as rc = _decode_pixels(b, w, h, grp, gstride, ga,
        cast(*i64, 0), 0, 0, cache, cachebits, buf);
    mem.core.munmap(cast(*u8, grp), gstride * 8);
    mem.core.munmap(cast(*u8, lens), ga * 8);
    if (cachebits > 0) { mem.core.munmap(cast(*u8, cache), (1 << cachebits) * 8); }
    if (rc < 0) { mem.core.munmap(cast(*u8, buf), w * h * 8); return 0; }
    return cast(i64, buf);
}

// ---- inverse transforms --------------------------------------------------
fn _avg2c(a as i64, bb as i64, s as i64) as i64 {
    return (((a >> s) & 255) + ((bb >> s) & 255)) >> 1;
}
fn _avg2(a as i64, bb as i64) as i64 {
    return (_avg2c(a, bb, 24) << 24) | (_avg2c(a, bb, 16) << 16)
         | (_avg2c(a, bb, 8) << 8) | _avg2c(a, bb, 0);
}
fn _clamp255(v as i64) as i64 {
    if (v < 0) { return 0; }
    if (v > 255) { return 255; }
    return v;
}
fn _cas_full(l as i64, t as i64, tl as i64) as i64 {
    let is i64 as r with mut = 0;
    let is i64 as s with mut = 0;
    while (s < 32) {
        let is i64 as v = _clamp255(((l >> s) & 255) + ((t >> s) & 255) - ((tl >> s) & 255));
        r = r | (v << s);
        s = s + 8;
    }
    return r;
}
fn _cas_half(l as i64, t as i64, tl as i64) as i64 {
    let is i64 as ave = _avg2(l, t);
    let is i64 as r with mut = 0;
    let is i64 as s with mut = 0;
    while (s < 32) {
        let is i64 as a = (ave >> s) & 255;
        let is i64 as d = a - ((tl >> s) & 255);
        // C-style trunc-toward-zero halving of a possibly negative delta.
        let is i64 as hd with mut = d / 2;
        let is i64 as v = _clamp255(a + hd);
        r = r | (v << s);
        s = s + 8;
    }
    return r;
}
fn _absv(v as i64) as i64 { if (v < 0) { return 0 - v; } return v; }
fn _select(t as i64, l as i64, tl as i64) as i64 {
    let is i64 as pa with mut = 0;    // Σ |L-TL| - |T-TL|
    let is i64 as s with mut = 0;
    while (s < 32) {
        pa = pa + _absv(((l >> s) & 255) - ((tl >> s) & 255))
                - _absv(((t >> s) & 255) - ((tl >> s) & 255));
        s = s + 8;
    }
    if (pa <= 0) { return t; }
    return l;
}
fn _addpx(a as i64, bb as i64) as i64 {
    let is i64 as r with mut = 0;
    let is i64 as s with mut = 0;
    while (s < 32) {
        r = r | (((((a >> s) & 255) + ((bb >> s) & 255)) & 255) << s);
        s = s + 8;
    }
    return r;
}
fn _s8(v as i64) as i64 { if (v >= 128) { return v - 256; } return v; }
fn _ctdelta(t as i64, c as i64) as i64 { return (_s8(t) * _s8(c)) >> 5; }

// The fourteen VP8L spatial predictors, on packed ARGB. Shared by the decoder's
// inverse transform and the encoder's forward one, so the two cannot drift.
// Modes 11-13 are the ones that matter for smooth content: 12 predicts
// L + T - TL per channel, which is *exact* on a linear gradient and collapses
// its residual to zero.
fn _pred_px(mode as i64, l as i64, t as i64, tl as i64, tr as i64) as i64 {
    if (mode == 0)  { return 255 << 24; }
    if (mode == 1)  { return l; }
    if (mode == 2)  { return t; }
    if (mode == 3)  { return tr; }
    if (mode == 4)  { return tl; }
    if (mode == 5)  { return _avg2(_avg2(l, tr), t); }
    if (mode == 6)  { return _avg2(l, tl); }
    if (mode == 7)  { return _avg2(l, t); }
    if (mode == 8)  { return _avg2(tl, t); }
    if (mode == 9)  { return _avg2(t, tr); }
    if (mode == 10) { return _avg2(_avg2(l, tl), _avg2(t, tr)); }
    if (mode == 11) { return _select(t, l, tl); }
    if (mode == 12) { return _cas_full(l, t, tl); }
    return _cas_half(l, t, tl);
}

// The prediction at p under the spec's border rules: the very first pixel
// predicts opaque black, the top row predicts from the left, the left column
// predicts from above, and only the interior consults `mode`.
fn _pred_at(buf as *i64, w as i64, p as i64, x as i64, y as i64, mode as i64) as i64 {
    if (p == 0) { return 255 << 24; }
    if (y == 0) { return buf[p - 1]; }
    if (x == 0) { return buf[p - w]; }
    return _pred_px(mode, buf[p - 1], buf[p - w], buf[p - w - 1], buf[p - w + 1]);
}

fn _inv_predictor(buf as *i64, w as i64, h as i64, data as *i64, bits as i64) as void {
    let is i64 as tw = _sub(w, bits);
    let is i64 as p with mut = 0;
    let is i64 as y with mut = 0;
    while (y < h) {
        let is i64 as x with mut = 0;
        while (x < w) {
            let is i64 as mode with mut = 0;
            if (p > 0 && y > 0 && x > 0) {
                mode = (data[(y >> bits) * tw + (x >> bits)] >> 8) & 255;
            }
            buf[p] = _addpx(buf[p], _pred_at(buf, w, p, x, y, mode));
            p = p + 1;
            x = x + 1;
        }
        y = y + 1;
    }
}

fn _inv_color(buf as *i64, w as i64, h as i64, data as *i64, bits as i64) as void {
    let is i64 as tw = _sub(w, bits);
    let is i64 as p with mut = 0;
    let is i64 as y with mut = 0;
    while (y < h) {
        let is i64 as x with mut = 0;
        while (x < w) {
            let is i64 as cte = data[(y >> bits) * tw + (x >> bits)];
            let is i64 as g2r = cte & 255;
            let is i64 as g2b = (cte >> 8) & 255;
            let is i64 as r2b = (cte >> 16) & 255;
            let is i64 as px = buf[p];
            let is i64 as g = (px >> 8) & 255;
            let is i64 as r = (((px >> 16) & 255) + _ctdelta(g2r, g)) & 255;
            let is i64 as bl with mut = ((px & 255) + _ctdelta(g2b, g)) & 255;
            bl = (bl + _ctdelta(r2b, r)) & 255;
            buf[p] = (px & (255 << 24)) | (r << 16) | (g << 8) | bl;
            p = p + 1;
            x = x + 1;
        }
        y = y + 1;
    }
}

fn _inv_subgreen(buf as *i64, n as i64) as void {
    let is i64 as p with mut = 0;
    while (p < n) {
        let is i64 as px = buf[p];
        let is i64 as g = (px >> 8) & 255;
        let is i64 as r = (((px >> 16) & 255) + g) & 255;
        let is i64 as bl = ((px & 255) + g) & 255;
        buf[p] = (px & (255 << 24)) | (r << 16) | (g << 8) | bl;
        p = p + 1;
    }
}

// Decode a VP8L "image stream" (level 0) of known w×h into `outbuf` (w*h ARGB
// i64). The bit reader must be positioned at the transforms flag (no signature
// or dims header). Returns 0, or negative. Shared by the main decode and the
// lossless alpha stream (ALPH method 1).
fn _vp8l_argb(b as *br.BitReader, w as i64, h as i64, outbuf as *i64) as i64 {
    // ---- transforms (level 0 only; each type at most once) ----
    let is [4]i64 as ttype;
    let is [4]i64 as tbits;
    let is [4]i64 as tdata;
    let is [4]i64 as torigw;
    let is [4]i64 as tpalsz;
    let is i64 as ntrans with mut = 0;
    let is i64 as cur_w with mut = w;
    while (br.br_get(b, 1) == 1) {
        if (ntrans >= 4) { return errno.I_CORRUPT; }
        let is i64 as tt = br.br_get(b, 2);
        ttype[ntrans] = tt;
        tbits[ntrans] = 0; tdata[ntrans] = 0; torigw[ntrans] = cur_w; tpalsz[ntrans] = 0;
        if (tt <= 1) {                                  // predictor / cross-colour
            let is i64 as tb = br.br_get(b, 3) + 2;
            tbits[ntrans] = tb;
            let is i64 as d = _decode_substream(b, _sub(cur_w, tb), _sub(h, tb));
            if (d == 0) { return errno.I_CORRUPT; }
            tdata[ntrans] = d;
        } else {
            if (tt == 3) {                              // colour indexing
                let is i64 as n = br.br_get(b, 8) + 1;
                let is i64 as d = _decode_substream(b, n, 1);
                if (d == 0) { return errno.I_CORRUPT; }
                let is *i64 as pal = cast(*i64, d);
                let is i64 as i with mut = 1;
                while (i < n) { pal[i] = _addpx(pal[i], pal[i - 1]); i = i + 1; }
                let is i64 as xb with mut = 0;
                if (n <= 2) { xb = 3; } else { if (n <= 4) { xb = 2; } else { if (n <= 16) { xb = 1; } } }
                tbits[ntrans] = xb;
                tdata[ntrans] = d;
                tpalsz[ntrans] = n;
                cur_w = _sub(cur_w, xb);
            }
        }
        ntrans = ntrans + 1;
    }

    // ---- colour cache ----
    let is i64 as cachebits with mut = 0;
    let is *i64 as cache with mut = cast(*i64, 0);
    if (br.br_get(b, 1) == 1) {
        cachebits = br.br_get(b, 4);
        if (cachebits < 1) { return errno.I_CORRUPT; }
        if (cachebits > 11) { return errno.I_CORRUPT; }
        cache = cast(*i64, mem.core.mmap_anon((1 << cachebits) * 8));
        if (cast(i64, cache) <= 0) { return errno.I_OOM; }
    }

    // ---- meta-Huffman (entropy image) ----
    let is *i64 as meta with mut = cast(*i64, 0);
    let is i64 as metaw with mut = 0;
    let is i64 as metabits with mut = 0;
    let is i64 as ngroups with mut = 1;
    if (br.br_get(b, 1) == 1) {
        metabits = br.br_get(b, 3) + 2;
        metaw = _sub(cur_w, metabits);
        let is i64 as mh = _sub(h, metabits);
        let is i64 as d = _decode_substream(b, metaw, mh);
        if (d == 0) { return errno.I_CORRUPT; }
        meta = cast(*i64, d);
        let is i64 as i with mut = 0;
        let is i64 as mn = metaw * mh;
        while (i < mn) {
            let is i64 as gi = (meta[i] >> 8) & 65535;
            if (gi + 1 > ngroups) { ngroups = gi + 1; }
            i = i + 1;
        }
        if (ngroups > 1024) { return errno.I_UNSUPPORTED; }
    }

    // ---- tree groups ----
    let is i64 as ga with mut = 280;
    if (cachebits > 0) { ga = 280 + (1 << cachebits); }
    let is i64 as gstride = (HDRT + ga) + 3 * (HDRT + 256) + (HDRT + 40);
    let is *i64 as groups = cast(*i64, mem.core.mmap_anon(ngroups * gstride * 8));
    let is *i64 as lens = cast(*i64, mem.core.mmap_anon(ga * 8));
    if (cast(i64, lens) <= 0) { return errno.I_OOM; }
    let is i64 as g with mut = 0;
    while (g < ngroups) {
        let is *i64 as gt = cast(*i64, cast(i64, groups) + g * gstride * 8);
        if (_read_htree(b, gt, ga, lens) < 0) { return errno.I_CORRUPT; }
        if (_read_htree(b, cast(*i64, cast(i64, gt) + (HDRT + ga) * 8), 256, lens) < 0) { return errno.I_CORRUPT; }
        if (_read_htree(b, cast(*i64, cast(i64, gt) + (HDRT + ga + HDRT + 256) * 8), 256, lens) < 0) { return errno.I_CORRUPT; }
        if (_read_htree(b, cast(*i64, cast(i64, gt) + (HDRT + ga + 2 * (HDRT + 256)) * 8), 256, lens) < 0) { return errno.I_CORRUPT; }
        if (_read_htree(b, cast(*i64, cast(i64, gt) + (HDRT + ga + 3 * (HDRT + 256)) * 8), 40, lens) < 0) { return errno.I_CORRUPT; }
        g = g + 1;
    }

    // ---- pixel data (at the possibly palette-packed width) ----
    let is *i64 as buf with mut = cast(*i64, mem.core.mmap_anon(cur_w * h * 8));
    if (cast(i64, buf) <= 0) { return errno.I_OOM; }
    let is i64 as rc = _decode_pixels(b, cur_w, h, groups, gstride, ga,
        meta, metaw, metabits, cache, cachebits, buf);
    mem.core.munmap(cast(*u8, groups), ngroups * gstride * 8);
    mem.core.munmap(cast(*u8, lens), ga * 8);
    if (cachebits > 0) { mem.core.munmap(cast(*u8, cache), (1 << cachebits) * 8); }
    if (cast(i64, meta) != 0) { mem.core.munmap(cast(*u8, meta), metaw * _sub(h, metabits) * 8); }
    if (rc < 0) { return rc; }

    // ---- inverse transforms, LIFO ----
    let is i64 as bw with mut = cur_w;
    let is i64 as ti with mut = ntrans - 1;
    while (ti >= 0) {
        let is i64 as tt = ttype[ti];
        if (tt == 0) { _inv_predictor(buf, bw, h, cast(*i64, tdata[ti]), tbits[ti]); }
        else { if (tt == 1) { _inv_color(buf, bw, h, cast(*i64, tdata[ti]), tbits[ti]); }
        else { if (tt == 2) { _inv_subgreen(buf, bw * h); }
        else {
            let is i64 as ow = torigw[ti];
            let is i64 as xb = tbits[ti];
            let is *i64 as pal = cast(*i64, tdata[ti]);
            let is i64 as psz = tpalsz[ti];
            let is *i64 as nb = cast(*i64, mem.core.mmap_anon(ow * h * 8));
            if (cast(i64, nb) <= 0) { return errno.I_OOM; }
            let is i64 as bpp = 8 >> xb;
            let is i64 as msk = (1 << bpp) - 1;
            let is i64 as smask = (1 << xb) - 1;
            let is i64 as y2 with mut = 0;
            while (y2 < h) {
                let is i64 as x2 with mut = 0;
                while (x2 < ow) {
                    let is i64 as pk = buf[y2 * bw + (x2 >> xb)];
                    let is i64 as idx = ((pk >> 8) >> ((x2 & smask) * bpp)) & msk;
                    let is i64 as px with mut = 0;
                    if (idx < psz) { px = pal[idx]; }
                    nb[y2 * ow + x2] = px;
                    x2 = x2 + 1;
                }
                y2 = y2 + 1;
            }
            mem.core.munmap(cast(*u8, buf), bw * h * 8);
            buf = nb;
            bw = ow;
        } } }
        ti = ti - 1;
    }
    ti = 0;
    while (ti < ntrans) {
        if (tdata[ti] != 0) {
            let is i64 as tt = ttype[ti];
            if (tt <= 1) {
                let is i64 as tb = tbits[ti];
                mem.core.munmap(cast(*u8, tdata[ti]), _sub(torigw[ti], tb) * _sub(h, tb) * 8);
            } else {
                mem.core.munmap(cast(*u8, tdata[ti]), tpalsz[ti] * 8);
            }
        }
        ti = ti + 1;
    }
    if (bw != w) { mem.core.munmap(cast(*u8, buf), bw * h * 8); return errno.I_CORRUPT; }

    let is i64 as p with mut = 0;
    while (p < w * h) { outbuf[p] = buf[p]; p = p + 1; }
    mem.core.munmap(cast(*u8, buf), bw * h * 8);
    return 0;
}

// ---- ALPH (alpha) chunk ----------------------------------------------------
fn _grad_pred(a as i64, b2 as i64, c as i64) as i64 {
    let is i64 as g = a + b2 - c;
    if (g < 0) { return 0; }
    if (g > 255) { return 255; }
    return g;
}
// In-place unfilter of a w×h alpha plane (0 none, 1 horiz, 2 vert, 3 gradient).
fn _alph_unfilter(a as *u8, w as i64, h as i64, filter as i64) as void {
    if (filter == 0) { return; }
    let is i64 as row with mut = 0;
    while (row < h) {
        let is i64 as ro = row * w;
        let is i64 as prevo = ro - w;
        if (filter == 1) {                              // horizontal
            let is i64 as pred with mut = 0;
            if (row > 0) { pred = cast(i64, a[prevo]); }
            let is i64 as i with mut = 0;
            while (i < w) {
                let is i64 as v = (pred + cast(i64, a[ro + i])) & 255;
                a[ro + i] = cast(u8, v);
                pred = v;
                i = i + 1;
            }
        } else { if (filter == 2) {                     // vertical
            if (row == 0) {
                let is i64 as pred with mut = 0;
                let is i64 as i with mut = 0;
                while (i < w) { let is i64 as v = (pred + cast(i64, a[ro + i])) & 255; a[ro + i] = cast(u8, v); pred = v; i = i + 1; }
            } else {
                let is i64 as i with mut = 0;
                while (i < w) { a[ro + i] = cast(u8, (cast(i64, a[prevo + i]) + cast(i64, a[ro + i])) & 255); i = i + 1; }
            }
        } else {                                        // gradient
            if (row == 0) {
                let is i64 as pred with mut = 0;
                let is i64 as i with mut = 0;
                while (i < w) { let is i64 as v = (pred + cast(i64, a[ro + i])) & 255; a[ro + i] = cast(u8, v); pred = v; i = i + 1; }
            } else {
                let is i64 as left with mut = cast(i64, a[prevo]);
                let is i64 as topleft with mut = left;
                let is i64 as i with mut = 0;
                while (i < w) {
                    let is i64 as top = cast(i64, a[prevo + i]);
                    left = (cast(i64, a[ro + i]) + _grad_pred(left, top, topleft)) & 255;
                    topleft = top;
                    a[ro + i] = cast(u8, left);
                    i = i + 1;
                }
            }
        } }
        row = row + 1;
    }
}
// Decode an ALPH payload (`data`,`len`) of a w×h frame into `alpha` (w*h u8).
fn _alph_decode(data as *u8, len as i64, w as i64, h as i64, alpha as *u8) as i64 {
    if (len < 1) { return errno.I_CORRUPT; }
    let is i64 as hdr = cast(i64, data[0]);
    let is i64 as method = hdr & 3;
    let is i64 as filter = (hdr >> 2) & 3;
    let is i64 as rsv = (hdr >> 6) & 3;
    if (rsv != 0) { return errno.I_CORRUPT; }
    if (method > 1) { return errno.I_UNSUPPORTED; }
    let is *u8 as ad = cast(*u8, cast(i64, data) + 1);
    let is i64 as alen = len - 1;
    if (method == 0) {
        if (alen < w * h) { return errno.I_CORRUPT; }
        let is i64 as i with mut = 0;
        while (i < w * h) { alpha[i] = ad[i]; i = i + 1; }
    } else {
        let is br.BitReader as b;
        br.br_init(&b, ad, alen);
        let is *i64 as argb = cast(*i64, mem.core.mmap_anon(w * h * 8));
        if (cast(i64, argb) <= 0) { return errno.I_OOM; }
        let is i64 as rc = _vp8l_argb(&b, w, h, argb);
        if (rc < 0) { mem.core.munmap(cast(*u8, argb), w * h * 8); return rc; }
        let is i64 as i with mut = 0;
        while (i < w * h) { alpha[i] = cast(u8, (argb[i] >> 8) & 255); i = i + 1; }  // green = alpha
        mem.core.munmap(cast(*u8, argb), w * h * 8);
    }
    _alph_unfilter(alpha, w, h, filter);
    return 0;
}

// ---- top level ------------------------------------------------------------
fn webp_decode(src as *u8, src_len as i64, out as *image.Image) as i64 {
    if (src_len < 20) { return errno.I_BADMAGIC; }
    // RIFF container: "RIFF" size "WEBP" then fourcc chunks (may include VP8X).
    if (cast(i64, src[0]) != 82) { return errno.I_BADMAGIC; }
    if (cast(i64, src[8]) != 87) { return errno.I_BADMAGIC; }    // 'W'
    let is i64 as pos with mut = 12;
    let is i64 as vp8_off with mut = 0 - 1;
    let is i64 as vp8_len with mut = 0;
    let is i64 as vp8l_off with mut = 0 - 1;
    let is i64 as vp8l_len with mut = 0;
    let is i64 as alph_off with mut = 0 - 1;
    let is i64 as alph_len with mut = 0;
    let is i64 as walking with mut = 1;
    while (walking == 1) {
        if (pos + 8 > src_len) { walking = 0; }
        else {
            let is i64 as f0 = cast(i64, src[pos]);
            let is i64 as f1 = cast(i64, src[pos + 1]);
            let is i64 as f2 = cast(i64, src[pos + 2]);
            let is i64 as f3 = cast(i64, src[pos + 3]);
            let is i64 as csz = cast(i64, src[pos + 4]) | (cast(i64, src[pos + 5]) << 8)
                | (cast(i64, src[pos + 6]) << 16) | (cast(i64, src[pos + 7]) << 24);
            if (csz < 0) { walking = 0; }
            else {
                if (f0 == 86) { if (f1 == 80) { if (f2 == 56) {           // "VP8"
                    if (f3 == 76) { vp8l_off = pos + 8; vp8l_len = csz; }  // VP8L
                    if (f3 == 32) { vp8_off = pos + 8; vp8_len = csz; }    // VP8 (space)
                } } }
                if (f0 == 65) { if (f1 == 76) { if (f2 == 80) { if (f3 == 72) {   // "ALPH"
                    alph_off = pos + 8; alph_len = csz;
                } } } }
                pos = pos + 8 + csz + (csz & 1);
            }
        }
    }

    // VP8L is self-contained (carries its own alpha).
    if (vp8l_off >= 0) {
        if (vp8l_off + vp8l_len > src_len) { return errno.I_CORRUPT; }
        if (cast(i64, src[vp8l_off]) != 47) { return errno.I_CORRUPT; }   // 0x2f signature
        let is br.BitReader as b;
        br.br_init(&b, cast(*u8, cast(i64, src) + vp8l_off + 1), vp8l_len - 1);
        let is i64 as w = br.br_get(&b, 14) + 1;
        let is i64 as h = br.br_get(&b, 14) + 1;
        br.br_get(&b, 1);                              // alpha hint
        if (br.br_get(&b, 3) != 0) { return errno.I_UNSUPPORTED; }   // version
        if (image.image_check_dims(w, h, pixfmt.FMT_RGBA8) < 0) { return errno.I_DIMS; }
        let is *i64 as argb = cast(*i64, mem.core.mmap_anon(w * h * 8));
        if (cast(i64, argb) <= 0) { return errno.I_OOM; }
        let is i64 as rc = _vp8l_argb(&b, w, h, argb);
        if (rc < 0) { mem.core.munmap(cast(*u8, argb), w * h * 8); return rc; }
        let is i64 as ir = image.image_init(out, w, h, pixfmt.FMT_RGBA8);
        if (ir < 0) { mem.core.munmap(cast(*u8, argb), w * h * 8); return ir; }
        let is *u8 as dst = out.pixels;
        let is i64 as p2 with mut = 0;
        while (p2 < w * h) {
            let is i64 as px = argb[p2];
            dst[p2 * 4]     = cast(u8, (px >> 16) & 255);
            dst[p2 * 4 + 1] = cast(u8, (px >> 8) & 255);
            dst[p2 * 4 + 2] = cast(u8, px & 255);
            dst[p2 * 4 + 3] = cast(u8, (px >> 24) & 255);
            p2 = p2 + 1;
        }
        mem.core.munmap(cast(*u8, argb), w * h * 8);
        return 0;
    }

    // VP8 (lossy): RGB, with an optional ALPH alpha plane.
    if (vp8_off >= 0) {
        if (alph_off < 0) {
            return vp8.vp8_decode(cast(*u8, cast(i64, src) + vp8_off), vp8_len, out);
        }
        let is image.Image as rgb;
        let is i64 as rc = vp8.vp8_decode(cast(*u8, cast(i64, src) + vp8_off), vp8_len, &rgb);
        if (rc < 0) { return rc; }
        let is i64 as w = rgb.width;
        let is i64 as h = rgb.height;
        let is *u8 as alpha = mem.core.mmap_anon(w * h + 1);
        if (cast(i64, alpha) <= 0) { image.image_free(&rgb); return errno.I_OOM; }
        let is i64 as ar = _alph_decode(cast(*u8, cast(i64, src) + alph_off), alph_len, w, h, alpha);
        if (ar < 0) { image.image_free(&rgb); mem.core.munmap(alpha, w * h + 1); return ar; }
        let is i64 as ir = image.image_init(out, w, h, pixfmt.FMT_RGBA8);
        if (ir < 0) { image.image_free(&rgb); mem.core.munmap(alpha, w * h + 1); return ir; }
        let is i64 as p with mut = 0;
        while (p < w * h) {
            out.pixels[p * 4]     = rgb.pixels[p * 3];
            out.pixels[p * 4 + 1] = rgb.pixels[p * 3 + 1];
            out.pixels[p * 4 + 2] = rgb.pixels[p * 3 + 2];
            out.pixels[p * 4 + 3] = alpha[p];
            p = p + 1;
        }
        image.image_free(&rgb);
        mem.core.munmap(alpha, w * h + 1);
        return 0;
    }

    return errno.I_UNSUPPORTED;
}

// ============================ encoder =====================================
// VP8L (lossless) encoder — honest entropy tier: subtract-green transform +
// one group of canonical prefix codes (length-limited Huffman per channel),
// literal-coded pixels (no LZ77 / colour cache yet). Output is a conformant
// VP8L stream (browsers and libwebp decode it).
//   webp_encode(img, out) -> out.len, or negative (RGB8/RGBA8).

use "caustic-compact/core/bitwriter.cst" as bw;
use "caustic-compact/core/bytes.cst" as cbb;

// Length-limited Huffman: code lengths (<= maxlen) from symbol frequencies.
// Two-queue merge with frequency-halving retry when the depth overflows.
// Returns the number of used symbols.
fn _hlens(freq as *i64, n as i64, maxlen as i64, lens as *i64) as i64 {
    let is i64 as used with mut = 0;
    let is i64 as s with mut = 0;
    while (s < n) { lens[s] = 0; if (freq[s] > 0) { used = used + 1; } s = s + 1; }
    if (used == 0) { return 0; }
    if (used == 1) {
        s = 0;
        while (s < n) { if (freq[s] > 0) { lens[s] = 1; } s = s + 1; }
        return 1;
    }
    // working copy of freqs (for the halving retry)
    let is *i64 as wf = cast(*i64, mem.core.mmap_anon(n * 8));
    s = 0; while (s < n) { wf[s] = freq[s]; s = s + 1; }

    let is i64 as maxnodes = n * 2 + 2;
    let is *i64 as nf = cast(*i64, mem.core.mmap_anon(maxnodes * 8));   // node freq
    let is *i64 as np = cast(*i64, mem.core.mmap_anon(maxnodes * 8));   // parent
    let is *i64 as na = cast(*i64, mem.core.mmap_anon(maxnodes * 8));   // active flag
    let is *i64 as nsym = cast(*i64, mem.core.mmap_anon(maxnodes * 8)); // leaf symbol or -1
    if (cast(i64, nsym) <= 0) { return 0 - 1; }

    let is i64 as fits with mut = 0;
    while (fits == 0) {
        // build leaves
        let is i64 as nn with mut = 0;
        s = 0;
        while (s < n) {
            if (wf[s] > 0) {
                nf[nn] = wf[s]; np[nn] = 0 - 1; na[nn] = 1; nsym[nn] = s;
                nn = nn + 1;
            }
            s = s + 1;
        }
        let is i64 as roots with mut = nn;
        while (roots > 1) {
            // find two smallest active roots
            let is i64 as a with mut = 0 - 1;
            let is i64 as b with mut = 0 - 1;
            let is i64 as i with mut = 0;
            while (i < nn) {
                if (na[i] == 1) {
                    if (a < 0) { a = i; }
                    else { if (nf[i] < nf[a]) { b = a; a = i; }
                    else { if (b < 0) { b = i; } else { if (nf[i] < nf[b]) { b = i; } } } }
                }
                i = i + 1;
            }
            nf[nn] = nf[a] + nf[b]; np[nn] = 0 - 1; na[nn] = 1; nsym[nn] = 0 - 1;
            na[a] = 0; na[b] = 0; np[a] = nn; np[b] = nn;
            nn = nn + 1;
            roots = roots - 1;
        }
        // depths
        let is i64 as over with mut = 0;
        let is i64 as i with mut = 0;
        while (i < nn) {
            if (nsym[i] >= 0) {
                let is i64 as d with mut = 0;
                let is i64 as k with mut = i;
                while (np[k] >= 0) { d = d + 1; k = np[k]; }
                lens[nsym[i]] = d;
                if (d > maxlen) { over = 1; }
            }
            i = i + 1;
        }
        if (over == 0) { fits = 1; }
        else {
            // halve frequencies (keeping >=1) and retry
            s = 0;
            while (s < n) { if (wf[s] > 0) { wf[s] = (wf[s] + 1) >> 1; } s = s + 1; }
        }
    }
    mem.core.munmap(cast(*u8, wf), n * 8);
    mem.core.munmap(cast(*u8, nf), maxnodes * 8);
    mem.core.munmap(cast(*u8, np), maxnodes * 8);
    mem.core.munmap(cast(*u8, na), maxnodes * 8);
    mem.core.munmap(cast(*u8, nsym), maxnodes * 8);
    return used;
}

// Canonical code assignment (codes read MSB-first, shorter codes first,
// within a length by ascending symbol — the decoder's convention).
fn _canon(lens as *i64, n as i64, codes as *i64) as void {
    let is [16]i64 as cnt;
    let is i64 as l with mut = 0;
    while (l < 16) { cnt[l] = 0; l = l + 1; }
    let is i64 as s with mut = 0;
    while (s < n) { if (lens[s] > 0) { cnt[lens[s]] = cnt[lens[s]] + 1; } s = s + 1; }
    let is [16]i64 as next;
    let is i64 as code with mut = 0;
    l = 1;
    while (l < 16) { next[l] = code; code = (code + cnt[l]) << 1; l = l + 1; }
    s = 0;
    while (s < n) {
        if (lens[s] > 0) { codes[s] = next[lens[s]]; next[lens[s]] = next[lens[s]] + 1; }
        s = s + 1;
    }
}

// Write one prefix-code definition (simple for <=2 used symbols, else the
// code-length-coded path with zero-run RLE).
fn _write_htree(b as *bw.BitWriter, lens as *i64, n as i64, used as i64,
                freq as *i64) as void {
    if (used <= 2) {
        bw.bw_bits(b, 1, 1);                       // simple
        let is i64 as nsym with mut = used;
        if (nsym < 1) { nsym = 1; }
        bw.bw_bits(b, nsym - 1, 1);
        // collect the used symbols (or symbol 0 for an unused tree)
        let is i64 as s0 with mut = 0;
        let is i64 as s1 with mut = 0;
        let is i64 as found with mut = 0;
        let is i64 as s with mut = 0;
        while (s < n) {
            if (freq[s] > 0) {
                if (found == 0) { s0 = s; } else { s1 = s; }
                found = found + 1;
            }
            s = s + 1;
        }
        if (s0 <= 1) { bw.bw_bits(b, 0, 1); bw.bw_bits(b, s0, 1); }
        else { bw.bw_bits(b, 1, 1); bw.bw_bits(b, s0, 8); }
        if (nsym == 2) { bw.bw_bits(b, s1, 8); }
        return;
    }
    bw.bw_bits(b, 0, 1);                           // code-length-coded

    // RLE tokenization of the length sequence: literals 0..15, 17 (3-10 zeros),
    // 18 (11-138 zeros). (16 prev-repeat omitted for simplicity.)
    let is *i64 as toks = cast(*i64, mem.core.mmap_anon(n * 2 * 8));
    let is i64 as ntok with mut = 0;
    let is i64 as s with mut = 0;
    while (s < n) {
        if (lens[s] == 0) {
            let is i64 as run with mut = 0;
            while (s + run < n) {
                if (lens[s + run] != 0) { run = run + n; }   // break
                else { run = run + 1; }
            }
            if (run > n) { run = run - n; }
            let is i64 as left with mut = run;
            while (left > 0) {
                if (left >= 11) {
                    let is i64 as take with mut = left;
                    if (take > 138) { take = 138; }
                    toks[ntok * 2] = 18; toks[ntok * 2 + 1] = take - 11;
                    ntok = ntok + 1;
                    left = left - take;
                } else {
                    if (left >= 3) {
                        toks[ntok * 2] = 17; toks[ntok * 2 + 1] = left - 3;
                        ntok = ntok + 1;
                        left = 0;
                    } else {
                        let is i64 as k with mut = 0;
                        while (k < left) {
                            toks[ntok * 2] = 0; toks[ntok * 2 + 1] = 0;
                            ntok = ntok + 1;
                            k = k + 1;
                        }
                        left = 0;
                    }
                }
            }
            s = s + run;
        } else {
            toks[ntok * 2] = lens[s]; toks[ntok * 2 + 1] = 0;
            ntok = ntok + 1;
            s = s + 1;
        }
    }

    // CL-code Huffman over the token symbols (19-symbol alphabet, <=7 bits).
    let is [19]i64 as clf;
    let is i64 as i with mut = 0;
    while (i < 19) { clf[i] = 0; i = i + 1; }
    i = 0;
    while (i < ntok) { clf[toks[i * 2]] = clf[toks[i * 2] ] + 1; i = i + 1; }
    let is [19]i64 as cll;
    let is [19]i64 as clc;
    let is i64 as clused = _hlens(cast(*i64, &clf), 19, 7, cast(*i64, &cll));
    _canon(cast(*i64, &cll), 19, cast(*i64, &clc));
    // Emission lengths: a single-symbol CL tree decodes with ZERO bits per
    // token (its definition is still written with length 1 below).
    let is [19]i64 as cle;
    i = 0;
    while (i < 19) {
        cle[i] = cll[i];
        if (clused == 1) { cle[i] = 0; }
        i = i + 1;
    }

    // num_code_lengths: last nonzero position in kCodeLengthCodeOrder.
    let is i64 as numcl with mut = 4;
    i = 0;
    while (i < 19) {
        if (cll[cast(i64, _CLO[i])] != 0) { if (i + 1 > numcl) { numcl = i + 1; } }
        i = i + 1;
    }
    bw.bw_bits(b, numcl - 4, 4);
    i = 0;
    while (i < numcl) { bw.bw_bits(b, cll[cast(i64, _CLO[i])], 3); i = i + 1; }
    bw.bw_bits(b, 0, 1);                           // no max_symbol shortcut

    // emit tokens
    i = 0;
    while (i < ntok) {
        let is i64 as t = toks[i * 2];
        bw.bw_huff(b, clc[t], cle[t]);
        if (t == 17) { bw.bw_bits(b, toks[i * 2 + 1], 3); }
        if (t == 18) { bw.bw_bits(b, toks[i * 2 + 1], 7); }
        i = i + 1;
    }
    mem.core.munmap(cast(*u8, toks), n * 2 * 8);
}

// Write one literal-coded image stream (5 trees + per-pixel g,r,b,a codes).
// Channel arrays are the values to code (green may use 0..255 of its 280
// alphabet). The caller writes the cache/meta bits.
fn _enc_literal_stream(b as *bw.BitWriter, gs as *u8, rs as *u8, bs as *u8,
                       as2 as *u8, npx as i64) as i64 {
    let is [280]i64 as gf;
    let is [256]i64 as rf;
    let is [256]i64 as bf;
    let is [256]i64 as af;
    let is [40]i64 as df;
    let is i64 as i with mut = 0;
    while (i < 280) { gf[i] = 0; i = i + 1; }
    i = 0; while (i < 256) { rf[i] = 0; bf[i] = 0; af[i] = 0; i = i + 1; }
    i = 0; while (i < 40) { df[i] = 0; i = i + 1; }
    df[0] = 1;
    let is i64 as p with mut = 0;
    while (p < npx) {
        gf[cast(i64, gs[p])] = gf[cast(i64, gs[p])] + 1;
        rf[cast(i64, rs[p])] = rf[cast(i64, rs[p])] + 1;
        bf[cast(i64, bs[p])] = bf[cast(i64, bs[p])] + 1;
        af[cast(i64, as2[p])] = af[cast(i64, as2[p])] + 1;
        p = p + 1;
    }
    let is [280]i64 as gl; let is [280]i64 as gc;
    let is [256]i64 as rl; let is [256]i64 as rc;
    let is [256]i64 as bl2; let is [256]i64 as bc;
    let is [256]i64 as al; let is [256]i64 as ac;
    let is [40]i64 as dl; let is [40]i64 as dc;
    let is i64 as gu = _hlens(cast(*i64, &gf), 280, 15, cast(*i64, &gl));
    let is i64 as ru = _hlens(cast(*i64, &rf), 256, 15, cast(*i64, &rl));
    let is i64 as bu = _hlens(cast(*i64, &bf), 256, 15, cast(*i64, &bl2));
    let is i64 as au = _hlens(cast(*i64, &af), 256, 15, cast(*i64, &al));
    let is i64 as du = _hlens(cast(*i64, &df), 40, 15, cast(*i64, &dl));
    if (gu == 1) { i = 0; while (i < 280) { gl[i] = 0; i = i + 1; } }
    if (ru == 1) { i = 0; while (i < 256) { rl[i] = 0; i = i + 1; } }
    if (bu == 1) { i = 0; while (i < 256) { bl2[i] = 0; i = i + 1; } }
    if (au == 1) { i = 0; while (i < 256) { al[i] = 0; i = i + 1; } }
    _canon(cast(*i64, &gl), 280, cast(*i64, &gc));
    _canon(cast(*i64, &rl), 256, cast(*i64, &rc));
    _canon(cast(*i64, &bl2), 256, cast(*i64, &bc));
    _canon(cast(*i64, &al), 256, cast(*i64, &ac));
    _canon(cast(*i64, &dl), 40, cast(*i64, &dc));
    // tree definitions need lens with the single-symbol entry visible; rebuild
    // definitional lens from freq for the simple path (it uses freq directly).
    _write_htree(b, cast(*i64, &gl), 280, gu, cast(*i64, &gf));
    _write_htree(b, cast(*i64, &rl), 256, ru, cast(*i64, &rf));
    _write_htree(b, cast(*i64, &bl2), 256, bu, cast(*i64, &bf));
    _write_htree(b, cast(*i64, &al), 256, au, cast(*i64, &af));
    _write_htree(b, cast(*i64, &dl), 40, du, cast(*i64, &df));
    p = 0;
    while (p < npx) {
        let is i64 as g = cast(i64, gs[p]);
        bw.bw_huff(b, gc[g], gl[g]);
        let is i64 as r = cast(i64, rs[p]);
        bw.bw_huff(b, rc[r], rl[r]);
        let is i64 as v = cast(i64, bs[p]);
        bw.bw_huff(b, bc[v], bl2[v]);
        let is i64 as a = cast(i64, as2[p]);
        bw.bw_huff(b, ac[a], al[a]);
        p = p + 1;
    }
    return 0;
}

// Per-channel predictor value for `mode`, from already-final neighbour
// channel values (l, t, tl, tr each 0..255).
fn _predc(mode as i64, l as i64, t as i64, tl as i64, tr as i64) as i64 {
    if (mode == 0) { return 0; }
    if (mode == 1) { return l; }
    if (mode == 2) { return t; }
    if (mode == 3) { return tr; }
    if (mode == 4) { return tl; }
    if (mode == 5) { return (((l + tr) >> 1) + t) >> 1; }
    if (mode == 6) { return (l + tl) >> 1; }
    if (mode == 7) { return (l + t) >> 1; }
    if (mode == 8) { return (tl + t) >> 1; }
    if (mode == 9) { return (t + tr) >> 1; }
    if (mode == 10) { return (((l + tl) >> 1) + ((t + tr) >> 1)) >> 1; }
    // 11..13 need full-pixel context; handled by the caller (not offered here)
    return (l + t) >> 1;
}

// ---- LZ77 backward references -------------------------------------------
// This is what was missing, and it was the whole ballgame. A predictor plus a
// Huffman coder can only exploit *local* correlation; it has no way to say
// "these 300 pixels are the row above, again". On a UI screenshot that is
// almost all the redundancy there is, and its absence cost us a factor of 90
// against libwebp. LZ77 over the transformed pixel array supplies it.

let is i64 as _HB     with imut = 15;      // hash bits
let is i64 as _MINLEN with imut = 3;       // shorter copies lose to literals
let is i64 as _MAXLEN with imut = 4096;    // VP8L's ceiling

fn _hash3(argb as *i64, p as i64) as i64 {
    let is i64 as h = (argb[p] * 31 + argb[p + 1]) * 31 + argb[p + 2];
    return ((h >> 9) ^ (h >> 21)) & ((1 << _HB) - 1);
}

// Longest match at p. out[0] = length (0 if none worth taking), out[1] =
// distance. Does not touch the chain.
//
// The hash chain alone is not enough for image data. The distance that matters
// most in a picture is one row — and on a flat or gradient image every position
// hashes into the same handful of buckets, so a bounded chain walk only ever
// reaches the nearest few pixels and never gets back far enough to see the row
// above. So probe that distance directly, before the chain. It costs one
// comparison and it is the difference between compressing a gradient and not.
fn _lz_find(argb as *i64, npx as i64, p as i64, xsize as i64, maxchain as i64,
            head as *i64, prev as *i64, out as *i64) as void {
    out[0] = 0; out[1] = 0;
    if (p + _MINLEN > npx) { return; }
    let is i64 as maxl with mut = npx - p;
    if (maxl > _MAXLEN) { maxl = _MAXLEN; }
    let is i64 as blen with mut = 0;
    let is i64 as bdist with mut = 0;

    // The neighbourhood above, column by column. A gradient's residual repeats
    // the previous row *shifted by a column*, not the previous row itself, so
    // probing only `xsize` finds nothing; the useful distances are xsize +/- a
    // few. This is precisely the set VP8L's 2D distance codes are built to name
    // cheaply, which is the format telling us where to look.
    let is i64 as k with mut = 0 - 2;
    while (k <= 2) {
        let is i64 as d with mut = xsize + k;
        if (d >= 1 && d <= p) {
            let is i64 as l with mut = 0;
            while (l < maxl && argb[p - d + l] == argb[p + l]) { l = l + 1; }
            if (l > blen) { blen = l; bdist = d; }
        }
        d = 2 * xsize + k;
        if (d >= 1 && d <= p) {
            let is i64 as l2 with mut = 0;
            while (l2 < maxl && argb[p - d + l2] == argb[p + l2]) { l2 = l2 + 1; }
            if (l2 > blen) { blen = l2; bdist = d; }
        }
        k = k + 1;
    }

    let is i64 as hh = _hash3(argb, p);
    let is i64 as cand with mut = head[hh];
    let is i64 as chain with mut = 0;
    while (cand >= 0 && chain < maxchain && blen < maxl) {
        let is i64 as l with mut = 0;
        while (l < maxl && argb[cand + l] == argb[p + l]) { l = l + 1; }
        if (l > blen) { blen = l; bdist = p - cand; }
        cand = prev[cand];
        chain = chain + 1;
    }
    if (blen >= _MINLEN) { out[0] = blen; out[1] = bdist; }
}

fn _lz_insert(argb as *i64, npx as i64, p as i64, head as *i64, prev as *i64) as void {
    if (p + _MINLEN > npx) { return; }
    let is i64 as hh = _hash3(argb, p);
    prev[p] = head[hh];
    head[hh] = p;
}

// Parse the pixel array into tokens.
//   tk = 0 -> literal, ta = pixel index
//   tk = 1 -> copy,    ta = length, tb = distance
//   tk = 2 -> colour-cache hit, tb = cache index   (added later, by _apply_cache)
// Returns the token count.
fn _lz77(argb as *i64, npx as i64, xsize as i64, maxchain as i64, lazy as i64,
         tk as *u8, ta as *i64, tb as *i64) as i64 {
    let is i64 as HS = 1 << _HB;
    let is *i64 as head = cast(*i64, mem.core.mmap_anon(HS * 8));
    let is *i64 as prev = cast(*i64, mem.core.mmap_anon((npx + 1) * 8));
    if (cast(i64, prev) <= 0) { return 0 - 1; }
    mem.core.memset(cast(*u8, head), cast(i32, 0xFF), HS * 8);
    let is [2]i64 as m0;
    let is [2]i64 as m1;
    let is i64 as ntok with mut = 0;
    let is i64 as p with mut = 0;
    while (p < npx) {
        _lz_find(argb, npx, p, xsize, maxchain, head, prev, cast(*i64, &m0));
        _lz_insert(argb, npx, p, head, prev);
        let is i64 as take with mut = 0;
        if (m0[0] >= _MINLEN) {
            take = 1;
            // Lazy matching: a longer match one pixel later can be worth
            // spending a literal to reach.
            if (lazy == 1 && p + 1 < npx) {
                _lz_find(argb, npx, p + 1, xsize, maxchain, head, prev, cast(*i64, &m1));
                if (m1[0] > m0[0]) { take = 0; }
            }
        }
        if (take == 1) {
            tk[ntok] = cast(u8, 1); ta[ntok] = m0[0]; tb[ntok] = m0[1];
            ntok = ntok + 1;
            let is i64 as k with mut = p + 1;
            while (k < p + m0[0]) { _lz_insert(argb, npx, k, head, prev); k = k + 1; }
            p = p + m0[0];
        } else {
            tk[ntok] = cast(u8, 0); ta[ntok] = p; tb[ntok] = 0;
            ntok = ntok + 1;
            p = p + 1;
        }
    }
    mem.core.munmap(cast(*u8, head), HS * 8);
    mem.core.munmap(cast(*u8, prev), (npx + 1) * 8);
    return ntok;
}

// Turn literals into colour-cache references wherever the cache already holds
// the pixel. The cache must be driven exactly as the decoder drives it — every
// emitted pixel is inserted, including each pixel of a copy and the hit itself
// — or the two sides diverge. Both start zeroed, so a run of transparent black
// at the top of the image legitimately hits an entry nobody wrote.
fn _apply_cache(argb as *i64, tk as *u8, ta as *i64, tb as *i64, ntok as i64,
                cachebits as i64) as void {
    if (cachebits == 0) { return; }
    let is i64 as csz = 1 << cachebits;
    let is *i64 as cache = cast(*i64, mem.core.mmap_anon(csz * 8));
    let is i64 as cshift = 32 - cachebits;
    let is i64 as p with mut = 0;
    let is i64 as i with mut = 0;
    while (i < ntok) {
        if (cast(i64, tk[i]) == 0) {
            let is i64 as v = argb[p];
            let is i64 as hh = ((v * 506832829) & 0xFFFFFFFF) >> cshift;
            if (cache[hh] == v) { tk[i] = cast(u8, 2); tb[i] = hh; }
            cache[hh] = v;
            p = p + 1;
        } else {
            let is i64 as k with mut = 0;
            while (k < ta[i]) {
                let is i64 as v = argb[p + k];
                cache[((v * 506832829) & 0xFFFFFFFF) >> cshift] = v;
                k = k + 1;
            }
            p = p + ta[i];
        }
        i = i + 1;
    }
    mem.core.munmap(cast(*u8, cache), csz * 8);
}

// VP8L prefix code for a 1-based value: out[0] = symbol, out[1] = extra bit
// count, out[2] = extra value. The exact inverse of the decoder's _prefix_val.
fn _prefix_enc(v as i64, out as *i64) as void {
    if (v <= 4) { out[0] = v - 1; out[1] = 0; out[2] = 0; return; }
    let is i64 as u = v - 1;
    let is i64 as m with mut = 0;
    while ((1 << (m + 1)) <= u) { m = m + 1; }        // floor(log2(u)), >= 2
    let is i64 as half = 1 << (m - 1);
    let is i64 as three = 3 * half;
    if (u < three) { out[0] = 2 * m;     out[1] = m - 1; out[2] = u - (1 << m); }
    else           { out[0] = 2 * m + 1; out[1] = m - 1; out[2] = u - three; }
}

// Pixel distance -> VP8L distance code. Codes 1..120 name a small 2D
// neighbourhood (so "one row up" is cheap regardless of width); anything else
// is the raw distance plus 120. The decoder owns that mapping in _plane_dist,
// so rather than carry a second table that could drift out of sync, invert it:
// take the smallest code that reproduces this exact distance.
fn _dist_code(dist as i64, w as i64) as i64 {
    let is i64 as c with mut = 1;
    while (c <= 120) {
        if (_plane_dist(c, w) == dist) { return c; }
        c = c + 1;
    }
    return dist + 120;
}

// Write one LZ77-coded image stream: five prefix codes, then the tokens.
// The caller has already written the colour-cache and meta-prefix headers.
fn _enc_lz_stream(b as *bw.BitWriter, argb as *i64, npx as i64, xsize as i64,
                  cachebits as i64, maxchain as i64, lazy as i64) as i64 {
    let is i64 as csz with mut = 0;
    if (cachebits > 0) { csz = 1 << cachebits; }
    let is i64 as gsz = 280 + csz;

    let is *u8 as tk = mem.core.mmap_anon(npx + 1);
    let is *i64 as ta = cast(*i64, mem.core.mmap_anon((npx + 1) * 8));
    let is *i64 as tb = cast(*i64, mem.core.mmap_anon((npx + 1) * 8));
    if (cast(i64, tb) <= 0) { return errno.I_OOM; }
    let is i64 as ntok = _lz77(argb, npx, xsize, maxchain, lazy, tk, ta, tb);
    if (ntok < 0) { return errno.I_OOM; }
    _apply_cache(argb, tk, ta, tb, ntok, cachebits);

    let is *i64 as gf = cast(*i64, mem.core.mmap_anon(gsz * 8));
    let is [256]i64 as rf;
    let is [256]i64 as bf;
    let is [256]i64 as af;
    let is [40]i64 as df;
    let is i64 as i with mut = 0;
    while (i < 256) { rf[i] = 0; bf[i] = 0; af[i] = 0; i = i + 1; }
    i = 0; while (i < 40) { df[i] = 0; i = i + 1; }

    let is [3]i64 as pe;
    i = 0;
    while (i < ntok) {
        let is i64 as t = cast(i64, tk[i]);
        if (t == 0) {
            let is i64 as v = argb[ta[i]];
            let is i64 as g = (v >> 8) & 255;
            gf[g] = gf[g] + 1;
            rf[(v >> 16) & 255] = rf[(v >> 16) & 255] + 1;
            bf[v & 255] = bf[v & 255] + 1;
            af[(v >> 24) & 255] = af[(v >> 24) & 255] + 1;
        } else {
            if (t == 1) {
                _prefix_enc(ta[i], cast(*i64, &pe));
                gf[256 + pe[0]] = gf[256 + pe[0]] + 1;
                _prefix_enc(_dist_code(tb[i], xsize), cast(*i64, &pe));
                df[pe[0]] = df[pe[0]] + 1;
            } else {
                gf[280 + tb[i]] = gf[280 + tb[i]] + 1;
            }
        }
        i = i + 1;
    }

    let is *i64 as gl = cast(*i64, mem.core.mmap_anon(gsz * 8));
    let is *i64 as gc = cast(*i64, mem.core.mmap_anon(gsz * 8));
    let is [256]i64 as rl; let is [256]i64 as rc;
    let is [256]i64 as bl2; let is [256]i64 as bc;
    let is [256]i64 as al; let is [256]i64 as ac;
    let is [40]i64 as dl; let is [40]i64 as dc;
    let is i64 as gu = _hlens(gf, gsz, 15, gl);
    let is i64 as ru = _hlens(cast(*i64, &rf), 256, 15, cast(*i64, &rl));
    let is i64 as bu = _hlens(cast(*i64, &bf), 256, 15, cast(*i64, &bl2));
    let is i64 as au = _hlens(cast(*i64, &af), 256, 15, cast(*i64, &al));
    let is i64 as du = _hlens(cast(*i64, &df), 40, 15, cast(*i64, &dl));
    // A one-symbol tree costs zero bits per symbol, so its emission lengths
    // must be cleared or the writer would spend real bits on a certainty.
    if (gu == 1) { i = 0; while (i < gsz) { gl[i] = 0; i = i + 1; } }
    if (ru == 1) { i = 0; while (i < 256) { rl[i] = 0; i = i + 1; } }
    if (bu == 1) { i = 0; while (i < 256) { bl2[i] = 0; i = i + 1; } }
    if (au == 1) { i = 0; while (i < 256) { al[i] = 0; i = i + 1; } }
    if (du == 1) { i = 0; while (i < 40) { dl[i] = 0; i = i + 1; } }
    _canon(gl, gsz, gc);
    _canon(cast(*i64, &rl), 256, cast(*i64, &rc));
    _canon(cast(*i64, &bl2), 256, cast(*i64, &bc));
    _canon(cast(*i64, &al), 256, cast(*i64, &ac));
    _canon(cast(*i64, &dl), 40, cast(*i64, &dc));

    _write_htree(b, gl, gsz, gu, gf);
    _write_htree(b, cast(*i64, &rl), 256, ru, cast(*i64, &rf));
    _write_htree(b, cast(*i64, &bl2), 256, bu, cast(*i64, &bf));
    _write_htree(b, cast(*i64, &al), 256, au, cast(*i64, &af));
    _write_htree(b, cast(*i64, &dl), 40, du, cast(*i64, &df));

    i = 0;
    while (i < ntok) {
        let is i64 as t = cast(i64, tk[i]);
        if (t == 0) {
            let is i64 as v = argb[ta[i]];
            let is i64 as g = (v >> 8) & 255;
            let is i64 as r = (v >> 16) & 255;
            let is i64 as bl = v & 255;
            let is i64 as a = (v >> 24) & 255;
            bw.bw_huff(b, gc[g], gl[g]);
            bw.bw_huff(b, rc[r], rl[r]);
            bw.bw_huff(b, bc[bl], bl2[bl]);
            bw.bw_huff(b, ac[a], al[a]);
        } else {
            if (t == 1) {
                _prefix_enc(ta[i], cast(*i64, &pe));
                let is i64 as gs2 = 256 + pe[0];
                bw.bw_huff(b, gc[gs2], gl[gs2]);
                if (pe[1] > 0) { bw.bw_bits(b, pe[2], pe[1]); }
                _prefix_enc(_dist_code(tb[i], xsize), cast(*i64, &pe));
                bw.bw_huff(b, dc[pe[0]], dl[pe[0]]);
                if (pe[1] > 0) { bw.bw_bits(b, pe[2], pe[1]); }
            } else {
                let is i64 as cs = 280 + tb[i];
                bw.bw_huff(b, gc[cs], gl[cs]);
            }
        }
        i = i + 1;
    }

    mem.core.munmap(tk, npx + 1);
    mem.core.munmap(cast(*u8, ta), (npx + 1) * 8);
    mem.core.munmap(cast(*u8, tb), (npx + 1) * 8);
    mem.core.munmap(cast(*u8, gf), gsz * 8);
    mem.core.munmap(cast(*u8, gl), gsz * 8);
    mem.core.munmap(cast(*u8, gc), gsz * 8);
    return 0;
}

fn _webp_riff(pay as *cbb.Bytes, out as *cbb.Bytes) as i64 {
    let is i64 as vlen = pay.len;
    let is i64 as riff_size = 4 + 8 + vlen + (vlen & 1);
    cbb.bytes_push(out, cast(u8, 82)); cbb.bytes_push(out, cast(u8, 73));
    cbb.bytes_push(out, cast(u8, 70)); cbb.bytes_push(out, cast(u8, 70));   // RIFF
    cbb.bytes_push(out, cast(u8, riff_size & 255));
    cbb.bytes_push(out, cast(u8, (riff_size >> 8) & 255));
    cbb.bytes_push(out, cast(u8, (riff_size >> 16) & 255));
    cbb.bytes_push(out, cast(u8, (riff_size >> 24) & 255));
    cbb.bytes_push(out, cast(u8, 87)); cbb.bytes_push(out, cast(u8, 69));
    cbb.bytes_push(out, cast(u8, 66)); cbb.bytes_push(out, cast(u8, 80));   // WEBP
    cbb.bytes_push(out, cast(u8, 86)); cbb.bytes_push(out, cast(u8, 80));
    cbb.bytes_push(out, cast(u8, 56)); cbb.bytes_push(out, cast(u8, 76));   // VP8L
    cbb.bytes_push(out, cast(u8, vlen & 255));
    cbb.bytes_push(out, cast(u8, (vlen >> 8) & 255));
    cbb.bytes_push(out, cast(u8, (vlen >> 16) & 255));
    cbb.bytes_push(out, cast(u8, (vlen >> 24) & 255));
    cbb.bytes_append(out, pay.ptr, pay.len);
    if ((vlen & 1) == 1) { cbb.bytes_push(out, cast(u8, 0)); }
    return out.len;
}

fn _vp8l_hdr(b as *bw.BitWriter, w as i64, h as i64, alpha_used as i64) as void {
    bw.bw_bits(b, w - 1, 14);
    bw.bw_bits(b, h - 1, 14);
    bw.bw_bits(b, alpha_used, 1);
    bw.bw_bits(b, 0, 3);                           // version
}
// The general configuration: subtract-green, then a per-tile spatial predictor,
// then LZ77 + colour cache + Huffman over the residuals. This is what wins on
// photographs and anything with more than 256 colours.
fn _std_payload(img as *image.Image, cachebits as i64, maxchain as i64,
                lazy as i64, out as *cbb.Bytes) as i64 {
    let is i64 as ch with mut = 0;
    if (img.fmt == pixfmt.FMT_RGB8)  { ch = 3; }
    if (img.fmt == pixfmt.FMT_RGBA8) { ch = 4; }
    if (ch == 0) { return errno.I_UNSUPPORTED; }
    let is i64 as w = img.width;
    let is i64 as h = img.height;
    let is i64 as npx = w * h;
    let is *u8 as px = img.pixels;

    // Subtract-green, on packed ARGB. The predictor then runs over whole pixels
    // rather than four independent channels, which is what lets modes 11-13
    // exist at all: Select compares the *pixel* distances to its neighbours.
    let is *i64 as sg = cast(*i64, mem.core.mmap_anon(npx * 8));
    if (cast(i64, sg) <= 0) { return errno.I_OOM; }
    let is i64 as alpha_used with mut = 0;
    let is i64 as y0 with mut = 0;
    while (y0 < h) {
        let is i64 as o = y0 * img.stride;
        let is i64 as x0 with mut = 0;
        while (x0 < w) {
            let is i64 as r = cast(i64, px[o + x0 * ch]);
            let is i64 as g = cast(i64, px[o + x0 * ch + 1]);
            let is i64 as bl = cast(i64, px[o + x0 * ch + 2]);
            let is i64 as a with mut = 255;
            if (ch == 4) { a = cast(i64, px[o + x0 * ch + 3]); }
            if (a != 255) { alpha_used = 1; }
            sg[y0 * w + x0] = (a << 24) | (((r - g) & 255) << 16) | (g << 8) | ((bl - g) & 255);
            x0 = x0 + 1;
        }
        y0 = y0 + 1;
    }

    // ---- predictor transform: best of the 14 modes per 16x16 tile ----
    let is i64 as pbits = 4;
    let is i64 as ptw = _sub(w, pbits);
    let is i64 as pth = _sub(h, pbits);
    let is i64 as pn = ptw * pth;
    let is *u8 as modes = mem.core.mmap_anon(pn + 1);
    let is *i64 as targb = cast(*i64, mem.core.mmap_anon(npx * 8));
    if (cast(i64, targb) <= 0) { return errno.I_OOM; }

    let is i64 as ty with mut = 0;
    while (ty < pth) {
        let is i64 as tx with mut = 0;
        while (tx < ptw) {
            let is i64 as best with mut = 0;
            let is i64 as bestcost with mut = 0 - 1;
            let is i64 as m with mut = 0;
            while (m < 14) {
                let is i64 as cost with mut = 0;
                let is i64 as y with mut = ty << pbits;
                while (y < ((ty + 1) << pbits) && y < h) {
                    let is i64 as x with mut = tx << pbits;
                    while (x < ((tx + 1) << pbits) && x < w) {
                        let is i64 as p = y * w + x;
                        let is i64 as pr = _pred_at(sg, w, p, x, y, m);
                        let is i64 as s with mut = 0;
                        while (s < 32) {
                            let is i64 as d with mut = (((sg[p] >> s) & 255) - ((pr >> s) & 255)) & 255;
                            if (d > 128) { d = 256 - d; }
                            cost = cost + d;
                            s = s + 8;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                if (bestcost < 0 || cost < bestcost) { bestcost = cost; best = m; }
                m = m + 1;
            }
            modes[ty * ptw + tx] = cast(u8, best);
            tx = tx + 1;
        }
        ty = ty + 1;
    }

    let is i64 as y2 with mut = 0;
    while (y2 < h) {
        let is i64 as x2 with mut = 0;
        while (x2 < w) {
            let is i64 as p = y2 * w + x2;
            let is i64 as m = cast(i64, modes[(y2 >> pbits) * ptw + (x2 >> pbits)]);
            let is i64 as pr = _pred_at(sg, w, p, x2, y2, m);
            let is i64 as v with mut = 0;
            let is i64 as s with mut = 0;
            while (s < 32) {
                v = v | (((((sg[p] >> s) & 255) - ((pr >> s) & 255)) & 255) << s);
                s = s + 8;
            }
            targb[p] = v;
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }

    // ---- VP8L payload ----
    let is cbb.Bytes as pay = cbb.bytes_new(npx + 4096);
    cbb.bytes_push(&pay, cast(u8, 47));            // 0x2f signature
    let is bw.BitWriter as b;
    bw.bw_init(&b, &pay);
    _vp8l_hdr(&b, w, h, alpha_used);
    bw.bw_bits(&b, 1, 1);                          // transform present
    bw.bw_bits(&b, 2, 2);                          // SUBTRACT_GREEN
    bw.bw_bits(&b, 1, 1);                          // another transform
    bw.bw_bits(&b, 0, 2);                          // PREDICTOR
    bw.bw_bits(&b, pbits - 2, 3);                  // size_bits
    // predictor image substream: the mode rides in the green channel
    let is *u8 as z0 = mem.core.mmap_anon(pn + 1);
    let is *u8 as z255 = mem.core.mmap_anon(pn + 1);
    if (cast(i64, z255) <= 0) { return errno.I_OOM; }
    mem.core.memset(z0, cast(i32, 0), pn);
    mem.core.memset(z255, cast(i32, 255), pn);
    bw.bw_bits(&b, 0, 1);                          // aux: no colour cache
    _enc_literal_stream(&b, modes, z0, z0, z255, pn);
    bw.bw_bits(&b, 0, 1);                          // no more transforms
    if (cachebits > 0) { bw.bw_bits(&b, 1, 1); bw.bw_bits(&b, cachebits, 4); }
    else { bw.bw_bits(&b, 0, 1); }
    bw.bw_bits(&b, 0, 1);                          // no meta-Huffman
    _enc_lz_stream(&b, targb, npx, w, cachebits, maxchain, lazy);
    bw.bw_align(&b);

    mem.core.munmap(cast(*u8, sg), npx * 8);
    mem.core.munmap(cast(*u8, targb), npx * 8);
    mem.core.munmap(modes, pn + 1);
    mem.core.munmap(z0, pn + 1); mem.core.munmap(z255, pn + 1);

    let is i64 as r2 = _webp_riff(&pay, out);
    cbb.bytes_free(&pay);
    return r2;
}


// ---- palette (colour-indexing) configuration -----------------------------
// The other half of the UI/icon story. An eight-colour screenshot coded as
// full ARGB asks the entropy coder to rediscover, pixel by pixel, that only
// eight values ever occur. Naming them once and coding indices instead — and
// then packing 2, 4 or 8 indices into a pixel when the palette is small enough
// — is the single biggest lever VP8L has on synthetic images.

// Distinct colours, or -1 past 256. Fills pal[] with what it found.
fn _webp_palette(img as *image.Image, pal as *i64) as i64 {
    let is i64 as ch with mut = 3;
    if (img.fmt == pixfmt.FMT_RGBA8) { ch = 4; }
    let is *u8 as px = img.pixels;
    let is i64 as HN with imut = 1024;
    let is *i64 as slot = cast(*i64, mem.core.mmap_anon(HN * 8));
    mem.core.memset(cast(*u8, slot), cast(i32, 0), HN * 8);
    let is i64 as n with mut = 0;
    let is i64 as y with mut = 0;
    while (y < img.height) {
        let is i64 as o = y * img.stride;
        let is i64 as x with mut = 0;
        while (x < img.width) {
            let is i64 as a with mut = 255;
            if (ch == 4) { a = cast(i64, px[o + x * ch + 3]); }
            let is i64 as v = (a << 24) | (cast(i64, px[o + x * ch]) << 16)
                            | (cast(i64, px[o + x * ch + 1]) << 8)
                            | cast(i64, px[o + x * ch + 2]);
            let is i64 as hh with mut = ((v * 2654435761) >> 12) & (HN - 1);
            let is i64 as placed with mut = 0;
            while (placed == 0) {
                let is i64 as s = slot[hh];
                if (s == 0) {
                    if (n >= 256) {
                        mem.core.munmap(cast(*u8, slot), HN * 8);
                        return 0 - 1;
                    }
                    pal[n] = v; slot[hh] = n + 1; n = n + 1; placed = 1;
                } else {
                    if (pal[s - 1] == v) { placed = 1; }
                    else { hh = (hh + 1) & (HN - 1); }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    mem.core.munmap(cast(*u8, slot), HN * 8);
    return n;
}

// The palette is stored delta-coded, entry to entry, so its order is not free:
// reordering it to minimise consecutive deltas shrinks the stored palette. This
// is libwebp's greedy nearest-neighbour walk, with RGB weighted over alpha.
fn _pal_dist(c1 as i64, c2 as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as k with mut = 0;
    while (k < 3) {
        let is i64 as d with mut = ((c1 >> (k * 8)) - (c2 >> (k * 8))) & 255;
        if (d > 128) { d = 256 - d; }
        s = s + d;
        k = k + 1;
    }
    s = s * 9;
    let is i64 as da with mut = ((c1 >> 24) - (c2 >> 24)) & 255;
    if (da > 128) { da = 256 - da; }
    return s + da;
}

fn _pal_sort(pal as *i64, n as i64) as void {
    let is i64 as predict with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as bi with mut = i;
        let is i64 as bs with mut = 0 - 1;
        let is i64 as k with mut = i;
        while (k < n) {
            let is i64 as s = _pal_dist(pal[k], predict);
            if (bs < 0 || s < bs) { bs = s; bi = k; }
            k = k + 1;
        }
        let is i64 as t = pal[bi]; pal[bi] = pal[i]; pal[i] = t;
        predict = pal[i];
        i = i + 1;
    }
}

fn _pal_payload(img as *image.Image, pal as *i64, n as i64, cachebits as i64,
                maxchain as i64, lazy as i64, out as *cbb.Bytes) as i64 {
    let is i64 as w = img.width;
    let is i64 as h = img.height;
    let is i64 as ch with mut = 3;
    if (img.fmt == pixfmt.FMT_RGBA8) { ch = 4; }

    // Small palettes let several indices share one coded pixel.
    let is i64 as xbits with mut = 0;
    if (n <= 2)      { xbits = 3; }
    else if (n <= 4) { xbits = 2; }
    else if (n <= 16){ xbits = 1; }
    let is i64 as cw = _sub(w, xbits);
    let is i64 as cn = cw * h;

    let is i64 as alpha_used with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { if (((pal[i] >> 24) & 255) != 255) { alpha_used = 1; } i = i + 1; }

    let is *i64 as idx = cast(*i64, mem.core.mmap_anon(cn * 8));
    if (cast(i64, idx) <= 0) { return errno.I_OOM; }
    let is *u8 as px = img.pixels;
    let is i64 as bitdepth = 1 << (3 - xbits);
    let is i64 as mask = (1 << xbits) - 1;
    let is i64 as y with mut = 0;
    while (y < h) {
        let is i64 as o = y * img.stride;
        let is i64 as code with mut = 4278190080;          // 0xff000000
        let is i64 as x with mut = 0;
        while (x < w) {
            let is i64 as a with mut = 255;
            if (ch == 4) { a = cast(i64, px[o + x * ch + 3]); }
            let is i64 as v = (a << 24) | (cast(i64, px[o + x * ch]) << 16)
                            | (cast(i64, px[o + x * ch + 1]) << 8)
                            | cast(i64, px[o + x * ch + 2]);
            let is i64 as k with mut = 0;
            while (k < n) { if (pal[k] == v) { k = k + 1024; } else { k = k + 1; } }
            let is i64 as id = k - 1024;                   // index we settled on
            let is i64 as xsub = x & mask;
            if (xsub == 0) { code = 4278190080; }
            code = code | (id << (8 + bitdepth * xsub));
            idx[y * cw + (x >> xbits)] = code;
            x = x + 1;
        }
        y = y + 1;
    }

    let is cbb.Bytes as pay = cbb.bytes_new(cn + 4096);
    cbb.bytes_push(&pay, cast(u8, 47));
    let is bw.BitWriter as b;
    bw.bw_init(&b, &pay);
    _vp8l_hdr(&b, w, h, alpha_used);
    bw.bw_bits(&b, 1, 1);                          // transform present
    bw.bw_bits(&b, 3, 2);                          // COLOR_INDEXING
    bw.bw_bits(&b, n - 1, 8);
    // The palette itself is an n x 1 sub-image, delta-coded entry to entry.
    let is *u8 as pg = mem.core.mmap_anon(n + 1);
    let is *u8 as pr = mem.core.mmap_anon(n + 1);
    let is *u8 as pb = mem.core.mmap_anon(n + 1);
    let is *u8 as pa = mem.core.mmap_anon(n + 1);
    if (cast(i64, pa) <= 0) { return errno.I_OOM; }
    i = 0;
    while (i < n) {
        let is i64 as cur = pal[i];
        let is i64 as pv with mut = 0;
        if (i > 0) { pv = pal[i - 1]; }
        pg[i] = cast(u8, ((cur >> 8) - (pv >> 8)) & 255);
        pr[i] = cast(u8, ((cur >> 16) - (pv >> 16)) & 255);
        pb[i] = cast(u8, (cur - pv) & 255);
        pa[i] = cast(u8, ((cur >> 24) - (pv >> 24)) & 255);
        i = i + 1;
    }
    bw.bw_bits(&b, 0, 1);                          // palette sub-image: no cache
    _enc_literal_stream(&b, pg, pr, pb, pa, n);
    bw.bw_bits(&b, 0, 1);                          // no more transforms
    if (cachebits > 0) { bw.bw_bits(&b, 1, 1); bw.bw_bits(&b, cachebits, 4); }
    else { bw.bw_bits(&b, 0, 1); }
    bw.bw_bits(&b, 0, 1);                          // no meta-Huffman
    _enc_lz_stream(&b, idx, cn, cw, cachebits, maxchain, lazy);
    bw.bw_align(&b);

    mem.core.munmap(pg, n + 1); mem.core.munmap(pr, n + 1);
    mem.core.munmap(pb, n + 1); mem.core.munmap(pa, n + 1);
    mem.core.munmap(cast(*u8, idx), cn * 8);
    let is i64 as r = _webp_riff(&pay, out);
    cbb.bytes_free(&pay);
    return r;
}

// Encode a lossless WebP. The engine decides how hard we look: FAST takes the
// first plausible configuration, DEFAULT and BEST encode several and keep the
// smallest — because which of "palette" and "predictor + subtract-green" wins
// is a property of the image, not something a heuristic can be trusted to call.
fn webp_encode_ex(img as *image.Image, out as *cbb.Bytes, o as *opts.EncOpts) as i64 {
    if (img.fmt != pixfmt.FMT_RGB8 && img.fmt != pixfmt.FMT_RGBA8) {
        return errno.I_UNSUPPORTED;
    }
    let is i64 as maxchain with mut = 32;
    let is i64 as lazy with mut = 1;
    if (o.engine == opts.ENG_FAST) { maxchain = 8; lazy = 0; }
    if (o.engine == opts.ENG_BEST) { maxchain = 192; }

    // Colour-cache sizes worth trying. The cache turns a repeated pixel into a
    // single small symbol, so it pays on images with a modest palette and
    // nothing at all on photographs; the only honest way to pick is to try.
    let is [5]i64 as cbs;
    let is i64 as ncb with mut = 1;
    cbs[0] = 0;
    if (o.engine != opts.ENG_FAST) {
        cbs[1] = 4; cbs[2] = 6; cbs[3] = 8; cbs[4] = 10;
        ncb = 5;
    }

    let is *i64 as pal = cast(*i64, mem.core.mmap_anon(256 * 8));
    let is i64 as npal = _webp_palette(img, pal);
    if (npal > 0) { _pal_sort(pal, npal); }

    let is cbb.Bytes as best with mut = cbb.bytes_new(1024);
    let is i64 as have with mut = 0;
    let is i64 as ci with mut = 0;
    while (ci < ncb) {
        let is cbb.Bytes as t1 = cbb.bytes_new(1024);
        if (_std_payload(img, cbs[ci], maxchain, lazy, &t1) > 0) {
            if (have == 0 || t1.len < best.len) { cbb.bytes_free(&best); best = t1; have = 1; }
            else { cbb.bytes_free(&t1); }
        } else { cbb.bytes_free(&t1); }
        if (npal > 0) {
            let is cbb.Bytes as t2 = cbb.bytes_new(1024);
            if (_pal_payload(img, pal, npal, cbs[ci], maxchain, lazy, &t2) > 0) {
                if (have == 0 || t2.len < best.len) { cbb.bytes_free(&best); best = t2; have = 1; }
                else { cbb.bytes_free(&t2); }
            } else { cbb.bytes_free(&t2); }
        }
        ci = ci + 1;
    }
    mem.core.munmap(cast(*u8, pal), 256 * 8);
    if (have == 0) { cbb.bytes_free(&best); return errno.I_OOM; }
    cbb.bytes_append(out, best.ptr, best.len);
    cbb.bytes_free(&best);
    return out.len;
}

fn webp_encode(img as *image.Image, out as *cbb.Bytes) as i64 {
    let is opts.EncOpts as o;
    opts.enc_defaults(&o);
    return webp_encode_ex(img, out, &o);
}
