// =======================================================
// caustic-image/csif/container.cst
// The CSIF container (byte-exact, spec §1) plus the RAW codec (§5.1) for a
// single-item, single-tile, 8-bit UINT8 interleaved image. This is the first
// end-to-end CSIF slice: encode an Image to a valid .csif and decode it back
// bit-exact.
//
// File = [header 64B][directory chunk_count×32B][framed chunks][pad]. Every
// chunk is [type 4][flags 4][payload_length 8][payload][crc32 4]. CRC-32 is
// reused from caustic-compact. Colour is carried in an ICOL chunk with the
// mandatory CICP block (§2.1); "Unspecified" (2) is rejected loudly.
//
//   csif_encode(img, out) -> out.len, or negative E_CSIF_*.
//   csif_decode(src, len, out) -> 0, or negative E_CSIF_*.
// =======================================================

use "std/mem.cst" only bins, core as mem;
use "../core/image.cst"  as image;
use "../core/pixfmt.cst" as pixfmt;
use "../core/buf.cst"    as buf;
use "../formats/qoi.cst" as qoi;
use "modular.cst"        as modular;
use "dctc.cst"           as dctc;
use "errno.cst"          as ce;
use "caustic-compact/core/bytes.cst"    as cb;
use "caustic-compact/core/checksum.cst" as checksum;

// ---- little-endian append helpers ----
fn _w8(o as *cb.Bytes, v as i64)  as void { cb.bytes_push(o, cast(u8, v & 255)); }
fn _w16(o as *cb.Bytes, v as i64) as void { _w8(o, v); _w8(o, v >> 8); }
fn _w32(o as *cb.Bytes, v as i64) as void { _w8(o, v); _w8(o, v >> 8); _w8(o, v >> 16); _w8(o, v >> 24); }
fn _w64(o as *cb.Bytes, v as i64) as void { _w32(o, v); _w32(o, v >> 32); }
fn _wz(o as *cb.Bytes, n as i64)  as void { let is i64 as i with mut = 0; while (i < n) { _w8(o, 0); i = i + 1; } }

fn _align8(x as i64) as i64 { return ((x + 7) / 8) * 8; }

// Frame one chunk into `c`: [type][flags][payload_length][payload][crc32].
fn _emit_chunk(c as *cb.Bytes, typ as *u8, flags as i64, payload as *u8, plen as i64) as void {
    cb.bytes_push(c, typ[0]); cb.bytes_push(c, typ[1]); cb.bytes_push(c, typ[2]); cb.bytes_push(c, typ[3]);
    _w32(c, flags);
    _w64(c, plen);
    cb.bytes_append(c, payload, plen);
    let is i64 as crc = checksum.crc32(c.ptr, c.len);
    _w32(c, crc);
}

// Frame one chunk into a growing staging buffer; returns its start offset.
// (Unlike _emit_chunk, the CRC covers only this chunk's own bytes.)
fn _emit_chunk_into(s as *cb.Bytes, typ as *u8, flags as i64, payload as *u8, plen as i64) as i64 {
    let is i64 as start = s.len;
    cb.bytes_push(s, typ[0]); cb.bytes_push(s, typ[1]); cb.bytes_push(s, typ[2]); cb.bytes_push(s, typ[3]);
    _w32(s, flags);
    _w64(s, plen);
    cb.bytes_append(s, payload, plen);
    let is i64 as crc = checksum.crc32(cast(*u8, cast(i64, s.ptr) + start), s.len - start);
    _w32(s, crc);
    return start;
}

// Run one codec's decoder over a coded unit into `dst`.
fn _codec_decode(codbytes as *u8, codlen as i64, w as i64, h as i64, ch as i64,
                 bps as i64, codec_id as i64, dst as *u8) as i64 {
    if (codec_id == 0) {
        if (codlen != w * h * ch * bps) { return ce.E_CSIF_PAYLOAD_TRUNC; }
        mem.core.memcpy(dst, codbytes, codlen);
        return 0;
    }
    if (codec_id == 1) {
        if (qoi.qoi_tile_decode(codbytes, codlen, w * h, ch, dst) < 0) { return ce.E_CSIF_PAYLOAD_TRUNC; }
        return 0;
    }
    if (codec_id == 2) {
        if (modular.modular_decode(codbytes, codlen, w, h, ch, bps, dst) < 0) { return ce.E_CSIF_PAYLOAD_TRUNC; }
        return 0;
    }
    if (dctc.dct_decode(codbytes, codlen, w, h, ch, dst) < 0) { return ce.E_CSIF_PAYLOAD_TRUNC; }
    return 0;
}

// Map Image format to (color_model, channels), or channels=0 if unsupported.
fn _fmt_axes(fmt as i64, cm as *i64, ch as *i64) as void {
    cm[0] = 0; ch[0] = 0;
    if (fmt == pixfmt.FMT_GRAY8)   { cm[0] = 0; ch[0] = 1; }
    if (fmt == pixfmt.FMT_GRAYA8)  { cm[0] = 1; ch[0] = 2; }
    if (fmt == pixfmt.FMT_RGB8)    { cm[0] = 2; ch[0] = 3; }
    if (fmt == pixfmt.FMT_RGBA8)   { cm[0] = 3; ch[0] = 4; }
    if (fmt == pixfmt.FMT_GRAY16)  { cm[0] = 0; ch[0] = 1; }
    if (fmt == pixfmt.FMT_GRAYA16) { cm[0] = 1; ch[0] = 2; }
    if (fmt == pixfmt.FMT_RGB16)   { cm[0] = 2; ch[0] = 3; }
    if (fmt == pixfmt.FMT_RGBA16)  { cm[0] = 3; ch[0] = 4; }
}

// ---- payload builders ----
fn _pl_ilim(p as *cb.Bytes) as void {
    // 23 u64 ceilings — generous BASELINE defaults.
    _w64(p, 65536); _w64(p, 65536); _w64(p, 268435456); _w64(p, 268435456);   // w,h,pixels,tile_pixels
    _w64(p, 1073741824); _w64(p, 16); _w64(p, 64); _w64(p, 1073741824);       // alloc,comp,aux,chunk
    _w64(p, 1024); _w64(p, 65536); _w64(p, 32); _w64(p, 65536);               // items,tiles,mips,frames
    _w64(p, 64); _w64(p, 32); _w64(p, 64); _w64(p, 64);                       // refslots,derdepth,derfanin,estreams
    _w64(p, 262144); _w64(p, 4096); _w64(p, 65536); _w64(p, 65536);           // matree,palette,patches,splines
    _w64(p, 1048576); _w64(p, 16777216); _w64(p, 256);                        // splinepts,metabytes,manifests
}

fn _pl_ihdr(p as *cb.Bytes, img as *image.Image, cm as i64, ch as i64) as void {
    let is i64 as w = img.width;
    let is i64 as h = img.height;
    let is i64 as alpha_mode with mut = 0;
    if (cm == 1) { alpha_mode = 1; }   // GRAYA straight
    if (cm == 3) { alpha_mode = 1; }   // RGBA straight
    _w64(p, 0);            // item_id
    _w32(p, w);           // width
    _w32(p, h);           // height
    _w32(p, 1);           // depth
    _w8(p, 0);            // sample_format UINT8
    _w8(p, 0);            // sample_endian LE
    _w8(p, pixfmt.fmt_depth(img.fmt));   // bit_depth (8 or 16)
    _w8(p, 0);            // sample_layout FLAT
    _w8(p, cm);           // color_model
    _w8(p, ch);           // component_count
    _w8(p, 1);            // chroma_h_subsample
    _w8(p, 1);            // chroma_v_subsample
    _w8(p, 0);            // chroma_sample_position N/A
    _w8(p, alpha_mode);   // alpha_mode
    _w8(p, 0);            // orientation
    _w8(p, 0);            // reserved0
    _w32(p, 0); _w32(p, 0); _w32(p, w); _w32(p, h);   // display_window {x,y,w,h}
    _w32(p, 0); _w32(p, 0); _w32(p, w); _w32(p, h);   // data_window
    _w32(p, 1); _w32(p, 1);                            // pixel_aspect_ratio {num,den}
    _w32(p, 0);                                        // intensity_target_nits f32 = 0.0
}

fn _pl_icol(p as *cb.Bytes) as void {
    _w64(p, 0);      // item_id
    _w8(p, 0);       // color_authority CICP
    _w8(p, 1);       // color_primaries BT.709/sRGB
    _w8(p, 13);      // transfer_function sRGB
    _w8(p, 0);       // matrix_coefficients Identity (required for RGB/Gray)
    _w8(p, 1);       // full_range
    _w8(p, 0);       // chroma_sample_position
    _w8(p, 1);       // h_subsample
    _w8(p, 1);       // v_subsample
}

fn _pl_icod(p as *cb.Bytes, codec_id as i64, ch as i64,
            tw as i64, th as i64, ntx as i64, nty as i64) as void {
    _w64(p, 0);      // item_id
    _w16(p, codec_id);
    _w16(p, 1);      // codec_version
    let is i64 as lossless with mut = 1;
    if (codec_id == 3) { lossless = 0; }   // DCT is lossy
    _w8(p, lossless);
    _w8(p, 0);       // color_transform NONE
    _w8(p, 0);       // supercompress_id
    _w8(p, 0);       // cross_tile_prediction
    _w32(p, tw); _w32(p, th);      // tile size (0 = full image)
    _w32(p, ntx); _w32(p, nty);    // tile grid
    _w32(p, 1); _w32(p, 1);        // n_resolution_levels, n_quality_layers
    _w32(p, 0);                    // progression_order NONE
    let is i64 as em with mut = 3;         // entropy_method_id: raw
    if (codec_id >= 2) { em = 0; }         // MODULAR/DCT use rANS
    _w16(p, em);
    _w8(p, 0);                     // sub_image_count
    _w8(p, 0);                     // reserved0
    if (codec_id == 1) {
        _w32(p, 4);                // QOI params_length
        // has_alpha, channels_premul, reserved(u16)
        let is i64 as has_alpha with mut = 0;
        if (ch == 4) { has_alpha = 1; }
        _w8(p, has_alpha); _w8(p, 0); _w16(p, 0);
    } else {
        if (codec_id == 2) { _w32(p, 0); }         // MODULAR-lite: no params
        else {
            if (codec_id == 3) { _w32(p, 0); }     // DCT-lite: fixed quant, no params
            else {
                _w32(p, 8);        // RAW params_length
                _w8(p, 1); _w8(p, 0); _w8(p, 1); _wz(p, 5);
            }
        }
    }
}

fn _pl_idat(p as *cb.Bytes, img as *image.Image, codec_id as i64, ch as i64) as void {
    _w64(p, 0);      // item_id
    _w32(p, 0);      // idat_index
    _w32(p, 0);      // coord_kind WHOLE
    _w32(p, 0); _w32(p, 0); _w32(p, 0); _w32(p, 0);   // coords
    if (codec_id == 1) {
        qoi.qoi_tile_encode(img.pixels, img.width * img.height, ch, p);
    } else {
        if (codec_id == 2) {
            modular.modular_encode(img, p);
        } else {
            if (codec_id == 3) {
                dctc.dct_encode(img, p);
            } else {
                // RAW codec bytes: interleaved UINT8 pixels, contiguous.
                cb.bytes_append(p, img.pixels, img.stride * img.height);
            }
        }
    }
}

// Encode with the RAW codec (codec 0) — works for any 8-bit format.
fn csif_encode(img as *image.Image, out as *cb.Bytes) as i64 {
    return csif_encode_ex(img, out, 0);
}

// Single-tile encode with an explicit codec (0=RAW, 1=QOI, 2=MODULAR, 3=DCT).
fn csif_encode_ex(img as *image.Image, out as *cb.Bytes, codec_id as i64) as i64 {
    return csif_encode_tiled(img, out, codec_id, 0, 0);
}

// Run one codec's encoder over a (tile) image, appending its bytes to `p`.
fn _codec_encode(img as *image.Image, codec_id as i64, ch as i64, p as *cb.Bytes) as i64 {
    if (codec_id == 1) { return qoi.qoi_tile_encode(img.pixels, img.width * img.height, ch, p); }
    if (codec_id == 2) { return modular.modular_encode(img, p); }
    if (codec_id == 3) { return dctc.dct_encode(img, p); }
    return cb.bytes_append(p, img.pixels, img.stride * img.height);   // RAW
}

// Tiled encode: tw/th = tile size in pixels (0 = single whole-image tile).
// Tiles are independently decodable (codec state resets per tile, §5.0.3);
// a TIDX chunk records each tile's byte range + CRC when tiled.
fn csif_encode_tiled(img as *image.Image, out as *cb.Bytes, codec_id as i64,
                     tw_in as i64, th_in as i64) as i64 {
    let is [1]i64 as cmv;
    let is [1]i64 as chv;
    _fmt_axes(img.fmt, cast(*i64, &cmv), cast(*i64, &chv));
    let is i64 as cm = cmv[0];
    let is i64 as ch = chv[0];
    if (ch == 0) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; }
    if (codec_id == 1) { if (ch != 3) { if (ch != 4) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; } } }
    // QOI/DCT are 8-bit only; RAW/MODULAR handle 16-bit too.
    if (pixfmt.fmt_depth(img.fmt) != 8) {
        if (codec_id == 1) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; }
        if (codec_id == 3) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; }
    }
    let is i64 as tw with mut = tw_in;
    let is i64 as th with mut = th_in;
    if (tw < 1) { tw = 0; th = 0; }
    let is i64 as ntx with mut = 1;
    let is i64 as nty with mut = 1;
    if (tw > 0) {
        ntx = (img.width + tw - 1) / tw;
        nty = (img.height + th - 1) / th;
    }
    let is i64 as tiled with mut = 0;
    if (ntx * nty > 1) { tiled = 1; }

    let is i64 as ntiles = ntx * nty;
    if (ntiles > 4096) { return ce.E_CSIF_LIMIT; }
    let is i64 as nchunks with mut = 6;
    if (tiled == 1) { nchunks = 7; }

    // Build the framed chunks (ILIM IHDR ICOL ICOD IDAT [TIDX] IEND).
    let is cb.Bytes as p = cb.bytes_new(4096);
    let is cb.Bytes as c0 = cb.bytes_new(256);
    let is cb.Bytes as c1 = cb.bytes_new(128);
    let is cb.Bytes as c2 = cb.bytes_new(64);
    let is cb.Bytes as c3 = cb.bytes_new(128);
    let is cb.Bytes as c4 = cb.bytes_new(256);
    let is cb.Bytes as ctx = cb.bytes_new(64);
    let is cb.Bytes as c5 = cb.bytes_new(64);
    cb.bytes_reset(&p); _pl_ilim(&p);          _emit_chunk(&c0, "ILIM", 11, p.ptr, p.len);
    cb.bytes_reset(&p); _pl_ihdr(&p, img, cm, ch); _emit_chunk(&c1, "IHDR", 27, p.ptr, p.len);
    cb.bytes_reset(&p); _pl_icol(&p);          _emit_chunk(&c2, "ICOL", 27, p.ptr, p.len);
    cb.bytes_reset(&p); _pl_icod(&p, codec_id, ch, tw, th, ntx, nty); _emit_chunk(&c3, "ICOD", 27, p.ptr, p.len);

    // IDAT payload: 32-byte head + tile streams (one stream when untiled).
    let is *i64 as trel with mut = cast(*i64, 0);
    let is *i64 as tsz with mut = cast(*i64, 0);
    let is *i64 as tcrc with mut = cast(*i64, 0);
    cb.bytes_reset(&p);
    if (tiled == 0) {
        _pl_idat(&p, img, codec_id, ch);
    } else {
        trel = cast(*i64, mem.core.mmap_anon(ntiles * 8));
        tsz  = cast(*i64, mem.core.mmap_anon(ntiles * 8));
        tcrc = cast(*i64, mem.core.mmap_anon(ntiles * 8));
        if (cast(i64, tcrc) <= 0) { return ce.E_CSIF_LIMIT; }
        _w64(&p, 0); _w32(&p, 0); _w32(&p, 0);
        _w32(&p, 0); _w32(&p, 0); _w32(&p, 0); _w32(&p, 0);   // head (32B)
        let is i64 as ti with mut = 0;
        let is i64 as ty with mut = 0;
        while (ty < nty) {
            let is i64 as tx with mut = 0;
            while (tx < ntx) {
                let is i64 as tweff with mut = tw;
                if (tx * tw + tweff > img.width) { tweff = img.width - tx * tw; }
                let is i64 as theff with mut = th;
                if (ty * th + theff > img.height) { theff = img.height - ty * th; }
                let is image.Image as tile;
                if (image.image_init(&tile, tweff, theff, img.fmt) < 0) { return ce.E_CSIF_LIMIT; }
                let is i64 as r with mut = 0;
                while (r < theff) {
                    mem.core.memcpy(image.image_row(&tile, r),
                        cast(*u8, cast(i64, img.pixels) + (ty * th + r) * img.stride + tx * tw * ch),
                        tweff * ch);
                    r = r + 1;
                }
                let is i64 as start = p.len;
                _codec_encode(&tile, codec_id, ch, &p);
                image.image_free(&tile);
                trel[ti] = start - 32;
                tsz[ti] = p.len - start;
                tcrc[ti] = checksum.crc32(cast(*u8, cast(i64, p.ptr) + start), p.len - start);
                ti = ti + 1;
                tx = tx + 1;
            }
            ty = ty + 1;
        }
    }
    _emit_chunk(&c4, "IDAT", 51, p.ptr, p.len);
    cb.bytes_reset(&p); _w64(&p, 0);           _emit_chunk(&c5, "IEND", 11, p.ptr, p.len);

    // Lay out offsets (8-byte aligned) after header + directory.
    let is i64 as o0 = 64 + nchunks * 32;
    let is i64 as o1 = _align8(o0 + c0.len);
    let is i64 as o2 = _align8(o1 + c1.len);
    let is i64 as o3 = _align8(o2 + c2.len);
    let is i64 as o4 = _align8(o3 + c3.len);
    let is i64 as o5 with mut = _align8(o4 + c4.len);
    let is i64 as otx with mut = 0;
    if (tiled == 1) {
        // TIDX needs IDAT's absolute codec-bytes offset (chunk + 16B header + 32B head).
        let is i64 as idat_abs = o4 + 16 + 32;
        cb.bytes_reset(&p);
        _w64(&p, 0);                 // item_id
        _w32(&p, ntiles);            // entry_count
        _w8(&p, 1); _wz(&p, 3);      // integrity_algo CRC32 + reserved
        let is i64 as ti with mut = 0;
        let is i64 as ty with mut = 0;
        while (ty < nty) {
            let is i64 as tx with mut = 0;
            while (tx < ntx) {
                let is i64 as tweff with mut = tw;
                if (tx * tw + tweff > img.width) { tweff = img.width - tx * tw; }
                let is i64 as theff with mut = th;
                if (ty * th + theff > img.height) { theff = img.height - ty * th; }
                _w32(&p, tx); _w32(&p, ty);
                _w64(&p, idat_abs + trel[ti]);
                _w64(&p, tsz[ti]);
                _w64(&p, tweff * theff * ch);
                _w32(&p, tcrc[ti]);
                _w32(&p, 1);          // flags: independently decodable
                ti = ti + 1;
                tx = tx + 1;
            }
            ty = ty + 1;
        }
        _emit_chunk(&ctx, "TIDX", 27, p.ptr, p.len);
        otx = o5;
        o5 = _align8(otx + ctx.len);
    }
    let is i64 as file_size = _align8(o5 + c5.len);

    // Header (64 bytes).
    cb.bytes_push(out, cast(u8, 67)); cb.bytes_push(out, cast(u8, 83));
    cb.bytes_push(out, cast(u8, 73)); cb.bytes_push(out, cast(u8, 70));   // "CSIF"
    _w8(out, 137); _w8(out, 13); _w8(out, 10); _w8(out, 26); _w8(out, 10); _w8(out, 0);  // probe
    _w16(out, 1);        // version
    _w8(out, 0);         // container_endian
    _w8(out, 1);         // arch_hint x86_64
    _w8(out, 0);         // layout RANDOM
    _w8(out, 1);         // checksum_algo CRC32-IEEE
    _w8(out, 0);         // profile BASELINE
    _w8(out, 1);         // level
    _w16(out, 0);        // header_flags
    _w32(out, nchunks);  // chunk_count
    _w64(out, 64);       // directory_offset
    _w64(out, file_size);
    _w64(out, 0);        // primary_item_id
    _w64(out, 0);        // directory_offset_tail
    let is i64 as hcrc = checksum.crc32(out.ptr, 56);
    _w64(out, hcrc);     // header_crc (low 32 = crc)

    // Directory (6 × 32B): type, flags, offset, length, seq, reserved.
    _emit_dir(out, "ILIM", 11, o0, c0.len, 0);
    _emit_dir(out, "IHDR", 27, o1, c1.len, 1);
    _emit_dir(out, "ICOL", 27, o2, c2.len, 2);
    _emit_dir(out, "ICOD", 27, o3, c3.len, 3);
    _emit_dir(out, "IDAT", 51, o4, c4.len, 4);
    if (tiled == 1) {
        _emit_dir(out, "TIDX", 27, otx, ctx.len, 5);
        _emit_dir(out, "IEND", 11, o5, c5.len, 6);
    } else {
        _emit_dir(out, "IEND", 11, o5, c5.len, 5);
    }

    // Chunks, each padded to the next 8-byte offset.
    cb.bytes_append(out, c0.ptr, c0.len); _wz(out, o1 - (o0 + c0.len));
    cb.bytes_append(out, c1.ptr, c1.len); _wz(out, o2 - (o1 + c1.len));
    cb.bytes_append(out, c2.ptr, c2.len); _wz(out, o3 - (o2 + c2.len));
    cb.bytes_append(out, c3.ptr, c3.len); _wz(out, o4 - (o3 + c3.len));
    if (tiled == 1) {
        cb.bytes_append(out, c4.ptr, c4.len); _wz(out, otx - (o4 + c4.len));
        cb.bytes_append(out, ctx.ptr, ctx.len); _wz(out, o5 - (otx + ctx.len));
    } else {
        cb.bytes_append(out, c4.ptr, c4.len); _wz(out, o5 - (o4 + c4.len));
    }
    cb.bytes_append(out, c5.ptr, c5.len); _wz(out, file_size - (o5 + c5.len));

    if (tiled == 1) {
        mem.core.munmap(cast(*u8, trel), ntiles * 8);
        mem.core.munmap(cast(*u8, tsz), ntiles * 8);
        mem.core.munmap(cast(*u8, tcrc), ntiles * 8);
    }
    cb.bytes_free(&p);
    cb.bytes_free(&c0); cb.bytes_free(&c1); cb.bytes_free(&c2);
    cb.bytes_free(&c3); cb.bytes_free(&c4); cb.bytes_free(&c5);
    cb.bytes_free(&ctx);
    return out.len;
}

fn _emit_dir(out as *cb.Bytes, typ as *u8, flags as i64, off as i64, len as i64, seq as i64) as void {
    cb.bytes_push(out, typ[0]); cb.bytes_push(out, typ[1]); cb.bytes_push(out, typ[2]); cb.bytes_push(out, typ[3]);
    _w32(out, flags);
    _w64(out, off);
    _w64(out, len);
    _w32(out, seq);
    _w32(out, 0);
}

// ---- decode ----
fn _is(t0 as i64, t1 as i64, t2 as i64, t3 as i64, s as *u8) as i64 {
    if (t0 != cast(i64, s[0])) { return 0; }
    if (t1 != cast(i64, s[1])) { return 0; }
    if (t2 != cast(i64, s[2])) { return 0; }
    if (t3 != cast(i64, s[3])) { return 0; }
    return 1;
}

fn csif_decode(src as *u8, len as i64, out as *image.Image) as i64 {
    if (len < 64) { return ce.E_CSIF_TOO_SMALL; }
    let is buf.Buf as bf;
    buf.buf_init(&bf, src, len);

    // Header.
    if (_is(buf.buf_u8(&bf), buf.buf_u8(&bf), buf.buf_u8(&bf), buf.buf_u8(&bf), "CSIF") == 0) { return ce.E_CSIF_MAGIC; }
    if (buf.buf_u8(&bf) != 137) { return ce.E_CSIF_TRANSMISSION; }
    if (buf.buf_u8(&bf) != 13)  { return ce.E_CSIF_TRANSMISSION; }
    if (buf.buf_u8(&bf) != 10)  { return ce.E_CSIF_TRANSMISSION; }
    if (buf.buf_u8(&bf) != 26)  { return ce.E_CSIF_TRANSMISSION; }
    if (buf.buf_u8(&bf) != 10)  { return ce.E_CSIF_TRANSMISSION; }
    if (buf.buf_u8(&bf) != 0)   { return ce.E_CSIF_TRANSMISSION; }
    if (buf.buf_u16le(&bf) != 1) { return ce.E_CSIF_VERSION; }
    if (buf.buf_u8(&bf) != 0)    { return ce.E_CSIF_ENDIAN; }
    buf.buf_u8(&bf);                                   // arch_hint
    buf.buf_u8(&bf);                                   // layout
    let is i64 as cksum_algo = buf.buf_u8(&bf);
    buf.buf_u8(&bf);                                   // profile
    buf.buf_u8(&bf);                                   // level
    buf.buf_u16le(&bf);                                // header_flags
    let is i64 as chunk_count = buf.buf_u32le(&bf);
    let is i64 as dir_off = buf.buf_u64le(&bf);
    let is i64 as file_size = buf.buf_u64le(&bf);
    if (file_size != len) { return ce.E_CSIF_TRUNCATED; }
    buf.buf_u64le(&bf);                                // primary_item_id
    buf.buf_u64le(&bf);                                // directory_offset_tail
    let is i64 as hcrc = buf.buf_u64le(&bf);
    if (cksum_algo != 0) {
        if (checksum.crc32(src, 56) != (hcrc & 0xFFFFFFFF)) { return ce.E_CSIF_HEADER_CRC; }
    }
    if (dir_off < 64) { return ce.E_CSIF_DIR_RANGE; }
    if (dir_off + chunk_count * 32 > len) { return ce.E_CSIF_DIR_RANGE; }

    // Walk the directory, validate + verify each chunk, capture payload offsets.
    let is i64 as ihdr_off with mut = 0 - 1;
    let is i64 as icol_off with mut = 0 - 1;
    let is i64 as icod_off with mut = 0 - 1;
    let is i64 as idat_off with mut = 0 - 1;
    let is i64 as idat_plen with mut = 0;
    let is i64 as tidx_off with mut = 0 - 1;

    let is i64 as di with mut = 0;
    while (di < chunk_count) {
        buf.buf_seek(&bf, dir_off + di * 32);
        let is i64 as dt0 = buf.buf_u8(&bf); let is i64 as dt1 = buf.buf_u8(&bf);
        let is i64 as dt2 = buf.buf_u8(&bf); let is i64 as dt3 = buf.buf_u8(&bf);
        let is i64 as dflags = buf.buf_u32le(&bf);
        let is i64 as coff = buf.buf_u64le(&bf);
        let is i64 as clen = buf.buf_u64le(&bf);
        // buf_seek would already reject an out-of-range dir entry via EOF reads.
        if (coff < 64) { return ce.E_CSIF_RANGE; }
        if (coff + clen > len) { return ce.E_CSIF_RANGE; }

        // Chunk header.
        buf.buf_seek(&bf, coff);
        let is i64 as t0 = buf.buf_u8(&bf); let is i64 as t1 = buf.buf_u8(&bf);
        let is i64 as t2 = buf.buf_u8(&bf); let is i64 as t3 = buf.buf_u8(&bf);
        let is i64 as cflags = buf.buf_u32le(&bf);
        let is i64 as plen = buf.buf_u64le(&bf);
        if (dt0 != t0) { return ce.E_CSIF_FLAG_MISMATCH; }
        if (dflags != cflags) { return ce.E_CSIF_FLAG_MISMATCH; }
        let is i64 as critical = cflags & 1;

        // CRC over [type..payload] = the 16-byte header + payload.
        if (cksum_algo != 0) {
            let is i64 as body = 16 + plen;
            if (coff + body + 4 > len) { return ce.E_CSIF_RANGE; }
            let is i64 as calc = checksum.crc32(cast(*u8, cast(i64, src) + coff), body);
            let is buf.Buf as cb2;
            buf.buf_init(&cb2, src, len);
            buf.buf_seek(&cb2, coff + body);
            let is i64 as stored = buf.buf_u32le(&cb2);
            if (calc != stored) {
                if (critical == 1) { return ce.E_CSIF_CRC_CRITICAL; }
            }
        }

        let is i64 as poff = coff + 16;
        if (_is(t0,t1,t2,t3, "IHDR") == 1) { ihdr_off = poff; }
        else { if (_is(t0,t1,t2,t3, "ICOL") == 1) { icol_off = poff; }
        else { if (_is(t0,t1,t2,t3, "ICOD") == 1) { icod_off = poff; }
        // First IDAT wins: in an animated file that is the primary item (frame 0),
        // so a still-only reader renders the canonical default rendition (§9.5.4).
        else { if (_is(t0,t1,t2,t3, "IDAT") == 1) {
            if (idat_off < 0) { idat_off = poff; idat_plen = plen; }
        }
        else { if (_is(t0,t1,t2,t3, "TIDX") == 1) { tidx_off = poff; }
        else { if (_is(t0,t1,t2,t3, "ILIM") == 1) { }
        else { if (_is(t0,t1,t2,t3, "IEND") == 1) { }
        else {
            // Unknown type: fail only if critical.
            if (critical == 1) { return ce.E_CSIF_UNKNOWN_CRITICAL; }
        } } } } } } }
        di = di + 1;
    }

    if (ihdr_off < 0) { return ce.E_CSIF_ORDER; }
    if (icod_off < 0) { return ce.E_CSIF_ORDER; }
    if (idat_off < 0) { return ce.E_CSIF_ORDER; }

    // Parse IHDR.
    buf.buf_seek(&bf, ihdr_off);
    buf.buf_u64le(&bf);                       // item_id
    let is i64 as w = buf.buf_u32le(&bf);
    let is i64 as h = buf.buf_u32le(&bf);
    buf.buf_u32le(&bf);                       // depth
    let is i64 as sample_format = buf.buf_u8(&bf);
    buf.buf_u8(&bf);                          // sample_endian
    let is i64 as bit_depth = buf.buf_u8(&bf);
    buf.buf_u8(&bf);                          // sample_layout
    let is i64 as color_model = buf.buf_u8(&bf);
    let is i64 as component_count = buf.buf_u8(&bf);
    if (sample_format != 0) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; }   // RAW-uint8 path

    // Parse ICOL: enforce the anti-"Unspecified" + matrix rules.
    if (icol_off >= 0) {
        buf.buf_seek(&bf, icol_off);
        buf.buf_u64le(&bf);                   // item_id
        buf.buf_u8(&bf);                      // color_authority
        let is i64 as prim = buf.buf_u8(&bf);
        let is i64 as trc = buf.buf_u8(&bf);
        let is i64 as mtx = buf.buf_u8(&bf);
        if (prim == 2) { return ce.E_CSIF_COLOR_UNSPECIFIED; }
        if (trc == 2)  { return ce.E_CSIF_COLOR_UNSPECIFIED; }
        if (mtx == 2)  { return ce.E_CSIF_COLOR_UNSPECIFIED; }
        // RGB/Gray must use Identity matrix.
        if (color_model <= 3) { if (mtx != 0) { return ce.E_CSIF_COLOR_MATRIX_MISMATCH; } }
    }

    // Parse ICOD: codec dispatch id + tile geometry.
    buf.buf_seek(&bf, icod_off);
    buf.buf_u64le(&bf);                       // item_id
    let is i64 as codec_id = buf.buf_u16le(&bf);
    if (codec_id != 0) { if (codec_id != 1) { if (codec_id != 2) { if (codec_id != 3) { return ce.E_CSIF_UNKNOWN_CODEC; } } } }
    if (codec_id == 1) { if (component_count != 3) { if (component_count != 4) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; } } }
    buf.buf_u16le(&bf);                       // codec_version
    buf.buf_u8(&bf);                          // is_lossless
    buf.buf_u8(&bf);                          // color_transform
    buf.buf_u8(&bf);                          // supercompress_id
    buf.buf_u8(&bf);                          // cross_tile_prediction
    let is i64 as tw = buf.buf_u32le(&bf);
    let is i64 as th = buf.buf_u32le(&bf);
    let is i64 as ntx = buf.buf_u32le(&bf);
    let is i64 as nty = buf.buf_u32le(&bf);

    // Resolve the pixel format from color_model + component_count + bit_depth.
    let is i64 as fmt with mut = 0;
    if (bit_depth == 8) {
        if (color_model == 0) { if (component_count == 1) { fmt = pixfmt.FMT_GRAY8; } }
        if (color_model == 1) { if (component_count == 2) { fmt = pixfmt.FMT_GRAYA8; } }
        if (color_model == 2) { if (component_count == 3) { fmt = pixfmt.FMT_RGB8; } }
        if (color_model == 3) { if (component_count == 4) { fmt = pixfmt.FMT_RGBA8; } }
    } else {
        if (bit_depth == 16) {
            if (color_model == 0) { if (component_count == 1) { fmt = pixfmt.FMT_GRAY16; } }
            if (color_model == 1) { if (component_count == 2) { fmt = pixfmt.FMT_GRAYA16; } }
            if (color_model == 2) { if (component_count == 3) { fmt = pixfmt.FMT_RGB16; } }
            if (color_model == 3) { if (component_count == 4) { fmt = pixfmt.FMT_RGBA16; } }
        }
    }
    if (fmt == 0) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; }

    // QOI/DCT are 8-bit only; RAW/MODULAR handle 16-bit too.
    let is i64 as bpsamp = bit_depth / 8;                  // bytes per sample (1 or 2)
    if (codec_id == 1) { if (bit_depth != 8) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; } }
    if (codec_id == 3) { if (bit_depth != 8) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; } }

    let is i64 as dchk = image.image_check_dims(w, h, fmt);
    if (dchk < 0) { return ce.E_CSIF_DIMS; }

    // ---- tiled path: decode each TIDX-addressed tile independently ----
    if (ntx * nty > 1) {
        if (tw < 1) { return ce.E_CSIF_GEOM; }
        if (tidx_off < 0) { return ce.E_CSIF_ORDER; }
        if (ntx != (w + tw - 1) / tw) { return ce.E_CSIF_GEOM; }
        if (nty != (h + th - 1) / th) { return ce.E_CSIF_GEOM; }
        let is i64 as rc0 = image.image_init(out, w, h, fmt);
        if (rc0 < 0) { return rc0; }
        buf.buf_seek(&bf, tidx_off);
        buf.buf_u64le(&bf);                       // item_id
        let is i64 as ecount = buf.buf_u32le(&bf);
        let is i64 as ialgo = buf.buf_u8(&bf);
        buf.buf_skip(&bf, 3);
        if (ecount != ntx * nty) { image.image_free(out); return ce.E_CSIF_GEOM; }
        let is i64 as ch = component_count;
        let is i64 as tmpcap = tw * th * ch * bpsamp;
        let is *u8 as tmp = mem.core.mmap_anon(tmpcap + 1);
        if (cast(i64, tmp) <= 0) { image.image_free(out); return ce.E_CSIF_LIMIT; }
        let is i64 as e with mut = 0;
        while (e < ecount) {
            let is i64 as tx = buf.buf_u32le(&bf);
            let is i64 as ty = buf.buf_u32le(&bf);
            let is i64 as toff = buf.buf_u64le(&bf);
            let is i64 as tstored = buf.buf_u64le(&bf);
            let is i64 as tunc = buf.buf_u64le(&bf);
            let is i64 as tsum = buf.buf_u32le(&bf);
            buf.buf_u32le(&bf);                   // flags
            if (tx >= ntx) { image.image_free(out); return ce.E_CSIF_GEOM; }
            if (ty >= nty) { image.image_free(out); return ce.E_CSIF_GEOM; }
            // C-4: the tile's byte range must lie inside IDAT's codec region.
            if (toff < idat_off + 32) { image.image_free(out); return ce.E_CSIF_RANGE; }
            if (toff + tstored > idat_off + idat_plen) { image.image_free(out); return ce.E_CSIF_RANGE; }
            let is *u8 as tb = cast(*u8, cast(i64, src) + toff);
            if (ialgo == 1) {
                if (checksum.crc32(tb, tstored) != tsum) { image.image_free(out); return ce.E_CSIF_CRC_CRITICAL; }
            }
            let is i64 as tweff with mut = tw;
            if (tx * tw + tweff > w) { tweff = w - tx * tw; }
            let is i64 as theff with mut = th;
            if (ty * th + theff > h) { theff = h - ty * th; }
            if (tunc != tweff * theff * ch * bpsamp) { image.image_free(out); return ce.E_CSIF_GEOM; }
            let is i64 as trc with mut = 0;
            if (codec_id == 0) {
                if (tstored != tunc) { trc = 0 - 1; }
                else { mem.core.memcpy(tmp, tb, tunc); }
            } else {
                if (codec_id == 1) { trc = qoi.qoi_tile_decode(tb, tstored, tweff * theff, ch, tmp); }
                else { if (codec_id == 2) { trc = modular.modular_decode(tb, tstored, tweff, theff, ch, bpsamp, tmp); }
                else { trc = dctc.dct_decode(tb, tstored, tweff, theff, ch, tmp); } }
            }
            if (trc < 0) { image.image_free(out); return ce.E_CSIF_PAYLOAD_TRUNC; }
            // blit into the canvas
            let is i64 as r with mut = 0;
            while (r < theff) {
                mem.core.memcpy(
                    cast(*u8, cast(i64, out.pixels) + (ty * th + r) * out.stride + tx * tw * ch * bpsamp),
                    cast(*u8, cast(i64, tmp) + r * tweff * ch * bpsamp),
                    tweff * ch * bpsamp);
                r = r + 1;
            }
            e = e + 1;
        }
        mem.core.munmap(tmp, tmpcap + 1);
        return 0;
    }

    // Codec bytes begin after IDAT's 32-byte head.
    let is i64 as codlen = idat_plen - 32;
    if (codec_id == 0) {
        if (codlen != w * h * component_count * bpsamp) { return ce.E_CSIF_PAYLOAD_TRUNC; }
    }
    let is i64 as rc = image.image_init(out, w, h, fmt);
    if (rc < 0) { return rc; }
    let is *u8 as codbytes = cast(*u8, cast(i64, src) + idat_off + 32);
    if (codec_id == 0) {
        let is i64 as need = w * h * component_count * bpsamp;
        let is i64 as i with mut = 0;
        while (i < need) { out.pixels[i] = codbytes[i]; i = i + 1; }
    } else {
        if (codec_id == 1) {
            let is i64 as qr = qoi.qoi_tile_decode(codbytes, codlen, w * h, component_count, out.pixels);
            if (qr < 0) { image.image_free(out); return ce.E_CSIF_PAYLOAD_TRUNC; }
        } else {
            if (codec_id == 2) {
                let is i64 as mr = modular.modular_decode(codbytes, codlen, w, h, component_count, bpsamp, out.pixels);
                if (mr < 0) { image.image_free(out); return ce.E_CSIF_PAYLOAD_TRUNC; }
            } else {
                let is i64 as dr = dctc.dct_decode(codbytes, codlen, w, h, component_count, out.pixels);
                if (dr < 0) { image.image_free(out); return ce.E_CSIF_PAYLOAD_TRUNC; }
            }
        }
    }
    return 0;
}

// ============================ animation ====================================
// CSIF native animation (spec §1.19 / §9.5): an IANI header declares the
// timeline (frame count, loop, explicit timebase, canvas, background, bounded
// reference slots) and one IFRM chunk carries the frame_count-long array of
// per-frame control records — duration, crop rect, and the *closed enums*
// blend_op {SOURCE, OVER, ADD, MUL} and dispose_op {NONE, BACKGROUND,
// PREVIOUS}. Each frame's pixels are a separate coded item (its own IDAT), so
// every frame is directly addressable.
//
// Honest scope: all frames are keyframes (the codecs are intra-only) and are
// emitted full-canvas; the decoder supports SOURCE/OVER blending and all three
// disposals. Inter-frame prediction and sub-rect frames are sequenced later —
// a cropped frame needs a per-item IHDR, which is the multi-item (ITBL) path.
//
//   csif_encode_anim(anim, out, codec_id) -> 0, or negative.
//   csif_decode_anim(src, len, out)       -> 0, or negative.
// A still-only reader (csif_decode) renders the primary item = frame 0.

struct CsifAnim {
    width as i64;
    height as i64;
    count as i64;      // frames
    frames as i64;     // address of count * (width*height*4) RGBA8 bytes
    delays as i64;     // address of count i64 durations in milliseconds
}

fn csif_anim_frame(a as *CsifAnim, i as i64) as *u8 {
    return cast(*u8, a.frames + i * a.width * a.height * 4);
}
fn csif_anim_free(a as *CsifAnim) as void {
    let is i64 as fsize = a.width * a.height * 4;
    if (a.frames > 0) { mem.core.munmap(cast(*u8, a.frames), a.count * fsize); }
    if (a.delays > 0) { mem.core.munmap(cast(*u8, a.delays), a.count * 8); }
    a.frames = 0; a.delays = 0; a.count = 0;
}

fn _pl_iani(p as *cb.Bytes, nf as i64, w as i64, h as i64) as void {
    _w32(p, nf);        // frame_count
    _w32(p, 0);         // loop_count (0 = INFINITE, a declared sentinel)
    _w32(p, 1000);      // timescale_hz — explicit timebase (ms), never implied
    _w32(p, 1);         // n_reference_slots (bounded playback memory)
    _w32(p, 1);         // max_snapshot_depth (PREVIOUS disposal bound)
    _w32(p, w);         // canvas_w
    _w32(p, h);         // canvas_h
    _w32(p, 0);         // background_rgba (transparent)
}

// One 56-byte IFRM record.
fn _pl_ifrm_rec(p as *cb.Bytes, idx as i64, dur_ms as i64, w as i64, h as i64) as void {
    _w32(p, idx);       // frame_index
    _w64(p, idx);       // item_id (this frame's coded item)
    _w32(p, dur_ms);    // duration_ticks numerator (ticks at timescale_hz)
    _w32(p, 1);         // duration denominator
    _w32(p, 0); _w32(p, 0); _w32(p, w); _w32(p, h);   // crop rect (full canvas)
    _w32(p, 0);         // blend_op SOURCE
    _w32(p, 0);         // dispose_op NONE
    _w32(p, 1);         // is_keyframe (codecs are intra-only)
    _w32(p, 4294967295); // reference_slot = none
    _w32(p, 0);         // save_as_reference
}

fn _tstr(i as i64) as *u8 {
    if (i == 0) { return "ILIM"; }
    if (i == 1) { return "IHDR"; }
    if (i == 2) { return "ICOL"; }
    if (i == 3) { return "ICOD"; }
    if (i == 4) { return "IANI"; }
    if (i == 5) { return "IFRM"; }
    if (i == 6) { return "IDAT"; }
    return "IEND";
}

fn csif_encode_anim(anim as *CsifAnim, out as *cb.Bytes, codec_id as i64) as i64 {
    let is i64 as w = anim.width;
    let is i64 as h = anim.height;
    let is i64 as nf = anim.count;
    if (nf < 1) { return ce.E_CSIF_GEOM; }
    if (nf > 65536) { return ce.E_CSIF_LIMIT; }
    if (image.image_check_dims(w, h, pixfmt.FMT_RGBA8) < 0) { return ce.E_CSIF_DIMS; }
    if (codec_id == 3) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; }   // lossy frames: later
    let is i64 as ch = 4;
    let is i64 as fsize = w * h * 4;

    // ILIM IHDR ICOL ICOD IANI IFRM IDAT×nf IEND
    let is i64 as nchunks = 7 + nf;
    let is cb.Bytes as stage = cb.bytes_new(nf * fsize / 2 + 4096);
    let is *i64 as ctyp = cast(*i64, mem.core.mmap_anon(nchunks * 8));
    let is *i64 as cflg = cast(*i64, mem.core.mmap_anon(nchunks * 8));
    let is *i64 as cst  = cast(*i64, mem.core.mmap_anon(nchunks * 8));
    let is *i64 as clen = cast(*i64, mem.core.mmap_anon(nchunks * 8));
    if (cast(i64, clen) <= 0) { return ce.E_CSIF_LIMIT; }
    let is cb.Bytes as p = cb.bytes_new(4096);
    let is i64 as ci with mut = 0;

    // A canvas proxy for the geometry payloads.
    let is image.Image as canvas;
    canvas.pixels = cast(*u8, anim.frames);
    canvas.width = w; canvas.height = h; canvas.stride = w * 4;
    canvas.fmt = pixfmt.FMT_RGBA8; canvas.owned = 0;

    cb.bytes_reset(&p); _pl_ilim(&p);
    ctyp[ci] = 0; cflg[ci] = 11; cst[ci] = _emit_chunk_into(&stage, _tstr(0), 11, p.ptr, p.len);
    clen[ci] = stage.len - cst[ci]; ci = ci + 1;

    cb.bytes_reset(&p); _pl_ihdr(&p, &canvas, 3, ch);
    ctyp[ci] = 1; cflg[ci] = 27; cst[ci] = _emit_chunk_into(&stage, _tstr(1), 27, p.ptr, p.len);
    clen[ci] = stage.len - cst[ci]; ci = ci + 1;

    cb.bytes_reset(&p); _pl_icol(&p);
    ctyp[ci] = 2; cflg[ci] = 27; cst[ci] = _emit_chunk_into(&stage, _tstr(2), 27, p.ptr, p.len);
    clen[ci] = stage.len - cst[ci]; ci = ci + 1;

    cb.bytes_reset(&p); _pl_icod(&p, codec_id, ch, 0, 0, 1, 1);
    ctyp[ci] = 3; cflg[ci] = 27; cst[ci] = _emit_chunk_into(&stage, _tstr(3), 27, p.ptr, p.len);
    clen[ci] = stage.len - cst[ci]; ci = ci + 1;

    // IANI + IFRM are non-critical (a still reader skips them, §9.5.4).
    cb.bytes_reset(&p); _pl_iani(&p, nf, w, h);
    ctyp[ci] = 4; cflg[ci] = 10; cst[ci] = _emit_chunk_into(&stage, _tstr(4), 10, p.ptr, p.len);
    clen[ci] = stage.len - cst[ci]; ci = ci + 1;

    cb.bytes_reset(&p);
    let is *i64 as dl = cast(*i64, anim.delays);
    let is i64 as f with mut = 0;
    while (f < nf) {
        let is i64 as dur with mut = 100;
        if (anim.delays > 0) { dur = dl[f]; }
        _pl_ifrm_rec(&p, f, dur, w, h);
        f = f + 1;
    }
    ctyp[ci] = 5; cflg[ci] = 10; cst[ci] = _emit_chunk_into(&stage, _tstr(5), 10, p.ptr, p.len);
    clen[ci] = stage.len - cst[ci]; ci = ci + 1;

    // One IDAT per frame (item_id = frame index).
    f = 0;
    while (f < nf) {
        cb.bytes_reset(&p);
        _w64(&p, f);                                   // item_id
        _w32(&p, 0); _w32(&p, 0);                      // idat_index, coord_kind WHOLE
        _w32(&p, 0); _w32(&p, 0); _w32(&p, 0); _w32(&p, 0);   // coords
        let is image.Image as fimg;
        fimg.pixels = csif_anim_frame(anim, f);
        fimg.width = w; fimg.height = h; fimg.stride = w * 4;
        fimg.fmt = pixfmt.FMT_RGBA8; fimg.owned = 0;
        _codec_encode(&fimg, codec_id, ch, &p);
        ctyp[ci] = 6; cflg[ci] = 51; cst[ci] = _emit_chunk_into(&stage, _tstr(6), 51, p.ptr, p.len);
        clen[ci] = stage.len - cst[ci]; ci = ci + 1;
        f = f + 1;
    }

    cb.bytes_reset(&p); _w64(&p, 0);
    ctyp[ci] = 7; cflg[ci] = 11; cst[ci] = _emit_chunk_into(&stage, _tstr(7), 11, p.ptr, p.len);
    clen[ci] = stage.len - cst[ci]; ci = ci + 1;

    // Lay out final offsets (8-byte aligned) after header + directory.
    let is *i64 as coff = cast(*i64, mem.core.mmap_anon(nchunks * 8));
    if (cast(i64, coff) <= 0) { return ce.E_CSIF_LIMIT; }
    let is i64 as cur with mut = 64 + nchunks * 32;
    let is i64 as i with mut = 0;
    while (i < nchunks) {
        coff[i] = cur;
        cur = _align8(cur + clen[i]);
        i = i + 1;
    }
    let is i64 as file_size = cur;

    // Header (64 bytes) — header_flags bit2 = HAS_ANIMATION.
    cb.bytes_push(out, cast(u8, 67)); cb.bytes_push(out, cast(u8, 83));
    cb.bytes_push(out, cast(u8, 73)); cb.bytes_push(out, cast(u8, 70));   // "CSIF"
    _w8(out, 137); _w8(out, 13); _w8(out, 10); _w8(out, 26); _w8(out, 10); _w8(out, 0);
    _w16(out, 1); _w8(out, 0); _w8(out, 1); _w8(out, 0); _w8(out, 1); _w8(out, 0); _w8(out, 1);
    _w16(out, 4);                 // header_flags: HAS_ANIMATION
    _w32(out, nchunks);
    _w64(out, 64);                // directory_offset
    _w64(out, file_size);
    _w64(out, 0);                 // primary_item_id = frame 0
    _w64(out, 0);                 // directory_offset_tail
    let is i64 as hcrc = checksum.crc32(out.ptr, 56);
    _w64(out, hcrc);

    // Directory.
    i = 0;
    while (i < nchunks) {
        _emit_dir(out, _tstr(ctyp[i]), cflg[i], coff[i], clen[i], i);
        i = i + 1;
    }
    // Chunks, each padded to its successor's 8-aligned offset.
    i = 0;
    while (i < nchunks) {
        cb.bytes_append(out, cast(*u8, cast(i64, stage.ptr) + cst[i]), clen[i]);
        let is i64 as nxt with mut = file_size;
        if (i + 1 < nchunks) { nxt = coff[i + 1]; }
        _wz(out, nxt - (coff[i] + clen[i]));
        i = i + 1;
    }

    cb.bytes_free(&p); cb.bytes_free(&stage);
    mem.core.munmap(cast(*u8, ctyp), nchunks * 8);
    mem.core.munmap(cast(*u8, cflg), nchunks * 8);
    mem.core.munmap(cast(*u8, cst), nchunks * 8);
    mem.core.munmap(cast(*u8, clen), nchunks * 8);
    mem.core.munmap(cast(*u8, coff), nchunks * 8);
    return out.len;
}

fn _rd32(p as *u8, o as i64) as i64 {
    return cast(i64, p[o]) | (cast(i64, p[o + 1]) << 8)
        | (cast(i64, p[o + 2]) << 16) | (cast(i64, p[o + 3]) << 24);
}

fn csif_decode_anim(src as *u8, src_len as i64, out as *CsifAnim) as i64 {
    let is buf.Buf as bf;
    buf.buf_init(&bf, src, src_len);
    if (src_len < 64) { return ce.E_CSIF_TOO_SMALL; }
    if (cast(i64, src[0]) != 67) { return ce.E_CSIF_MAGIC; }
    if (cast(i64, src[1]) != 83) { return ce.E_CSIF_MAGIC; }
    if (cast(i64, src[2]) != 73) { return ce.E_CSIF_MAGIC; }
    if (cast(i64, src[3]) != 70) { return ce.E_CSIF_MAGIC; }
    let is i64 as hflags = cast(i64, src[18]) | (cast(i64, src[19]) << 8);
    if ((hflags & 4) == 0) { return ce.E_CSIF_NOT_ANIMATED; }
    let is i64 as chunk_count = _rd32(src, 20);
    let is i64 as dir_off = _rd32(src, 24);
    if (dir_off + chunk_count * 32 > src_len) { return ce.E_CSIF_DIR_RANGE; }
    if (checksum.crc32(src, 56) != _rd32(src, 56)) { return ce.E_CSIF_HEADER_CRC; }

    let is i64 as ihdr_off with mut = 0 - 1;
    let is i64 as icod_off with mut = 0 - 1;
    let is i64 as iani_off with mut = 0 - 1;
    let is i64 as ifrm_off with mut = 0 - 1;
    let is i64 as ifrm_len with mut = 0;
    let is i64 as nidat with mut = 0;
    let is *i64 as idoff = cast(*i64, mem.core.mmap_anon(chunk_count * 8 + 8));
    let is *i64 as idlen = cast(*i64, mem.core.mmap_anon(chunk_count * 8 + 8));
    if (cast(i64, idlen) <= 0) { return ce.E_CSIF_LIMIT; }

    let is i64 as di with mut = 0;
    while (di < chunk_count) {
        buf.buf_seek(&bf, dir_off + di * 32);
        let is i64 as t0 = buf.buf_u8(&bf); let is i64 as t1 = buf.buf_u8(&bf);
        let is i64 as t2 = buf.buf_u8(&bf); let is i64 as t3 = buf.buf_u8(&bf);
        let is i64 as dflags = buf.buf_u32le(&bf);
        let is i64 as coff = buf.buf_u64le(&bf);
        let is i64 as clen = buf.buf_u64le(&bf);
        if (coff < 64) { return ce.E_CSIF_RANGE; }
        if (coff + clen > src_len) { return ce.E_CSIF_RANGE; }
        let is i64 as plen = cast(i64, src[coff + 8]) | (cast(i64, src[coff + 9]) << 8)
            | (cast(i64, src[coff + 10]) << 16) | (cast(i64, src[coff + 11]) << 24);
        let is i64 as critical = dflags & 1;
        let is i64 as calc = checksum.crc32(cast(*u8, cast(i64, src) + coff), 16 + plen);
        let is i64 as stored = _rd32(src, coff + 16 + plen);
        if (calc != stored) { if (critical == 1) { return ce.E_CSIF_CRC_CRITICAL; } }
        let is i64 as poff = coff + 16;
        if (_is(t0,t1,t2,t3, "IHDR") == 1) { ihdr_off = poff; }
        if (_is(t0,t1,t2,t3, "ICOD") == 1) { icod_off = poff; }
        if (_is(t0,t1,t2,t3, "IANI") == 1) { iani_off = poff; }
        if (_is(t0,t1,t2,t3, "IFRM") == 1) { ifrm_off = poff; ifrm_len = plen; }
        if (_is(t0,t1,t2,t3, "IDAT") == 1) {
            idoff[nidat] = poff; idlen[nidat] = plen; nidat = nidat + 1;
        }
        di = di + 1;
    }
    if (iani_off < 0) { return ce.E_CSIF_ORDER; }
    if (ifrm_off < 0) { return ce.E_CSIF_ORDER; }
    if (ihdr_off < 0) { return ce.E_CSIF_ORDER; }
    if (icod_off < 0) { return ce.E_CSIF_ORDER; }

    // IANI
    let is i64 as nf = _rd32(src, iani_off);
    let is i64 as timescale = _rd32(src, iani_off + 8);
    let is i64 as w = _rd32(src, iani_off + 20);
    let is i64 as h = _rd32(src, iani_off + 24);
    if (timescale < 1) { return ce.E_CSIF_TICKBASE; }
    if (nf < 1) { return ce.E_CSIF_GEOM; }
    if (nf != nidat) { return ce.E_CSIF_GEOM; }
    if (ifrm_len != nf * 56) { return ce.E_CSIF_GEOM; }
    if (image.image_check_dims(w, h, pixfmt.FMT_RGBA8) < 0) { return ce.E_CSIF_DIMS; }

    // ICOD: codec + component count from IHDR
    let is i64 as codec_id = cast(i64, src[icod_off + 8]) | (cast(i64, src[icod_off + 9]) << 8);
    if (codec_id > 3) { return ce.E_CSIF_UNKNOWN_CODEC; }
    // IHDR payload: item_id(8) w(4) h(4) depth(4) sample_format(1) endian(1)
    // bit_depth(1) layout(1) color_model(1) component_count(1) ...
    let is i64 as bit_depth = cast(i64, src[ihdr_off + 22]);
    let is i64 as ch = cast(i64, src[ihdr_off + 25]);
    if (ch != 4) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; }     // animation canvas is RGBA8
    if (bit_depth != 8) { return ce.E_CSIF_UNSUPPORTED_SAMPLE; }

    let is i64 as fsize = w * h * 4;
    let is *u8 as frames = mem.core.mmap_anon(nf * fsize);
    let is *i64 as delays = cast(*i64, mem.core.mmap_anon(nf * 8));
    let is *u8 as canvas = mem.core.mmap_anon(fsize);
    let is *u8 as saved = mem.core.mmap_anon(fsize);
    let is *u8 as tmp = mem.core.mmap_anon(fsize);
    if (cast(i64, tmp) <= 0) { return ce.E_CSIF_LIMIT; }
    mem.core.memset(canvas, cast(i32, 0), fsize);

    let is i64 as f with mut = 0;
    while (f < nf) {
        let is i64 as ro = ifrm_off + f * 56;
        let is i64 as dur_num = _rd32(src, ro + 12);
        let is i64 as dur_den with mut = _rd32(src, ro + 16);
        if (dur_den < 1) { dur_den = 1; }
        let is i64 as cx = _rd32(src, ro + 20);
        let is i64 as cy = _rd32(src, ro + 24);
        let is i64 as cw = _rd32(src, ro + 28);
        let is i64 as chh = _rd32(src, ro + 32);
        let is i64 as blend = _rd32(src, ro + 36);
        let is i64 as dispose = _rd32(src, ro + 40);
        if (blend > 1) { return ce.E_CSIF_ANIM_UNSUPPORTED; }   // SOURCE / OVER only
        if (dispose > 2) { return ce.E_CSIF_ENUM; }
        if (cx != 0) { return ce.E_CSIF_ANIM_UNSUPPORTED; }     // sub-rect frames: later
        if (cy != 0) { return ce.E_CSIF_ANIM_UNSUPPORTED; }
        if (cw != w) { return ce.E_CSIF_ANIM_UNSUPPORTED; }
        if (chh != h) { return ce.E_CSIF_ANIM_UNSUPPORTED; }
        delays[f] = dur_num * 1000 / (timescale * dur_den);   // -> milliseconds

        // The frame's coded item is the f-th IDAT (item_id ascending).
        let is *u8 as cod = cast(*u8, cast(i64, src) + idoff[f] + 32);
        let is i64 as codlen = idlen[f] - 32;
        let is i64 as drc = _codec_decode(cod, codlen, w, h, 4, 1, codec_id, tmp);
        if (drc < 0) { return drc; }

        if (dispose == 2) { mem.core.memcpy(saved, canvas, fsize); }
        // composite
        let is i64 as p with mut = 0;
        while (p < w * h) {
            let is i64 as o = p * 4;
            if (blend == 0) {
                canvas[o] = tmp[o]; canvas[o+1] = tmp[o+1];
                canvas[o+2] = tmp[o+2]; canvas[o+3] = tmp[o+3];
            } else {
                let is i64 as sa = cast(i64, tmp[o + 3]);
                let is i64 as da = cast(i64, canvas[o + 3]);
                let is i64 as oa = sa + da * (255 - sa) / 255;
                if (oa == 0) {
                    canvas[o]=cast(u8,0); canvas[o+1]=cast(u8,0);
                    canvas[o+2]=cast(u8,0); canvas[o+3]=cast(u8,0);
                } else {
                    let is i64 as c2 with mut = 0;
                    while (c2 < 3) {
                        let is i64 as sc = cast(i64, tmp[o + c2]);
                        let is i64 as dc = cast(i64, canvas[o + c2]);
                        canvas[o + c2] = cast(u8, (sc * sa + dc * da * (255 - sa) / 255) / oa);
                        c2 = c2 + 1;
                    }
                    canvas[o + 3] = cast(u8, oa);
                }
            }
            p = p + 1;
        }
        mem.core.memcpy(cast(*u8, cast(i64, frames) + f * fsize), canvas, fsize);
        if (dispose == 1) { mem.core.memset(canvas, cast(i32, 0), fsize); }
        if (dispose == 2) { mem.core.memcpy(canvas, saved, fsize); }
        f = f + 1;
    }

    mem.core.munmap(canvas, fsize);
    mem.core.munmap(saved, fsize);
    mem.core.munmap(tmp, fsize);
    mem.core.munmap(cast(*u8, idoff), chunk_count * 8 + 8);
    mem.core.munmap(cast(*u8, idlen), chunk_count * 8 + 8);
    out.width = w; out.height = h; out.count = nf;
    out.frames = cast(i64, frames); out.delays = cast(i64, delays);
    return 0;
}
