// =======================================================
// caustic-image/csif/modular.cst
// CSIF codec 2 — MODULAR (lossless): a per-channel MED predictor (LOCO-I /
// JPEG-LS median) over already-reconstructed causal neighbours + subtract-green
// colour transform, then the residual plane is entropy-coded by whichever of
// three methods is smallest:
//   method 0 — DEFLATE (caustic-compact): catches LZ repetition (structured
//              content, gradients — where pure entropy coding loses to PNG).
//   method 1 — single-table static rANS: best on near-random residuals.
//   method 2 — 5-bucket quantized-gradient context rANS (8-bit only, pull-based).
// Picking the best of {predict+LZ, predict+entropy, predict+context} makes the
// flagship competitive with PNG/WebP-lossless across content types.
//
// 8- and 16-bit samples (16-bit residuals split into low/high byte planes).
//   modular_encode(img, out) -> 0, or negative.
//   modular_decode(src, len, w, h, channels, bps, out_pixels) -> 0, or negative.
// =======================================================

use "std/mem.cst" only bins, core as mem;
use "../core/errno.cst"  as errno;
use "../core/image.cst"  as image;
use "../core/pixfmt.cst" as pixfmt;
use "caustic-compact/entropy/rans.cst"  as rans;
use "caustic-compact/formats/zlib.cst"  as zlib;
use "../core/zsteps.cst" as zsteps;
use "caustic-compact/core/bytes.cst"    as cb;

fn _med(a as i64, b as i64, c as i64) as i64 {
    let is i64 as mx with mut = a; if (b > a) { mx = b; }
    let is i64 as mn with mut = a; if (b < a) { mn = b; }
    if (c >= mx) { return mn; }
    if (c <= mn) { return mx; }
    return a + b - c;
}

let is i64 as _NCTX with imut = 5;

fn _ctx(a as i64, b as i64, c as i64) as i64 {
    let is i64 as d1 with mut = a - c; if (d1 < 0) { d1 = 0 - d1; }
    let is i64 as d2 with mut = c - b; if (d2 < 0) { d2 = 0 - d2; }
    let is i64 as d = d1 + d2;
    if (d == 0) { return 0; }
    if (d < 3)  { return 1; }
    if (d < 9)  { return 2; }
    if (d < 27) { return 3; }
    return 4;
}

fn _channels(fmt as i64) as i64 {
    if (fmt == pixfmt.FMT_GRAY8)   { return 1; }
    if (fmt == pixfmt.FMT_GRAYA8)  { return 2; }
    if (fmt == pixfmt.FMT_RGB8)    { return 3; }
    if (fmt == pixfmt.FMT_RGBA8)   { return 4; }
    if (fmt == pixfmt.FMT_GRAY16)  { return 1; }
    if (fmt == pixfmt.FMT_GRAYA16) { return 2; }
    if (fmt == pixfmt.FMT_RGB16)   { return 3; }
    if (fmt == pixfmt.FMT_RGBA16)  { return 4; }
    return 0;
}

fn _gs(p as *u8, i as i64, bps as i64) as i64 {
    if (bps == 2) { return cast(i64, p[i * 2]) | (cast(i64, p[i * 2 + 1]) << 8); }
    return cast(i64, p[i]);
}
fn _ps(p as *u8, i as i64, bps as i64, v as i64) as void {
    if (bps == 2) { p[i * 2] = cast(u8, v & 255); p[i * 2 + 1] = cast(u8, (v >> 8) & 255); }
    else { p[i] = cast(u8, v & 255); }
}

fn modular_encode(img as *image.Image, out as *cb.Bytes) as i64 {
    let is i64 as ch = _channels(img.fmt);
    if (ch == 0) { return errno.I_UNSUPPORTED; }
    let is i64 as bps = pixfmt.fmt_depth(img.fmt) / 8;
    let is i64 as mask with mut = 255;
    if (bps == 2) { mask = 65535; }
    let is i64 as w = img.width;
    let is i64 as h = img.height;
    let is i64 as rowb = w * ch;
    let is i64 as n = ch * w * h;
    let is i64 as rn = n * bps;                         // residual bytes (lo + hi planes)
    let is *u8 as rbuf = mem.core.mmap_anon(rn + 1);    // [0..n) lo, [n..2n) hi
    let is *u8 as ctxs = mem.core.mmap_anon(n + 1);
    if (cast(i64, ctxs) <= 0) { return errno.I_OOM; }

    // Work copy with subtract-green for >=3 channels (mod 2^depth).
    let is *u8 as px = mem.core.mmap_anon(rn + 1);
    if (cast(i64, px) <= 0) { mem.core.munmap(rbuf, rn + 1); return errno.I_OOM; }
    mem.core.memcpy(px, img.pixels, rn);
    if (ch >= 3) {
        let is i64 as p with mut = 0;
        while (p < w * h) {
            let is i64 as g = _gs(px, p * ch + 1, bps);
            _ps(px, p * ch,     bps, (_gs(px, p * ch, bps) - g) & mask);
            _ps(px, p * ch + 2, bps, (_gs(px, p * ch + 2, bps) - g) & mask);
            p = p + 1;
        }
    }

    let is i64 as idx with mut = 0;
    let is i64 as c with mut = 0;
    while (c < ch) {
        let is i64 as y with mut = 0;
        while (y < h) {
            let is i64 as x with mut = 0;
            while (x < w) {
                let is i64 as base = (y * w + x) * ch + c;
                let is i64 as a with mut = 0;
                if (x > 0) { a = _gs(px, base - ch, bps); }
                let is i64 as b with mut = 0;
                if (y > 0) { b = _gs(px, base - rowb, bps); }
                let is i64 as ul with mut = 0;
                if (x > 0) { if (y > 0) { ul = _gs(px, base - rowb - ch, bps); } }
                let is i64 as pred = _med(a, b, ul);
                let is i64 as res = (_gs(px, base, bps) - pred) & mask;
                rbuf[idx] = cast(u8, res & 255);
                if (bps == 2) { rbuf[n + idx] = cast(u8, (res >> 8) & 255); }
                ctxs[idx] = cast(u8, _ctx(a, b, ul));
                idx = idx + 1;
                x = x + 1;
            }
            y = y + 1;
        }
        c = c + 1;
    }
    mem.core.munmap(px, rn + 1);

    // Candidate entropy encodings — keep the smallest.
    let is cb.Bytes as cdef = cb.bytes_new(rn / 2 + 64);
    zlib.zlib_compress(rbuf, rn, &cdef, 6);
    let is cb.Bytes as crans = cb.bytes_new(rn / 2 + 1024);
    let is *u8 as zctx = mem.core.mmap_anon(rn + 1);
    mem.core.memset(zctx, cast(i32, 0), rn);
    rans.rans_ctx_encode(rbuf, zctx, rn, 1, &crans);
    mem.core.munmap(zctx, rn + 1);

    let is i64 as best with mut = 0;                    // 0=deflate 1=rans 2=ctx
    let is i64 as bestlen with mut = cdef.len;
    if (crans.len < bestlen) { best = 1; bestlen = crans.len; }

    let is cb.Bytes as cctx = cb.bytes_new(rn / 2 + 4096);
    let is i64 as have_ctx with mut = 0;
    if (bps == 1) {
        rans.rans_ctx_encode(rbuf, ctxs, n, _NCTX, &cctx);
        have_ctx = 1;
        if (cctx.len < bestlen) { best = 2; bestlen = cctx.len; }
    }

    cb.bytes_push(out, cast(u8, best));
    if (best == 0) { cb.bytes_append(out, cdef.ptr, cdef.len); }
    if (best == 1) { cb.bytes_append(out, crans.ptr, crans.len); }
    if (best == 2) { cb.bytes_append(out, cctx.ptr, cctx.len); }

    cb.bytes_free(&cdef); cb.bytes_free(&crans); cb.bytes_free(&cctx);
    mem.core.munmap(rbuf, rn + 1);
    mem.core.munmap(ctxs, n + 1);
    return 0;
}

// Reconstruct samples from a decoded residual buffer (lo plane [0..n), hi plane
// [n..2n) for 16-bit) plus the inverse subtract-green.
fn _reconstruct(rbuf as *u8, w as i64, h as i64, ch as i64, bps as i64, mask as i64, out as *u8) as void {
    let is i64 as rowb = w * ch;
    let is i64 as n = ch * w * h;
    let is i64 as idx with mut = 0;
    let is i64 as c with mut = 0;
    while (c < ch) {
        let is i64 as y with mut = 0;
        while (y < h) {
            let is i64 as x with mut = 0;
            while (x < w) {
                let is i64 as base = (y * w + x) * ch + c;
                let is i64 as a with mut = 0;
                if (x > 0) { a = _gs(out, base - ch, bps); }
                let is i64 as b with mut = 0;
                if (y > 0) { b = _gs(out, base - rowb, bps); }
                let is i64 as ul with mut = 0;
                if (x > 0) { if (y > 0) { ul = _gs(out, base - rowb - ch, bps); } }
                let is i64 as pred = _med(a, b, ul);
                let is i64 as res with mut = cast(i64, rbuf[idx]);
                if (bps == 2) { res = res | (cast(i64, rbuf[n + idx]) << 8); }
                _ps(out, base, bps, (pred + res) & mask);
                idx = idx + 1;
                x = x + 1;
            }
            y = y + 1;
        }
        c = c + 1;
    }
    if (ch >= 3) {
        let is i64 as p with mut = 0;
        while (p < w * h) {
            let is i64 as g = _gs(out, p * ch + 1, bps);
            _ps(out, p * ch,     bps, (_gs(out, p * ch, bps) + g) & mask);
            _ps(out, p * ch + 2, bps, (_gs(out, p * ch + 2, bps) + g) & mask);
            p = p + 1;
        }
    }
}

fn modular_decode(src as *u8, len as i64, w as i64, h as i64, ch as i64, bps as i64, out as *u8) as i64 {
    if (len < 1) { return errno.I_CORRUPT; }
    let is i64 as method = cast(i64, src[0]);
    let is *u8 as pay = cast(*u8, cast(i64, src) + 1);
    let is i64 as plen = len - 1;
    let is i64 as n = ch * w * h;
    let is i64 as rn = n * bps;
    let is i64 as mask with mut = 255;
    if (bps == 2) { mask = 65535; }

    if (method == 2) {
        // context rANS, pull-based (8-bit only).
        let is i64 as rowb = w * ch;
        let is rans.RansCtx as d;
        if (rans.rans_ctx_init(&d, pay, plen) < 0) { return errno.I_CORRUPT; }
        let is i64 as c with mut = 0;
        while (c < ch) {
            let is i64 as y with mut = 0;
            while (y < h) {
                let is i64 as x with mut = 0;
                while (x < w) {
                    let is i64 as base = (y * w + x) * ch + c;
                    let is i64 as a with mut = 0;
                    if (x > 0) { a = cast(i64, out[base - ch]); }
                    let is i64 as b with mut = 0;
                    if (y > 0) { b = cast(i64, out[base - rowb]); }
                    let is i64 as ul with mut = 0;
                    if (x > 0) { if (y > 0) { ul = cast(i64, out[base - rowb - ch]); } }
                    let is i64 as pred = _med(a, b, ul);
                    let is i64 as sym = rans.rans_ctx_sym(&d, _ctx(a, b, ul));
                    if (sym < 0) { rans.rans_ctx_free(&d); return errno.I_CORRUPT; }
                    out[base] = cast(u8, (pred + sym) & 255);
                    x = x + 1;
                }
                y = y + 1;
            }
            c = c + 1;
        }
        rans.rans_ctx_free(&d);
        if (ch >= 3) {
            let is i64 as p with mut = 0;
            while (p < w * h) {
                let is i64 as g = cast(i64, out[p * ch + 1]);
                out[p * ch]     = cast(u8, (cast(i64, out[p * ch]) + g) & 255);
                out[p * ch + 2] = cast(u8, (cast(i64, out[p * ch + 2]) + g) & 255);
                p = p + 1;
            }
        }
        return 0;
    }

    // methods 0/1: decode the whole residual buffer, then reconstruct.
    let is *u8 as rbuf = mem.core.mmap_anon(rn + 1);
    if (cast(i64, rbuf) <= 0) { return errno.I_OOM; }
    if (method == 0) {
        let is cb.Bytes as ob = cb.bytes_new(rn + 64);
        if (zsteps.zlib_whole(pay, plen, &ob, rn * 2 + 65536) < 0) { cb.bytes_free(&ob); mem.core.munmap(rbuf, rn + 1); return errno.I_CORRUPT; }
        if (ob.len < rn) { cb.bytes_free(&ob); mem.core.munmap(rbuf, rn + 1); return errno.I_CORRUPT; }
        mem.core.memcpy(rbuf, ob.ptr, rn);
        cb.bytes_free(&ob);
    } else {
        let is rans.RansCtx as d;
        if (rans.rans_ctx_init(&d, pay, plen) < 0) { mem.core.munmap(rbuf, rn + 1); return errno.I_CORRUPT; }
        let is i64 as i with mut = 0;
        while (i < rn) {
            let is i64 as s = rans.rans_ctx_sym(&d, 0);
            if (s < 0) { rans.rans_ctx_free(&d); mem.core.munmap(rbuf, rn + 1); return errno.I_CORRUPT; }
            rbuf[i] = cast(u8, s); i = i + 1;
        }
        rans.rans_ctx_free(&d);
    }
    _reconstruct(rbuf, w, h, ch, bps, mask, out);
    mem.core.munmap(rbuf, rn + 1);
    return 0;
}
