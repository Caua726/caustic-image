// =======================================================
// caustic-image/core/pixfmt.cst
// Canonical pixel formats an Image can hold. Decoders produce the format
// that fits their source; conversion ops (ops/) bridge between them later.
// Layout is interleaved, 8 or 16 bits per channel, native byte order.
// =======================================================

let is i64 as FMT_NONE    with imut = 0;
let is i64 as FMT_GRAY8   with imut = 1;   // 1 channel,  8-bit
let is i64 as FMT_GRAYA8  with imut = 2;   // 2 channels, 8-bit (gray + alpha)
let is i64 as FMT_RGB8    with imut = 3;   // 3 channels, 8-bit
let is i64 as FMT_RGBA8   with imut = 4;   // 4 channels, 8-bit
let is i64 as FMT_GRAY16  with imut = 5;   // 1 channel,  16-bit
let is i64 as FMT_GRAYA16 with imut = 6;   // 2 channels, 16-bit
let is i64 as FMT_RGB16   with imut = 7;   // 3 channels, 16-bit
let is i64 as FMT_RGBA16  with imut = 8;   // 4 channels, 16-bit

// Bytes per pixel for a format, or 0 if the format id is unknown.
fn fmt_bpp(fmt as i64) as i64 {
    if (fmt == FMT_GRAY8)   { return 1; }
    if (fmt == FMT_GRAYA8)  { return 2; }
    if (fmt == FMT_RGB8)    { return 3; }
    if (fmt == FMT_RGBA8)   { return 4; }
    if (fmt == FMT_GRAY16)  { return 2; }
    if (fmt == FMT_GRAYA16) { return 4; }
    if (fmt == FMT_RGB16)   { return 6; }
    if (fmt == FMT_RGBA16)  { return 8; }
    return 0;
}

// Channel count for a format, or 0 if unknown.
fn fmt_channels(fmt as i64) as i64 {
    if (fmt == FMT_GRAY8)   { return 1; }
    if (fmt == FMT_GRAYA8)  { return 2; }
    if (fmt == FMT_RGB8)    { return 3; }
    if (fmt == FMT_RGBA8)   { return 4; }
    if (fmt == FMT_GRAY16)  { return 1; }
    if (fmt == FMT_GRAYA16) { return 2; }
    if (fmt == FMT_RGB16)   { return 3; }
    if (fmt == FMT_RGBA16)  { return 4; }
    return 0;
}

// Bits per channel (8 or 16), or 0 if unknown.
fn fmt_depth(fmt as i64) as i64 {
    if (fmt >= FMT_GRAY16) { return 16; }
    if (fmt >= FMT_GRAY8)  { return 8; }
    return 0;
}
