// =======================================================
// caustic-image/core/sniff.cst
// Content-based format detection from a leading byte prefix. Returns a FMT_*
// id that decode.cst dispatches on. Detection is by magic signature only —
// never by file extension. Formats without a reliable leading magic (TGA)
// return UNKNOWN here and are decoded only when named explicitly.
// =======================================================

let is i64 as SNIFF_UNKNOWN with imut = 0;
let is i64 as SNIFF_PNG     with imut = 1;
let is i64 as SNIFF_JPEG    with imut = 2;
let is i64 as SNIFF_GIF     with imut = 3;
let is i64 as SNIFF_BMP     with imut = 4;
let is i64 as SNIFF_QOI     with imut = 5;
let is i64 as SNIFF_PNM     with imut = 6;
let is i64 as SNIFF_WEBP    with imut = 7;
let is i64 as SNIFF_TIFF    with imut = 8;
let is i64 as SNIFF_TGA     with imut = 9;
let is i64 as SNIFF_CSIF    with imut = 10;

fn _b(p as *u8, i as i64) as i64 { return cast(i64, p[i]); }

// Does `p` (length `len`) start with the `n`-byte ASCII literal `s`?
fn _has_prefix(p as *u8, len as i64, s as *u8, n as i64) as i64 {
    if (len < n) { return 0; }
    let is i64 as i with mut = 0;
    while (i < n) {
        if (_b(p, i) != cast(i64, s[i])) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn sniff(p as *u8, len as i64) as i64 {
    // PNG: 89 50 4E 47 0D 0A 1A 0A
    if (len >= 8) {
        if (_b(p,0)==137) { if (_b(p,1)==80) { if (_b(p,2)==78) { if (_b(p,3)==71) {
            if (_b(p,4)==13) { if (_b(p,5)==10) { if (_b(p,6)==26) { if (_b(p,7)==10) {
                return SNIFF_PNG;
            }}}}
        }}}}
    }
    // CSIF: "CSIF"
    if (_has_prefix(p, len, "CSIF", 4) == 1) { return SNIFF_CSIF; }
    // QOI: "qoif"
    if (_has_prefix(p, len, "qoif", 4) == 1) { return SNIFF_QOI; }
    // GIF: "GIF87a" / "GIF89a"
    if (_has_prefix(p, len, "GIF8", 4) == 1) { return SNIFF_GIF; }
    // JPEG: FF D8 FF
    if (len >= 3) {
        if (_b(p,0)==255) { if (_b(p,1)==216) { if (_b(p,2)==255) { return SNIFF_JPEG; }}}
    }
    // BMP: "BM"
    if (len >= 2) {
        if (_b(p,0)==66) { if (_b(p,1)==77) { return SNIFF_BMP; }}
    }
    // WebP: "RIFF" ???? "WEBP"
    if (len >= 12) {
        if (_has_prefix(p, len, "RIFF", 4) == 1) {
            let is *u8 as w = cast(*u8, cast(i64, p) + 8);
            if (_has_prefix(w, len - 8, "WEBP", 4) == 1) { return SNIFF_WEBP; }
        }
    }
    // TIFF: "II" 2A 00  or  "MM" 00 2A
    if (len >= 4) {
        if (_b(p,0)==73) { if (_b(p,1)==73) { if (_b(p,2)==42) { if (_b(p,3)==0) {
            return SNIFF_TIFF; }}}}
        if (_b(p,0)==77) { if (_b(p,1)==77) { if (_b(p,2)==0) { if (_b(p,3)==42) {
            return SNIFF_TIFF; }}}}
    }
    // PNM: 'P' followed by '1'..'6'
    if (len >= 2) {
        if (_b(p,0)==80) {
            let is i64 as c = _b(p,1);
            if (c >= 49) { if (c <= 54) { return SNIFF_PNM; } }
        }
    }
    return SNIFF_UNKNOWN;
}
