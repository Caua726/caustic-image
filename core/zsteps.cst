// =======================================================
// caustic-image/core/zsteps.cst
// A DEFLATE stream inflated while it is still arriving (RFC 1951).
//
//   let is ZSteps as z = zsteps(most);
//   zsteps_run(&z, body, len)   as often as the stream grows: 1 when its last
//                               block is done, 0 for more, <0 if it is bad
//   z.out                       every byte it has made so far
//   zsteps_free(&z)
//
// body is the stream from its first block (a zlib stream's 2-byte header
// already taken off), all of it each time: the blocks it has finished are
// kept, and the one it was in the middle of is made again from its start,
// so a byte of output is never made from bytes that had not come. Running
// out of input is never a mistake: what came before stands, and the next run
// goes on from there. A block decoded to its end is never decoded again.
//
// Codes of up to 9 bits are looked up in a table; longer ones, and any near
// the input's end, are read a bit at a time against the counts of each
// length (the canonical code of RFC 1951 3.2.2) — and every bit, either way,
// is one that came. Output past most bytes is refused, so no stream can grow
// it beyond what its reader expects.
//
// zlib_whole() inflates a whole zlib stream this way, its header and
// Adler-32 checked: what decoders of untrusted files use. (caustic-compact's
// inflate, given a stream cut inside a Huffman block, goes on decoding the
// zero bits past its end and does not come back.)
// =======================================================

use "caustic-compact/core/bytes.cst" as cb;
use "caustic-compact/core/checksum.cst" as checksum;
use "errno.cst" as errno;

let is i64 as Z_MORE with imut = 0 - 100;   // ran out of input (internal)

struct ZSteps {
    out     as cb.Bytes;
    blk_bit as i64;   // where the block not yet finished starts, in bits
    blk_out as i64;   // and out.len then
    done    as i32;   // the last block finished
    _pad    as i32;
    most    as i64;
}

struct _Bits {
    src   as *u8;
    len   as i64;     // bytes
    pos   as i64;     // bytes taken into acc
    acc   as i64;     // bits taken and not yet used, the next lowest
    nbits as i64;
}

struct _Huff {
    count  as [16]i64;
    symbol as [288]i64;
    fast   as [512]i64;   // the next 9 bits -> symbol | length << 16; 0: longer
}

// Where the next bit is, from the input's start.
fn _at(b as *_Bits) as i64 { return b.pos * 8 - b.nbits; }

fn _fill(b as *_Bits) as void {
    while (b.nbits <= 48 && b.pos < b.len) {
        b.acc = b.acc | (cast(i64, b.src[b.pos]) << b.nbits);
        b.pos = b.pos + 1;
        b.nbits = b.nbits + 8;
    }
}

fn zsteps(most as i64) as ZSteps {
    let is ZSteps as z;
    z.out = cb.bytes_new(4096);
    z.blk_bit = 0;
    z.blk_out = 0;
    z.done = 0;
    z.most = most;
    return z;
}

fn zsteps_free(z as *ZSteps) as void { cb.bytes_free(&z.out); }

fn _bits(b as *_Bits, n as i64) as i64 {
    if (n == 0) { return 0; }
    if (b.nbits < n) { _fill(b); }
    if (b.nbits < n) { return Z_MORE; }
    let is i64 as v = b.acc & ((1 << n) - 1);
    b.acc = b.acc >> n;
    b.nbits = b.nbits - n;
    return v;
}

// Counts and symbols in code order from n code lengths. 0, or <0 when the
// lengths ask for more codes than there are.
fn _build(h as *_Huff, lens as *i64, n as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < 16) { h.count[i] = 0; i = i + 1; }
    i = 0;
    while (i < n) { h.count[lens[i]] = h.count[lens[i]] + 1; i = i + 1; }
    let is i64 as left with mut = 1;
    i = 1;
    while (i < 16) {
        left = left * 2 - h.count[i];
        if (left < 0) { return errno.I_CORRUPT; }
        i = i + 1;
    }
    let is [16]i64 as offs;
    offs[1] = 0;
    i = 1;
    while (i < 15) { offs[i + 1] = offs[i] + h.count[i]; i = i + 1; }
    i = 0;
    while (i < n) {
        if (lens[i] != 0) {
            h.symbol[offs[lens[i]]] = i;
            offs[lens[i]] = offs[lens[i]] + 1;
        }
        i = i + 1;
    }
    // The table: each short code's bits reversed (DEFLATE sends a code's
    // first bit lowest), every 9-bit pattern it starts.
    i = 0;
    while (i < 512) { h.fast[i] = 0; i = i + 1; }
    let is [16]i64 as next;
    let is i64 as code with mut = 0;
    next[0] = 0;
    i = 1;
    while (i < 16) {
        code = (code + h.count[i - 1]) << 1;
        if (i == 1) { code = 0; }
        next[i] = code;
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        let is i64 as l = lens[i];
        if (l > 0 && l <= 9) {
            let is i64 as c = next[l];
            next[l] = c + 1;
            let is i64 as rev with mut = 0;
            let is i64 as k with mut = 0;
            while (k < l) { rev = (rev << 1) | ((c >> k) & 1); k = k + 1; }
            let is i64 as f with mut = rev;
            while (f < 512) {
                h.fast[f] = i | (l << 16);
                f = f + (1 << l);
            }
        } else if (l > 9) {
            next[l] = next[l] + 1;
        }
        i = i + 1;
    }
    return 0;
}

// One symbol, its code read a bit at a time; Z_MORE when the input ends
// first, I_CORRUPT for a code with no symbol.
fn _decode(b as *_Bits, h as *_Huff) as i64 {
    if (b.nbits < 15) { _fill(b); }
    let is i64 as e = h.fast[b.acc & 511];
    let is i64 as fl = e >> 16;
    if (fl > 0 && fl <= b.nbits) {
        b.acc = b.acc >> fl;
        b.nbits = b.nbits - fl;
        return e & 65535;
    }
    // Longer than the table, or the input ending: bit by bit, nothing
    // taken unless the whole code came.
    let is i64 as code with mut = 0;
    let is i64 as first with mut = 0;
    let is i64 as index with mut = 0;
    let is i64 as len with mut = 1;
    while (len < 16) {
        if (len > b.nbits) { return Z_MORE; }
        let is i64 as bit = (b.acc >> (len - 1)) & 1;
        code = code | bit;
        let is i64 as count = h.count[len];
        if (code - count < first) {
            b.acc = b.acc >> len;
            b.nbits = b.nbits - len;
            return h.symbol[index + (code - first)];
        }
        index = index + count;
        first = (first + count) << 1;
        code = code << 1;
        len = len + 1;
    }
    return errno.I_CORRUPT;
}

let is [29]i64 as _LBASE;
let is [29]i64 as _LEXT;
let is [30]i64 as _DBASE;
let is [30]i64 as _DEXT;
let is i32 as _ready with mut = 0;

// The length and distance tables of RFC 1951 3.2.5. Every thread that gets
// here first writes the same numbers.
fn _tables() as void {
    if (_ready == 1) { return; }
    let is i64 as i with mut = 0;
    let is i64 as base with mut = 3;
    while (i < 28) {
        let is i64 as e with mut = 0;
        if (i >= 8) { e = (i - 4) / 4; }
        _LEXT[i] = e;
        _LBASE[i] = base;
        base = base + (1 << e);
        i = i + 1;
    }
    _LBASE[28] = 258;
    _LEXT[28] = 0;
    i = 0;
    base = 1;
    while (i < 30) {
        let is i64 as e with mut = 0;
        if (i >= 4) { e = (i - 2) / 2; }
        _DEXT[i] = e;
        _DBASE[i] = base;
        base = base + (1 << e);
        i = i + 1;
    }
    _ready = 1;
}

fn _push(z as *ZSteps, v as i64) as i64 {
    if (z.out.len >= z.most) { return errno.I_CORRUPT; }
    if (cb.bytes_push(&z.out, cast(u8, v)) < 0) { return errno.I_OOM; }
    return 0;
}

// A Huffman block's symbols to its end (0), or to where the input ends.
fn _codes(z as *ZSteps, b as *_Bits, lit as *_Huff, dist as *_Huff) as i64 {
    while (1 == 1) {
        let is i64 as sym = _decode(b, lit);
        if (sym < 0) { return sym; }
        if (sym < 256) {
            let is i64 as r = _push(z, sym);
            if (r < 0) { return r; }
        } else if (sym == 256) {
            return 0;
        } else {
            let is i64 as li = sym - 257;
            if (li >= 29) { return errno.I_CORRUPT; }
            let is i64 as le = _bits(b, _LEXT[li]);
            if (le < 0) { return le; }
            let is i64 as length = _LBASE[li] + le;
            let is i64 as ds = _decode(b, dist);
            if (ds < 0) { return ds; }
            if (ds >= 30) { return errno.I_CORRUPT; }
            let is i64 as de = _bits(b, _DEXT[ds]);
            if (de < 0) { return de; }
            let is i64 as d = _DBASE[ds] + de;
            if (d > z.out.len) { return errno.I_CORRUPT; }
            if (z.out.len + length > z.most) { return errno.I_CORRUPT; }
            if (cb.bytes_reserve(&z.out, length) < 0) { return errno.I_OOM; }
            let is i64 as k with mut = 0;
            while (k < length) {
                z.out.ptr[z.out.len] = z.out.ptr[z.out.len - d];
                z.out.len = z.out.len + 1;
                k = k + 1;
            }
        }
    }
    return 0;
}

fn _stored(z as *ZSteps, b as *_Bits) as i64 {
    let is i64 as drop = b.nbits & 7;   // to a whole byte
    b.acc = b.acc >> drop;
    b.nbits = b.nbits - drop;
    let is i64 as len = _bits(b, 16);
    if (len < 0) { return len; }
    let is i64 as nlen = _bits(b, 16);
    if (nlen < 0) { return nlen; }
    if ((len ^ 65535) != nlen) { return errno.I_CORRUPT; }
    let is i64 as k with mut = 0;
    while (k < len) {
        let is i64 as v = _bits(b, 8);
        if (v < 0) { return v; }
        let is i64 as r = _push(z, v);
        if (r < 0) { return r; }
        k = k + 1;
    }
    return 0;
}

fn _fixed(z as *ZSteps, b as *_Bits) as i64 {
    let is [288]i64 as l;
    let is i64 as i with mut = 0;
    while (i < 288) {
        let is i64 as v with mut = 8;
        if (i >= 144 && i < 256) { v = 9; }
        if (i >= 256 && i < 280) { v = 7; }
        l[i] = v;
        i = i + 1;
    }
    let is _Huff as lit;
    _build(&lit, cast(*i64, &l), 288);
    i = 0;
    while (i < 30) { l[i] = 5; i = i + 1; }
    let is _Huff as dist;
    _build(&dist, cast(*i64, &l), 30);
    return _codes(z, b, &lit, &dist);
}

let is [19]i64 as _ORDER;

fn _dynamic(z as *ZSteps, b as *_Bits) as i64 {
    let is i64 as nlen = _bits(b, 5);
    if (nlen < 0) { return nlen; }
    let is i64 as ndist = _bits(b, 5);
    if (ndist < 0) { return ndist; }
    let is i64 as ncode = _bits(b, 4);
    if (ncode < 0) { return ncode; }
    let is i64 as nl = nlen + 257;
    let is i64 as nd = ndist + 1;
    if (nl > 286 || nd > 30) { return errno.I_CORRUPT; }
    _ORDER[0] = 16; _ORDER[1] = 17; _ORDER[2] = 18; _ORDER[3] = 0; _ORDER[4] = 8; _ORDER[5] = 7;
    _ORDER[6] = 9; _ORDER[7] = 6; _ORDER[8] = 10; _ORDER[9] = 5; _ORDER[10] = 11; _ORDER[11] = 4;
    _ORDER[12] = 12; _ORDER[13] = 3; _ORDER[14] = 13; _ORDER[15] = 2; _ORDER[16] = 14; _ORDER[17] = 1;
    _ORDER[18] = 15;
    let is [320]i64 as lens;
    let is i64 as i with mut = 0;
    while (i < 19) { lens[i] = 0; i = i + 1; }
    i = 0;
    while (i < ncode + 4) {
        let is i64 as v = _bits(b, 3);
        if (v < 0) { return v; }
        lens[_ORDER[i]] = v;
        i = i + 1;
    }
    let is _Huff as lc;
    if (_build(&lc, cast(*i64, &lens), 19) < 0) { return errno.I_CORRUPT; }
    i = 0;
    while (i < nl + nd) {
        let is i64 as sym = _decode(b, &lc);
        if (sym < 0) { return sym; }
        if (sym < 16) {
            lens[i] = sym;
            i = i + 1;
        } else {
            let is i64 as prev with mut = 0;
            let is i64 as rep with mut = 0;
            if (sym == 16) {
                if (i == 0) { return errno.I_CORRUPT; }
                prev = lens[i - 1];
                rep = _bits(b, 2);
                if (rep < 0) { return rep; }
                rep = rep + 3;
            } else if (sym == 17) {
                rep = _bits(b, 3);
                if (rep < 0) { return rep; }
                rep = rep + 3;
            } else {
                rep = _bits(b, 7);
                if (rep < 0) { return rep; }
                rep = rep + 11;
            }
            if (i + rep > nl + nd) { return errno.I_CORRUPT; }
            while (rep > 0) { lens[i] = prev; i = i + 1; rep = rep - 1; }
        }
    }
    if (lens[256] == 0) { return errno.I_CORRUPT; }
    let is _Huff as lit;
    if (_build(&lit, cast(*i64, &lens), nl) < 0) { return errno.I_CORRUPT; }
    let is _Huff as dist;
    if (_build(&dist, cast(*i64, cast(i64, &lens) + nl * 8), nd) < 0) { return errno.I_CORRUPT; }
    return _codes(z, b, &lit, &dist);
}

// The stream so far, body[0..len): the blocks after the ones finished. 1
// when its last block is done, 0 when it wants more, <0 when it is bad. The
// unfinished block's bytes so far stay in z.out until the next run.
fn zsteps_run(z as *ZSteps, body as *u8, len as i64) as i64 {
    if (z.done == 1) { return 1; }
    _tables();
    z.out.len = z.blk_out;
    let is _Bits as b;
    b.src = body;
    b.len = len;
    b.pos = z.blk_bit / 8;
    b.acc = 0;
    b.nbits = 0;
    if ((z.blk_bit & 7) != 0) {
        if (_bits(&b, z.blk_bit & 7) < 0) { return 0; }
    }
    while (1 == 1) {
        let is i64 as start = _at(&b);
        let is i64 as made = z.out.len;
        let is i64 as last = _bits(&b, 1);
        let is i64 as kind = _bits(&b, 2);
        let is i64 as r with mut = Z_MORE;
        if (last >= 0 && kind >= 0) {
            if (kind == 0) { r = _stored(z, &b); }
            else if (kind == 1) { r = _fixed(z, &b); }
            else if (kind == 2) { r = _dynamic(z, &b); }
            else { r = errno.I_CORRUPT; }
        }
        if (r == Z_MORE) {
            z.blk_bit = start;
            z.blk_out = made;
            return 0;
        }
        if (r < 0) { return r; }
        z.blk_bit = _at(&b);
        z.blk_out = z.out.len;
        if (last == 1) {
            z.done = 1;
            return 1;
        }
    }
    return 0;
}

// A whole zlib stream (RFC 1950) inflated into *out: its header, every block
// and its Adler-32 checked, no more than most bytes made. out.len, or <0:
// I_CORRUPT for a stream that is bad or cut short, I_OOM.
fn zlib_whole(src as *u8, len as i64, out as *cb.Bytes, most as i64) as i64 {
    if (len < 6) { return errno.I_CORRUPT; }
    let is i64 as cmf = cast(i64, src[0]);
    let is i64 as flg = cast(i64, src[1]);
    if ((cmf & 15) != 8 || ((cmf * 256 + flg) % 31) != 0 || (flg & 32) != 0) { return errno.I_CORRUPT; }
    let is ZSteps as z = zsteps(most);
    let is i64 as r = zsteps_run(&z, cast(*u8, cast(i64, src) + 2), len - 2);
    if (r != 1) {
        zsteps_free(&z);
        if (r < 0) { return r; }
        return errno.I_CORRUPT;   // it stops before its last block
    }
    let is i64 as at = 2 + (z.blk_bit + 7) / 8;
    if (at + 4 > len) { zsteps_free(&z); return errno.I_CORRUPT; }
    let is i64 as want = (cast(i64, src[at]) << 24) | (cast(i64, src[at + 1]) << 16) |
                         (cast(i64, src[at + 2]) << 8) | cast(i64, src[at + 3]);
    if (checksum.adler32(z.out.ptr, z.out.len) != want) { zsteps_free(&z); return errno.I_CORRUPT; }
    cb.bytes_free(out);
    *out = z.out;
    return out.len;
}
